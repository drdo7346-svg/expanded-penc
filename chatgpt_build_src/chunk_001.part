def jogress___hist_bn_route_validate(
    self, roster_count: int = jogress__PROJECT_ROSTER_COUNT
) -> None:
    for label, value in (("출발 ID", self.source_id), ("결과 ID", self.result_id)):
        if not 0 <= int(value) < int(roster_count):
            raise ValueError(f"{label} 범위 오류: {value} (0~{int(roster_count) - 1})")
    if not 0 <= int(self.version) < jogress__HIST_BN_PARTNER_VERSION_COUNT:
        raise ValueError(f"상대 기기 버전 범위 오류: {self.version} (0~5)")
    for label, value in (("상대 디지몬 1", self.partner_a), ("상대 디지몬 2", self.partner_b)):
        if not 0 <= int(value) < jogress__HIST_BN_PARTNER_ID_COUNT:
            raise ValueError(f"{label} 프로토콜 ID 범위 오류: {value} (0~35)")


def jogress___hist_bn_route_from_dict(cls, obj: dict[str, Any]) -> "SpecialJogressRoute":
    return cls(
        bool(obj.get("enabled", True)),
        int(obj.get("source_id", 0)),
        int(obj.get("version", obj.get("partner_version", 0))),
        int(obj.get("partner_a", obj.get("partner_id", 0))),
        int(obj.get("partner_b", obj.get("partner_id2", obj.get("partner_a", 0)))),
        int(obj.get("result_id", 0)),
    )


jogress__SpecialJogressRoute.validate = jogress___hist_bn_route_validate
jogress__SpecialJogressRoute.from_dict = classmethod(jogress___hist_bn_route_from_dict)


def jogress___normalise_attribute_rows(rows: Any) -> list[list[int]]:

    result: list[list[int]] = []
    source = rows if isinstance(rows, list) else []
    for sid in range(jogress__PROJECT_ROSTER_COUNT):
        row = source[sid] if sid < len(source) and isinstance(source[sid], list) else []
        values: list[int] = []
        for index in range(4):
            value = row[index] if index < len(row) else -1
            if value is None:
                value = -1
            value = int(value)
            if value in (-1, -2):
                values.append(value)
            elif 0 <= value < jogress__PROJECT_ROSTER_COUNT:
                values.append(value)
            else:
                values.append(-1)
        result.append(values)
    return result


def jogress___hist_bn_normalise_special_slots(routes: Any) -> list[jogress__SpecialJogressRoute]:
    src = list(routes) if isinstance(routes, (list, tuple)) else []
    out: list[jogress__SpecialJogressRoute] = []
    for item in src[:jogress__HIST_BN_SPECIAL_SLOT_COUNT]:
        if isinstance(item, jogress__SpecialJogressRoute):
            out.append(copy.deepcopy(item))
        elif isinstance(item, dict):
            out.append(jogress__SpecialJogressRoute.from_dict(item))
    while len(out) < jogress__HIST_BN_SPECIAL_SLOT_COUNT:
        out.append(jogress__SpecialJogressRoute(False, 0, 0, 0, 0, 0))
    return out


jogress___hist_bn_old_read_special_routes = jogress___read_special_routes


def jogress___read_special_routes(
    data: bytes, layout: RomLayout
) -> list[jogress__SpecialJogressRoute]:
    return jogress___hist_bn_normalise_special_slots(
        jogress___hist_bn_old_read_special_routes(data, layout)
    )


jogress___hist_bn_old_create_project_from_rom = jogress__create_project_from_rom


def jogress__create_project_from_rom(path: Path):
    project, data, images, layout = jogress___hist_bn_old_create_project_from_rom(path)
    setattr(
        project,
        "attribute_jogress_rows",
        jogress___normalise_attribute_rows(getattr(project, "attribute_jogress_rows", [])),
    )
    setattr(
        project,
        "special_jogress_routes",
        jogress___hist_bn_normalise_special_slots(getattr(project, "special_jogress_routes", [])),
    )
    return (project, data, images, layout)


jogress___hist_bn_old_load_project = jogress__load_project


def jogress__load_project(path: Path):
    project, data, images, layout = jogress___hist_bn_old_load_project(path)
    setattr(
        project,
        "attribute_jogress_rows",
        jogress___normalise_attribute_rows(getattr(project, "attribute_jogress_rows", [])),
    )
    setattr(
        project,
        "special_jogress_routes",
        jogress___hist_bn_normalise_special_slots(getattr(project, "special_jogress_routes", [])),
    )
    return (project, data, images, layout)


jogress___hist_bn_old_project_to_dict = jogress__project_to_dict


def jogress__project_to_dict(project: core.Project, profile_version: int) -> dict[str, Any]:
    obj = jogress___hist_bn_old_project_to_dict(project, profile_version)
    obj["format"] = jogress__PROJECT_FORMAT
    obj["app_version"] = jogress__APP_VERSION
    obj["attribute_jogress_rows"] = jogress___normalise_attribute_rows(
        getattr(project, "attribute_jogress_rows", [])
    )
    obj["special_jogress_routes"] = [
        r.to_dict()
        for r in jogress___hist_bn_normalise_special_slots(
            getattr(project, "special_jogress_routes", [])
        )
    ]
    obj["jogress_semantics"] = {
        "special_slots": jogress__HIST_BN_SPECIAL_SLOT_COUNT,
        "partner_version_domain": "0..5 => Pendulum v1,v2,v3,v4,v5,v0",
        "partner_id_domain": "protocol ID 0..35; not local roster ID",
    }
    return obj


def jogress___build_special_jogress_code(
    profile: Any, routes: list[SpecialJogressRoute], target: int
) -> tuple[bytes, dict[str, Any]]:
    slots = jogress___hist_bn_normalise_special_slots(routes)
    included: list[tuple[int, jogress__SpecialJogressRoute]] = []
    omitted: list[dict[str, Any]] = []
    for index, route in enumerate(slots):
        if not route.enabled:
            continue
        route.validate(jogress__PROJECT_ROSTER_COUNT)
        if route.source_id >= target or route.result_id >= target:
            omitted.append(
                {
                    "slot": index,
                    **route.to_dict(),
                    "reason": f"현재 저장 모드 로컬 ID 상한 {target - 1} 초과",
                }
            )
            continue
        included.append((index, route))
    words: list[int] = [55944, 8256 | int(profile.special_jogress_stack), 2824, 1]
    slot_offsets: list[dict[str, Any]] = []
    for slot_index, route in included:
        route_start = len(words)
        branch_fixups: list[tuple[int, int]] = []
        words += jogress___load_ram_words(2086)
        jogress___hist_bn_emit_cmp_r4(words, route.source_id)
        branch_fixups.append((len(words), 78))
        words.append(0)
        words += jogress___load_ram_words(3357)
        words.append(18496 | int(route.version))
        branch_fixups.append((len(words), 78))
        words.append(0)
        words += jogress___load_ram_words(3358)
        words.append(18496 | int(route.partner_a))
        partner_a_branch = len(words)
        words.append(0)
        words += jogress___load_ram_words(3358)
        words.append(18496 | int(route.partner_b))
        branch_fixups.append((len(words), 78))
        words.append(0)
        result_index = len(words)
        jogress___hist_bn_emit_mov_r4(words, route.result_id)
        words += [64 | int(profile.special_jogress_stack), 39064]
        next_index = len(words)
        words[partner_a_branch] = jogress___branch_word(94, result_index - (partner_a_branch + 1))
        for branch_index, high in branch_fixups:
            words[branch_index] = jogress___branch_word(high, next_index - (branch_index + 1))
        slot_offsets.append(
            {
                "slot": slot_index,
                "word_start": route_start,
                "word_end": next_index,
                **route.to_dict(),
            }
        )
    words += list(core__far_goto_words(profile.special_jogress_fallback))
    blob = struct.pack("<" + "H" * len(words), *words)
    if len(blob) > jogress__HIST_BN_SPECIAL_END - jogress__HIST_BN_SPECIAL_CODE:
        raise ValueError(
            f"스페셜 조그레스 원본 코드 영역이 부족합니다: {len(blob)}/{jogress__HIST_BN_SPECIAL_END - jogress__HIST_BN_SPECIAL_CODE} bytes"
        )
    return (
        blob,
        {
            "configured_slots": jogress__HIST_BN_SPECIAL_SLOT_COUNT,
            "enabled_in_output": len(included),
            "omitted": omitted,
            "bytes_used": len(blob),
            "code_offset": jogress__HIST_BN_SPECIAL_CODE,
            "fallback": int(profile.special_jogress_fallback),
            "slot_offsets": slot_offsets,
            "partner_version_ram": "0x0\x441D",
            "partner_id_ram": "0x0\x441E",
            "source_id_ram": "0x0826",
            "partner_id_domain": "0..35 protocol partner index",
        },
    )


def jogress___hist_bn_emit_cmp_r4(words: list[int], value: int) -> None:
    value = int(value)
    if 0 <= value <= 63:
        words.append(18496 | value)
    else:
        words += [relocation__cmp16_word(4), value & 65535]

def jogress___hist_bn_emit_mov_r4(words: list[int], value: int) -> None:
    value = int(value)
    if 0 <= value <= 63:
        words.append(37440 | value)
    else:
        words += [relocation__mov16_word(4), value & 65535]


def jogress___hist_bn_write_special_table(
    out: bytearray, routes: list[SpecialJogressRoute]
) -> dict[str, Any]:
    slots = jogress___hist_bn_normalise_special_slots(routes)
    out[jogress__HIST_BN_SPECIAL_DATA:jogress__HIST_BN_SPECIAL_DATA_END] = b"\x00" * (
        jogress__HIST_BN_SPECIAL_DATA_END - jogress__HIST_BN_SPECIAL_DATA
    )
    out[jogress__HIST_BN_SPECIAL_DATA : jogress__HIST_BN_SPECIAL_DATA + 4] = (
        jogress__HIST_BN_SPECIAL_MAGIC
    )
    core__write_u32(out, jogress__HIST_BN_SPECIAL_DATA + 4, jogress__HIST_BN_SPECIAL_SLOT_COUNT)
    rows = jogress__HIST_BN_SPECIAL_DATA + 8
    for index, route in enumerate(slots):
        values = (
            int(bool(route.enabled)),
            int(route.source_id),
            int(route.version),
            int(route.partner_a),
            int(route.partner_b),
            int(route.result_id),
        )
        if max(values[1:]) > 255:
            row = bytes((0, 0, 0, 0, 0, 0))
        else:
            row = bytes((v & 255 for v in values))
        off = rows + index * 6
        out[off : off + 6] = row
    return {
        "magic": jogress__HIST_BN_SPECIAL_MAGIC.decode("ascii"),
        "offset": jogress__HIST_BN_SPECIAL_DATA,
        "record_offset": rows,
        "record_size": 6,
        "slot_count": jogress__HIST_BN_SPECIAL_SLOT_COUNT,
    }


def jogress___patch_attribute_jogress(
    out: bytearray, project: core.Project, target: int, table: dict[str, int]
) -> dict[str, Any]:

    rows = jogress___normalise_attribute_rows(getattr(project, "attribute_jogress_rows", []))
    (
        core__write_u16(out, int(getattr(project, "_\x76201_jogress_pointer_load_site", 0)) or 0, 0)
        if False
        else None
    )
    active = 0
    mismatch = 0
    clipped = 0
    for source_id in range(int(target)):
        row_off = int(table["jog_rows"]) + source_id * 8
        core__write_u32(out, int(table["jog_ptr"]) + source_id * 4, 2097152 + row_off // 2)
        for attr in range(4):
            value = int(rows[source_id][attr])
            if value < 0:
                encoded = int(target)
                mismatch += 1
            elif value >= int(target):
                encoded = int(target)
                clipped += 1
            else:
                encoded = value
                active += 1
            core__write_u16(out, row_off + attr * 2, encoded)
    return {
        "active_results": active,
        "mismatch_or_none": mismatch,
        "clipped_for_mode": clipped,
        "sentinel": int(target),
        "source_rows": int(target),
        "semantics": "original 4-word Free/Virus/Data/Vaccine result row; universal extended allocation",
        "ui_none": -1,
        "ui_mismatch": -2,
    }


def jogress___validate_project_jogress(project: core.Project) -> None:
    rows = jogress___normalise_attribute_rows(getattr(project, "attribute_jogress_rows", []))
    setattr(project, "attribute_jogress_rows", rows)
    routes = jogress___hist_bn_normalise_special_slots(
        getattr(project, "special_jogress_routes", [])
    )
    if len(routes) != jogress__HIST_BN_SPECIAL_SLOT_COUNT:
        raise ValueError(
            f"스페셜 조그레스 설정은 정확히 {jogress__HIST_BN_SPECIAL_SLOT_COUNT}개 슬롯이어야 합니다"
        )
    for index, route in enumerate(routes):
        if route.enabled:
            try:
                route.validate(jogress__PROJECT_ROSTER_COUNT)
            except Exception as exc:
                raise ValueError(f"스페셜 조그레스 슬롯 {index + 1}: {exc}") from exc
    setattr(project, "special_jogress_routes", routes)


def jogress__save_project(project: core.Project, profile_version: int, path: Path) -> None:
    obj = jogress__project_to_dict(project, profile_version)
    base = Path(obj["base_rom"])
    if base.is_absolute():
        try:
            obj["base_rom"] = os.path.relpath(base, path.parent).replace("\\", "/")
        except ValueError:
            pass
    path.write_text(json.dumps(obj, ensure_ascii=False, indent=2), encoding="utf-8")
    project.project_path = path


jogress__hist_bn_validate_project_jogress = jogress___validate_project_jogress
jogress__hist_bn_patch_attribute_jogress = jogress___patch_attribute_jogress
jogress__hist_bn_build_special_jogress_code = jogress___build_special_jogress_code
jogress__hist_bn_write_special_table = jogress___hist_bn_write_special_table
jogress__hist_bn_normalise_special_slots = jogress___hist_bn_normalise_special_slots
jogress___validate_project_jogress = jogress___HIST_BN_ORIGINAL_VALIDATE_JOGRESS
jogress___patch_attribute_jogress = jogress___HIST_BN_ORIGINAL_PATCH_ATTRIBUTE
jogress___build_special_jogress_code = jogress___HIST_BN_ORIGINAL_BUILD_SPECIAL
jogress__build_rom = jogress___HIST_BN_ORIGINAL_BUILD_ROM
jogress__MAX_SPECIAL_JOGRESS_ROUTES = jogress___HIST_BN_ORIGINAL_MAX_SPECIAL
globals()["universal__APP_VERSION"] = jogress__APP_VERSION
globals()["universal__PROJECT_FORMAT"] = jogress__PROJECT_FORMAT
globals()["universal__create_project_from_rom"] = jogress__create_project_from_rom
globals()["universal__save_universal_project"] = jogress__save_project
globals()["universal__load_universal_project"] = jogress__load_project
globals()["universal__build_universal_rom"] = jogress__build_rom
jogress___HIST_BN_OLD_GUI = jogress__GUI


class jogress__GUI(jogress___HIST_BN_OLD_GUI):

    @staticmethod
    def _hist_bn_protocol_index_for_device_version(device_version: int) -> int:
        v = int(device_version)
        return 5 if v == 0 else max(0, min(4, v - 1))

    def _hist_bn_local_choices(
        self, include_none: bool = False, include_mismatch: bool = False
    ) -> list[str]:
        values: list[str] = []
        english = getattr(self, "ui_language", "ko") == "en"
        if include_none:
            values.append("[None]" if english else "[없음]")
        if include_mismatch:
            values.append("[Mismatch]" if english else "[미스 매치]")
        if self.project is not None:
            values += [f"{slot.digimon_id:03d}  {slot.name}" for slot in self.project.slots]
        return values

    @staticmethod
    def _hist_bn_parse_result(text: str) -> int:
        text = (text or "").strip()
        if text.startswith(("[없음]", "[None]")) or not text:
            return -1
        if text.startswith(("[미스 매치]", "[Mismatch]")):
            return -2
        return int(text.split()[0])

    def _hist_bn_partner_name(self, version: int, partner_id: int) -> str:
        version = max(0, min(5, int(version)))
        partner_id = max(0, min(35, int(partner_id)))
        try:
            device_version = int(self.profile.version)
        except Exception:
            device_version = -1
        if (
            self.project is not None
            and version == self._hist_bn_protocol_index_for_device_version(device_version)
            and (partner_id < len(self.project.slots))
        ):
            name = self.project.slots[partner_id].name
        else:
            names = jogress__HIST_BN_PROTOCOL_NAMES[version]
            name = names[partner_id] if partner_id < len(names) else "추가 디지몬"
        return name

    def _hist_bn_partner_choices(self, version: int) -> list[str]:
        return [f"{i:02d}  {self._hist_bn_partner_name(version, i)}" for i in range(36)]

    @staticmethod
    def _hist_bn_partner_id(text: str) -> int:
        return int((text or "0").split()[0])

    def _build_jogress_tab(self) -> None:
        tk, ttk = (self.tk, self.ttk)
        self.jogress_tab = ttk.Frame(self.notebook)
        tabs = list(self.notebook.tabs())
        evo_index = (
            tabs.index(str(self.evolution_tab))
            if str(self.evolution_tab) in tabs
            else len(tabs) - 1
        )
        if evo_index == len(tabs) - 1:
            self.notebook.add(self.jogress_tab, text="조그레스")
        else:
            self.notebook.insert(evo_index + 1, self.jogress_tab, text="조그레스")
        attr_box = ttk.LabelFrame(
            polish__tab_content(self, self.jogress_tab), text="상대 속성별 일반 조그레스"
        )
        attr_box.pack(fill=tk.X, padx=10, pady=10)
        ttk.Label(
            attr_box,
            text="원본 전체 조그레스 편집 방식입니다. 메인 편집기의 현재 ID와 별개로 ‘출발 디지몬’을 고른 뒤 Free/Virus/Data/Vaccine 상대일 때의 결과를 지정합니다. [없음]은 미설정, [미스 매치]는 조그레스 불가입니다.",
            wraplength=900,
        ).grid(row=0, column=0, columnspan=6, padx=8, pady=(6, 10), sticky="w")
        ttk.Label(attr_box, text="출발 디지몬").grid(row=1, column=0, padx=8, pady=6, sticky="e")
        self.attribute_source_var = tk.StringVar()
        self.attribute_source_combo = ttk.Combobox(
            attr_box, textvariable=self.attribute_source_var, state="readonly", width=38
        )
        self.attribute_source_combo.grid(row=1, column=1, columnspan=3, padx=8, pady=6, sticky="w")
        self.attribute_source_combo.bind(
            "<<ComboboxSelected>>", lambda _e: self._hist_bn_load_attribute_source()
        )
        self.attribute_vars = []
        self.attribute_combos = []
        for index, name in enumerate(jogress__ATTRIBUTE_NAMES):
            r = 2 + index // 2
            c = index % 2 * 3
            ttk.Label(attr_box, text=f"{name} 상대").grid(
                row=r, column=c, padx=8, pady=6, sticky="e"
            )
            var = tk.StringVar()
            combo = ttk.Combobox(attr_box, textvariable=var, state="readonly", width=34)
            combo.grid(row=r, column=c + 1, padx=8, pady=6, sticky="w")
            combo.bind("<<ComboboxSelected>>", lambda _e, i=index: self._attribute_changed(i))
            self.attribute_vars.append(var)
            self.attribute_combos.append(combo)
        special_box = ttk.LabelFrame(
            polish__tab_content(self, self.jogress_tab),
            text=f"스페셜 조그레스 · 고정 {jogress__HIST_BN_SPECIAL_SLOT_COUNT}개 슬롯",
        )
        special_box.pack(fill=tk.BOTH, expand=True, padx=10, pady=(0, 10))
        ttk.Label(
            special_box,
            text="원본 ABI: 상대 기기 버전은 Pendulum v1~v5,v0의 6종이고, 상대 디지몬 1/2는 현재 로스터 ID가 아니라 선택한 버전의 통신 프로토콜 ID 000~063입니다. 출발/결과 디지몬만 현재 로스터 ID를 사용합니다.",
            wraplength=900,
        ).pack(anchor="w", padx=8, pady=6)
        self.special_tree = ttk.Treeview(
            special_box,
            columns=("slot", "on", "source", "version", "pa", "pb", "result"),
            show="headings",
            height=12,
        )
        for col, title, width in (
            ("slot", "슬롯", 50),
            ("on", "사용", 50),
            ("source", "출발 디지몬", 145),
            ("version", "상대 버전", 100),
            ("pa", "상대 디지몬 1", 170),
            ("pb", "상대 디지몬 2", 170),
            ("result", "결과 디지몬", 145),
        ):
            self.special_tree.heading(col, text=title)
            self.special_tree.column(col, width=width, anchor="center")
        self.special_tree.pack(fill=tk.BOTH, expand=True, padx=8, pady=6)
        self.special_tree.bind("<Double-1>", lambda _e: self.edit_special_jogress())
        buttons = ttk.Frame(special_box)
        buttons.pack(fill=tk.X, padx=8, pady=(0, 8))
        ttk.Button(buttons, text="슬롯 수정", command=self.edit_special_jogress).pack(
            side=tk.LEFT, padx=3
        )
        ttk.Button(buttons, text="빈 슬롯 설정", command=self.add_special_jogress).pack(
            side=tk.LEFT, padx=3
        )
        ttk.Button(buttons, text="슬롯 비우기", command=self.delete_special_jogress).pack(
            side=tk.LEFT, padx=3
        )
        self._hist_bn_attribute_source_id = 0
        self.refresh_jogress_tab()

    def _attribute_changed(self, index: int) -> None:
        if self.project is None:
            return
        sid = self._hist_bn_source_id()
        rows = jogress___normalise_attribute_rows(
            getattr(self.project, "attribute_jogress_rows", [])
        )
        rows[sid][index] = self._hist_bn_parse_result(self.attribute_vars[index].get())
        setattr(self.project, "attribute_jogress_rows", rows)
        self.dirty = True
        self.update_status(
            f"조그레스 출발 ID {sid:03d} / {jogress__ATTRIBUTE_NAMES[index]} 상대 결과 변경"
        )

    def _hist_bn_load_attribute_source(self) -> None:
        if self.project is None:
            return
        sid = self._hist_bn_source_id()
        if not 0 <= sid < len(self.project.slots):
            return
        self._hist_bn_attribute_source_id = sid
        rows = jogress___normalise_attribute_rows(
            getattr(self.project, "attribute_jogress_rows", [])
        )
        setattr(self.project, "attribute_jogress_rows", rows)
        result_choices = self._hist_bn_local_choices(include_none=True, include_mismatch=True)
        for i, combo in enumerate(self.attribute_combos):
            combo["values"] = result_choices
            value = int(rows[sid][i])
            if value == -1:
                combo.current(0)
            elif value == -2:
                combo.current(1)
            elif 0 <= value < len(self.project.slots):
                combo.current(value + 2)
            else:
                combo.current(0)

    def _hist_bn_source_id(self) -> int:
        text = (
            getattr(self, "attribute_source_var", None).get()
            if hasattr(self, "attribute_source_var")
            else ""
        )
        try:
            return int(text.split()[0])
        except Exception:
            return int(getattr(self, "_hist_bn_attribute_source_id", 0))

    def _special_dialog(
        self, existing: Optional[SpecialJogressRoute] = None
    ) -> Optional[jogress__SpecialJogressRoute]:
        tk, ttk = (self.tk, self.ttk)
        from tkinter import messagebox

        route = (
            copy.deepcopy(existing)
            if existing
            else jogress__SpecialJogressRoute(
                False, max(0, getattr(self, "current_id", 0)), 0, 0, 0, 0
            )
        )
        dialog = tk.Toplevel(self.root)
        dialog.title("스페셜 조그레스 슬롯")
        dialog.transient(self.root)
        dialog.grab_set()
        dialog.resizable(False, False)
        local = self._hist_bn_local_choices()
        enabled_var = tk.BooleanVar(value=route.enabled)
        source_var = tk.StringVar(
            value=local[route.source_id] if 0 <= route.source_id < len(local) else local[0]
        )
        result_var = tk.StringVar(
            value=local[route.result_id] if 0 <= route.result_id < len(local) else local[0]
        )
        version_var = tk.StringVar(
            value=(
                jogress__HIST_BN_PROTOCOL_VERSION_LABELS[route.version]
                if 0 <= route.version < 6
                else jogress__HIST_BN_PROTOCOL_VERSION_LABELS[0]
            )
        )
        pa_var = tk.StringVar()
        pb_var = tk.StringVar()
        result = [None]
        ttk.Checkbutton(dialog, text="이 스페셜 조그레스 사용", variable=enabled_var).grid(
            row=0, column=0, columnspan=2, padx=10, pady=8, sticky="w"
        )
        ttk.Label(dialog, text="출발 디지몬").grid(row=1, column=0, padx=8, pady=6, sticky="e")
        ttk.Combobox(
            dialog, textvariable=source_var, values=local, state="readonly", width=40
        ).grid(row=1, column=1, padx=8, pady=6, sticky="w")
        ttk.Label(dialog, text="상대 기기 버전").grid(row=2, column=0, padx=8, pady=6, sticky="e")
        version_combo = ttk.Combobox(
            dialog,
            textvariable=version_var,
            values=jogress__HIST_BN_PROTOCOL_VERSION_LABELS,
            state="readonly",
            width=24,
        )
        version_combo.grid(row=2, column=1, padx=8, pady=6, sticky="w")
        ttk.Label(dialog, text="상대 디지몬 1").grid(row=3, column=0, padx=8, pady=6, sticky="e")
        pa_combo = ttk.Combobox(dialog, textvariable=pa_var, state="readonly", width=40)
        pa_combo.grid(row=3, column=1, padx=8, pady=6, sticky="w")
        ttk.Label(dialog, text="상대 디지몬 2").grid(row=4, column=0, padx=8, pady=6, sticky="e")
        pb_combo = ttk.Combobox(dialog, textvariable=pb_var, state="readonly", width=40)
        pb_combo.grid(row=4, column=1, padx=8, pady=6, sticky="w")
        ttk.Label(dialog, text="결과 디지몬").grid(row=5, column=0, padx=8, pady=6, sticky="e")
        ttk.Combobox(
            dialog, textvariable=result_var, values=local, state="readonly", width=40
        ).grid(row=5, column=1, padx=8, pady=6, sticky="w")
        ttk.Label(
            dialog,
            text="※ 상대 ID는 로컬 도감 ID가 아니라 선택 버전의 통신 ID 000~063입니다.",
            wraplength=420,
        ).grid(row=6, column=0, columnspan=2, padx=8, pady=(6, 2), sticky="w")

        def version_changed(_e=None):
            try:
                v = jogress__HIST_BN_PROTOCOL_VERSION_LABELS.index(version_var.get())
            except ValueError:
                v = 0
            choices = self._hist_bn_partner_choices(v)
            pa_combo["values"] = choices
            pb_combo["values"] = choices
            pa = max(0, min(35, int(route.partner_a)))
            pb = max(0, min(35, int(route.partner_b)))
            try:
                pa = self._hist_bn_partner_id(pa_var.get())
            except Exception:
                pass
            try:
                pb = self._hist_bn_partner_id(pb_var.get())
            except Exception:
                pass
            pa_var.set(choices[pa])
            pb_var.set(choices[pb])

        version_combo.bind("<<ComboboxSelected>>", version_changed)
        version_changed()

        def accept():
            try:
                v = jogress__HIST_BN_PROTOCOL_VERSION_LABELS.index(version_var.get())
                nr = jogress__SpecialJogressRoute(
                    enabled_var.get(),
                    self._choice_id(source_var.get()),
                    v,
                    self._hist_bn_partner_id(pa_var.get()),
                    self._hist_bn_partner_id(pb_var.get()),
                    self._choice_id(result_var.get()),
                )
                if nr.enabled:
                    nr.validate(jogress__PROJECT_ROSTER_COUNT)
                result[0] = nr
                dialog.destroy()
            except Exception as exc:
                messagebox.showerror("스페셜 조그레스 오류", str(exc), parent=dialog)

        btn = ttk.Frame(dialog)
        btn.grid(row=7, column=0, columnspan=2, pady=10)
        ttk.Button(btn, text="확인", command=accept).pack(side=tk.LEFT, padx=5)
        ttk.Button(btn, text="취소", command=dialog.destroy).pack(side=tk.LEFT, padx=5)
        dialog.wait_window()
        return result[0]

    def add_special_jogress(self) -> None:
        if self.project is None:
            return
        routes = jogress___hist_bn_normalise_special_slots(
            getattr(self.project, "special_jogress_routes", [])
        )
        try:
            index = next((i for i, r in enumerate(routes) if not r.enabled))
        except StopIteration:
            from tkinter import messagebox

            messagebox.showwarning(
                "슬롯 없음",
                f"스페셜 조그레스 {jogress__HIST_BN_SPECIAL_SLOT_COUNT}개 슬롯이 모두 사용 중입니다.",
                parent=self.root,
            )
            return
        replacement = self._special_dialog(routes[index])
        if replacement is not None:
            routes[index] = replacement
            setattr(self.project, "special_jogress_routes", routes)
            self.dirty = True
            self.refresh_jogress_tab()
            self.special_tree.selection_set(str(index))

    def delete_special_jogress(self) -> None:
        if self.project is None:
            return
        selected = self.special_tree.selection()
        if not selected:
            return
        index = int(selected[0])
        routes = jogress___hist_bn_normalise_special_slots(
            getattr(self.project, "special_jogress_routes", [])
        )
        routes[index] = jogress__SpecialJogressRoute(False, 0, 0, 0, 0, 0)
        setattr(self.project, "special_jogress_routes", routes)
        self.dirty = True
        self.refresh_jogress_tab()
        self.special_tree.selection_set(str(index))

    def edit_special_jogress(self) -> None:
        if self.project is None:
            return
        selected = self.special_tree.selection()
        if not selected:
            return
        index = int(selected[0])
        routes = jogress___hist_bn_normalise_special_slots(
            getattr(self.project, "special_jogress_routes", [])
        )
        replacement = self._special_dialog(routes[index])
        if replacement is not None:
            routes[index] = replacement
            setattr(self.project, "special_jogress_routes", routes)
            self.dirty = True
            self.refresh_jogress_tab()
            self.special_tree.selection_set(str(index))

    def move_special_jogress(self, direction: int) -> None:
        return

    def refresh_jogress_tab(self) -> None:
        if self.jogress_tab is None or self.project is None:
            return
        rows = jogress___normalise_attribute_rows(
            getattr(self.project, "attribute_jogress_rows", [])
        )
        setattr(self.project, "attribute_jogress_rows", rows)
        source_choices = self._hist_bn_local_choices()
        old_sid = int(
            getattr(
                self,
                "_hist_bn_attribute_source_id",
                min(getattr(self, "current_id", 0), len(self.project.slots) - 1),
            )
        )
        old_sid = max(0, min(old_sid, len(self.project.slots) - 1))
        self.attribute_source_combo["values"] = source_choices
        self.attribute_source_combo.current(old_sid)
        self._hist_bn_attribute_source_id = old_sid
        self._hist_bn_load_attribute_source()
        slots = jogress___hist_bn_normalise_special_slots(
            getattr(self.project, "special_jogress_routes", [])
        )
        setattr(self.project, "special_jogress_routes", slots)
        for item in self.special_tree.get_children():
            self.special_tree.delete(item)
        for index, route in enumerate(slots):
            srcname = (
                self.project.slots[route.source_id].name
                if 0 <= route.source_id < len(self.project.slots)
                else "INVALID"
            )
            resname = (
                self.project.slots[route.result_id].name
                if 0 <= route.result_id < len(self.project.slots)
                else "INVALID"
            )
            ver = route.version if 0 <= route.version < 6 else 0
            self.special_tree.insert(
                "",
                "end",
                iid=str(index),
                values=(
                    f"{index + 1:02d}",
                    "YES" if route.enabled else "NO",
                    f"{route.source_id:03d} {srcname}",
                    (
                        jogress__HIST_BN_PROTOCOL_VERSION_LABELS[ver]
                        if 0 <= route.version < 6
                        else f"INVALID {route.version}"
                    ),
                    (
                        f"{route.partner_a:02d} {self._hist_bn_partner_name(ver, max(0, min(35, route.partner_a)))}"
                        if 0 <= route.partner_a < 36
                        else f"INVALID {route.partner_a}"
                    ),
                    (
                        f"{route.partner_b:02d} {self._hist_bn_partner_name(ver, max(0, min(35, route.partner_b)))}"
                        if 0 <= route.partner_b < 36
                        else f"INVALID {route.partner_b}"
                    ),
                    f"{route.result_id:03d} {resname}",
                ),
            )


globals()["universal__GUI"] = jogress__GUI


import argparse
import json
import os
import struct
import traceback
from pathlib import Path
from typing import Any, Optional

ui__APP_VERSION = "16.0.0"
ui__PROJECT_FORMAT = "PenCUniversalProject\x5616"
ui__PROJECT_ROSTER_COUNT = jogress__PROJECT_ROSTER_COUNT
ui__STANDARD_ROSTER_COUNT = jogress__STANDARD_ROSTER_COUNT
ui__EXTENDED_ROSTER_COUNT = jogress__EXTENDED_ROSTER_COUNT
ui__STOCK_ROM_SIZE = jogress__STOCK_ROM_SIZE
ui__EXTENDED_ROM_SIZE = jogress__EXTENDED_ROM_SIZE
ui__METADATA_OFFSET = jogress__METADATA_OFFSET
ui__METADATA_SIZE = jogress__METADATA_SIZE
ui__METADATA_MAGIC = jogress__METADATA_MAGIC
ui__PROFILES = jogress__PROFILES
ui__RomLayout = jogress__RomLayout
ui__DIGIT_ZERO_IMAGE = 147
ui__DIGIT_ONE_IMAGE = 148
ui__QUOTIENT_10_IMAGE = 157
ui__QUOTIENT_11_IMAGE = 158


def ui__read_meta(data: bytes) -> Optional[dict[str, Any]]:
    return evolution_merge__read_meta(data)


def ui___fit_half_digit(image: Any, max_width: int = 5, max_height: int = 22) -> Any:
    from PIL import Image

    alpha = image.getchannel("A")
    bbox = alpha.getbbox()
    if bbox is None:
        return Image.new("RGBA", (1, 1), (0, 0, 0, 0))
    cropped = image.crop(bbox)
    scale = min(max_width / cropped.width, max_height / cropped.height)
    width = max(1, round(cropped.width * scale))
    height = max(1, round(cropped.height * scale))
    return cropped.resize((width, height), Image.Resampling.NEAREST)


def ui___make_two_digit_glyph(first: Any, second: Any) -> Any:
    from PIL import Image

    canvas = Image.new("RGBA", (12, 24), (0, 0, 0, 0))
    for column, source in enumerate((first, second)):
        digit = ui___fit_half_digit(source)
        cell_x = column * 6
        x = cell_x + max(0, (5 - digit.width) // 2)
        y = max(0, (24 - digit.height) // 2)
        canvas.alpha_composite(digit, (x, y))
    return canvas


def ui___normalise_fresh_rom_names(project: core.Project, profile_version: int) -> None:
    for slot in project.slots:
        slot.name = ui__standard_display_name(profile_version, slot.digimon_id)


def ui___read_rom_image(data: bytes, image_id: int, size_table: int) -> core__RomImage:
    if image_id < 0:
        raise ValueError(f"잘못된 이미지 ID: {image_id}")
    width = core__read_u16(data, size_table + image_id * 4)
    height = core__read_u16(data, size_table + image_id * 4 + 2)
    start = core__BANK1 + core__read_u32(data, core__BANK1 + image_id * 4)
    end = start + width * height * 2
    if not 0 <= start < end <= len(data):
        raise ValueError(f"이미지 {image_id:#x} 범위 오류: {start:#x}..{end:#x}")
    return core__RomImage(width, height, bytes(data[start:end]))


def ui___rewrite_meta_hist_az(out: bytearray, updates: dict[str, Any]) -> dict[str, Any]:
    meta = ui__read_meta(out) or {}
    meta.update(updates)
    meta["format"] = ui__PROJECT_FORMAT
    meta["app_version"] = ui__APP_VERSION
    encoded = json.dumps(meta, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
    if len(encoded) + 12 > ui__METADATA_SIZE:
        raise ValueError("\x5616 메타데이터 공간 초과")
    out[ui__METADATA_OFFSET : ui__METADATA_OFFSET + ui__METADATA_SIZE] = b"\x00" * ui__METADATA_SIZE
    out[ui__METADATA_OFFSET : ui__METADATA_OFFSET + 8] = ui__METADATA_MAGIC
    core__write_u32(out, ui__METADATA_OFFSET + 8, len(encoded))
    out[ui__METADATA_OFFSET + 12 : ui__METADATA_OFFSET + 12 + len(encoded)] = encoded
    return meta


def ui___rgba_to_rgb565_any(image: Any) -> bytes:
    rgba = image.convert("RGBA")
    out = bytearray(rgba.width * rgba.height * 2)
    pos = 0
    raw = rgba.tobytes()
    for offset in range(0, len(raw), 4):
        r, g, b, a = raw[offset : offset + 4]
        if a == 0:
            word = 2016
        else:
            hist_o = (r * 31 + 127) // 255
            g6 = (g * 63 + 127) // 255
            b5 = (b * 31 + 127) // 255
            if hist_o == 0 and g6 == 63 and (b5 == 0):
                g6 = 62
            word = hist_o << 11 | g6 << 5 | b5
        struct.pack_into("<H", out, pos, word)
        pos += 2
    return bytes(out)


def ui__build_rom(
    project: core.Project, source: bytes, layout: RomLayout, target: int, extended: bool
):
    base, report = jogress__build_rom(project, source, layout, target, extended)
    out = bytearray(base)
    table = dict(report["tables"])
    glyph_report = ui__patch_album_decimal_glyphs(out, table["size"])
    album_number = {
        "digits_visible": 3,
        "stock_code_digits": 2,
        "policy": glyph_report["policy"],
        "100_109": "10 composite + ones digit",
        "110_119": "11 composite + ones digit",
        "entry_code_modified": False,
    }
    ui___rewrite_meta_hist_az(
        out,
        {
            "mode": (
                "extended16-\x7616-stable-glyph" if extended else "standard8-\x7616-stable-glyph"
            ),
            "album_number": album_number,
            "album_number_patch_disabled": True,
            "album_decimal_glyphs": glyph_report,
            "display_name_policy": "VP{version} ID {id:03d} on fresh ROM load",
            "roster_classification_policy": "existing/8MB/16MB remains stable after selection",
        },
    )
    final_report = dict(report)
    final_report["format"] = "PenC Universal Editor \x5616 build report"
    final_report["app_version"] = ui__APP_VERSION
    final_report["album_number"] = album_number
    final_report["album_decimal_glyphs"] = glyph_report
    final_report["display_name_policy"] = "VP{version} ID {id:03d}"
    final_report["hardware_test_priority"] = [
        "album menu enters without reset (\x5613 code path remains unchanged)",
        "099 -> 100 -> 101 shows decimal composite digits rather than F0/F1",
        "110 -> 114 shows decimal composite digits rather than o0/o4",
        "sleep/wake remains functional",
    ]
    final_report["output_sha256"] = core__sha256(out)
    return (bytes(out), final_report)


def ui__create_project_from_rom(path: Path):
    project, data, images, layout = jogress__create_project_from_rom(path)
    ui___normalise_fresh_rom_names(project, layout.profile.version)
    return (project, data, images, layout)


def ui__identify_layout(data: bytes) -> ui__RomLayout:
    if len(data) not in (ui__STOCK_ROM_SIZE, ui__EXTENDED_ROM_SIZE):
        raise ValueError("8 MiB 또는 16 MiB ROM만 지원합니다")
    meta = ui__read_meta(data)
    if meta and meta.get("format") == ui__PROJECT_FORMAT:
        profile = ui__PROFILES[int(meta["profile_version"])]
        return ui__RomLayout(
            profile,
            int(meta["roster_count"]),
            int(meta["image_count"]),
            int(meta["stat_table"]),
            int(meta["size_table"]),
            str(meta.get("mode", "patched")),
        )
    return jogress__identify_layout(data)


def ui__load_project(path: Path):
    obj = json.loads(path.read_text(encoding="utf-8"))
    if obj.get("format") == ui__PROJECT_FORMAT:
        converted = dict(obj)
        converted["format"] = jogress__PROJECT_FORMAT
        temp = path.with_suffix(path.suffix + ".\x7615load.tmp")
        try:
            temp.write_text(json.dumps(converted, ensure_ascii=False, indent=2), encoding="utf-8")
            project, data, images, layout = jogress__load_project(temp)
            project.project_path = path
            return (project, data, images, layout)
        finally:
            try:
                temp.unlink()
            except OSError:
                pass
    return jogress__load_project(path)


def ui__patch_album_decimal_glyphs(out: bytearray, size_table: int) -> dict[str, Any]:

    zero = ui___read_rom_image(out, ui__DIGIT_ZERO_IMAGE, size_table)
    one = ui___read_rom_image(out, ui__DIGIT_ONE_IMAGE, size_table)
    if (zero.width, zero.height) != (12, 24) or (one.width, one.height) != (12, 24):
        raise ValueError("숫자 0/1 글리프가 기대한 12x24 형식이 아닙니다")
    zero_pil = core__rgb565_to_pil(zero)
    one_pil = core__rgb565_to_pil(one)
    replacements = {
        ui__QUOTIENT_10_IMAGE: ui___make_two_digit_glyph(one_pil, zero_pil),
        ui__QUOTIENT_11_IMAGE: ui___make_two_digit_glyph(one_pil, one_pil),
    }
    report: list[dict[str, Any]] = []
    for image_id, replacement in replacements.items():
        width = core__read_u16(out, size_table + image_id * 4)
        height = core__read_u16(out, size_table + image_id * 4 + 2)
        if (width, height) != (12, 24):
            raise ValueError(f"합성 대상 이미지 {image_id:#x}가 12x24가 아닙니다: {width}x{height}")
        address = core__BANK1 + core__read_u32(out, core__BANK1 + image_id * 4)
        pixels = ui___rgba_to_rgb565_any(replacement)
        if len(pixels) != width * height * 2:
            raise AssertionError("합성 글리프 크기 오류")
        before = bytes(out[address : address + len(pixels)])
        out[address : address + len(pixels)] = pixels
        report.append(
            {
                "image_id": image_id,
                "address": address,
                "size": [width, height],
                "before_sha256": core__sha256(before),
                "after_sha256": core__sha256(pixels),
                "display": "10" if image_id == ui__QUOTIENT_10_IMAGE else "11",
            }
        )
    return {
        "policy": "album code untouched; stock quotient glyphs 0x9D/0x9E replaced in-place with compact 10/11 composites",
        "code_hooks_added": 0,
        "supported_visible_range": "100-119 (8MB 100-114 fully covered)",
        "glyphs": report,
    }


def ui__project_to_dict(project: core.Project, profile_version: int) -> dict[str, Any]:
    obj = jogress__project_to_dict(project, profile_version)
    obj["format"] = ui__PROJECT_FORMAT
    obj["app_version"] = ui__APP_VERSION
    return obj


def ui__save_project(project: core.Project, profile_version: int, path: Path) -> None:
    obj = ui__project_to_dict(project, profile_version)
    base = Path(obj["base_rom"])
    if base.is_absolute():
        try:
            obj["base_rom"] = os.path.relpath(base, path.parent).replace("\\", "/")
        except ValueError:
            pass
    path.write_text(json.dumps(obj, ensure_ascii=False, indent=2), encoding="utf-8")
    project.project_path = path


def ui__standard_display_name(profile_version: int, digimon_id: int) -> str:

    return f"VP{profile_version} ID {digimon_id:03d}"


globals()["universal__APP_VERSION"] = ui__APP_VERSION
globals()["universal__PROJECT_FORMAT"] = ui__PROJECT_FORMAT
globals()["universal__PROJECT_ROSTER_COUNT"] = ui__PROJECT_ROSTER_COUNT
globals()["universal__STANDARD_ROSTER_COUNT"] = ui__STANDARD_ROSTER_COUNT
globals()["universal__EXTENDED_ROSTER_COUNT"] = ui__EXTENDED_ROSTER_COUNT
globals()["universal__identify_layout"] = ui__identify_layout
globals()["universal__create_project_from_rom"] = ui__create_project_from_rom
globals()["universal__save_universal_project"] = ui__save_project
globals()["universal__load_universal_project"] = ui__load_project
globals()["universal__build_universal_rom"] = ui__build_rom


class ui__GUI(jogress__GUI):

    @staticmethod
    def _capacity_class(profile: Any, digimon_id: int) -> str:
        if digimon_id < int(profile.stock_roster_count):
            return "기존"
        if digimon_id < ui__STANDARD_ROSTER_COUNT:
            return "확장"
        return "16MB"

    def _restore_roster_row_class(self, digimon_id: int) -> None:
        if self.project is None or self.profile is None:
            return
        iid = str(digimon_id)
        if not self.roster_tree.exists(iid):
            return
        slot = self.project.slots[digimon_id]
        self.roster_tree.item(
            iid,
            values=(
                f"{slot.digimon_id:03d}",
                slot.name,
                self._capacity_class(self.profile, slot.digimon_id),
            ),
        )


    def commit_current_slot(self) -> None:
        current = getattr(self, "current_id", 0)
        super().commit_current_slot()
        self._restore_roster_row_class(current)


    def refresh_roster(self) -> None:
        super().refresh_roster()
        if self.project is None or self.profile is None:
            return
        for slot in self.project.slots:
            self._restore_roster_row_class(slot.digimon_id)


import argparse
import copy
import json
import os
import traceback
from pathlib import Path
from typing import Any, Optional

stable__APP_VERSION = "20.0.0"
stable__PROJECT_FORMAT = "PenCUniversalProject\x5620"
stable__PROJECT_ROSTER_COUNT = jogress__PROJECT_ROSTER_COUNT
stable__STANDARD_ROSTER_COUNT = jogress__STANDARD_ROSTER_COUNT
stable__EXTENDED_ROSTER_COUNT = jogress__EXTENDED_ROSTER_COUNT
stable__STOCK_ROM_SIZE = jogress__STOCK_ROM_SIZE
stable__EXTENDED_ROM_SIZE = jogress__EXTENDED_ROM_SIZE
stable__METADATA_OFFSET = jogress__METADATA_OFFSET
stable__METADATA_SIZE = jogress__METADATA_SIZE
stable__METADATA_MAGIC = jogress__METADATA_MAGIC
stable__PROFILES = jogress__PROFILES
stable__RomLayout = jogress__RomLayout


def stable__read_meta(data: bytes) -> Optional[dict[str, Any]]:
    return evolution_merge__read_meta(data)


def stable___rewrite_meta(out: bytearray, report: dict[str, Any], extended: bool) -> None:
    meta = stable__read_meta(out) or {}
    for key in list(meta):
        if (
            key.startswith("album_")
            or key.startswith("\x7617_album")
            or key.startswith("shared_glyph")
        ):
            meta.pop(key, None)
    meta.update(
        {
            "format": stable__PROJECT_FORMAT,
            "app_version": stable__APP_VERSION,
            "mode": (
                "extended16-\x7620-strict-album-rollback"
                if extended
                else "standard8-\x7620-strict-album-rollback"
            ),
            "album_policy": "exact \x5615/\x5613 runtime path; no \x5616-\x5619 album hooks, boundary patches, state wrappers, or glyph changes",
        }
    )
    encoded = json.dumps(meta, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
    if len(encoded) + 12 > stable__METADATA_SIZE:
        raise ValueError("\x5620 메타데이터 공간 초과")
    out[stable__METADATA_OFFSET : stable__METADATA_OFFSET + stable__METADATA_SIZE] = (
        b"\x00" * stable__METADATA_SIZE
    )
    out[stable__METADATA_OFFSET : stable__METADATA_OFFSET + 8] = stable__METADATA_MAGIC
    core__write_u32(out, stable__METADATA_OFFSET + 8, len(encoded))
    out[stable__METADATA_OFFSET + 12 : stable__METADATA_OFFSET + 12 + len(encoded)] = encoded


def stable__build_rom(
    project: core.Project, source: bytes, layout: RomLayout, target: int, extended: bool
):
    source_meta = stable__read_meta(source) or {}
    unstable_formats = {
        "PenCUniversalProject\x5616",
        "PenCUniversalProject\x5617",
        "PenCUniversalProject\x5618",
        "PenCUniversalProject\x5619",
    }
    if source_meta.get("format") in unstable_formats:
        raise ValueError(
            "\x5616~\x5619 생성 ROM은 앨범 리셋 코드가 이미 들어 있어 \x5620의 기반 ROM으로 사용할 수 없습니다. 원본 PenC0~PenC5 ROM 또는 \x5613/\x5615/\x5620 ROM을 다시 여십시오."
        )
    data, report = jogress__build_rom(project, source, layout, target, extended)
    out = bytearray(data)
    stable___rewrite_meta(out, report, extended)
    final = copy.deepcopy(report)
    final["format"] = "PenC Universal Editor \x5620 strict rollback report"
    final["app_version"] = stable__APP_VERSION
    final["album_policy"] = "\x5615/\x5613 exact; no later album modifications"
    final["removed_changes"] = [
        "\x5616 shared glyph replacement",
        "\x5617 hybrid acquired/visible state wrappers",
        "\x5618 I\x4499 boundary patch and A/B glyph replacement",
        "\x5619 exact-stock wrapper and album quotient hook",
    ]
    final["output_sha256"] = core__sha256(out)
    final["hardware_test_priority"] = [
        "album menu enters without reset",
        "sleep/wake remains functional",
        "stock two-digit number behaviour is unchanged (100 may show F0)",
    ]
    return (bytes(out), final)


def stable__create_project_from_rom(path: Path):
    data = path.read_bytes()
    layout = stable__identify_layout(data)
    album_layers__activate(layout.profile, stable__PROJECT_ROSTER_COUNT)
    images = album_layers__read_images_flexible(data, layout.image_count, layout.size_table)
    slots: list[core__DigimonSlot] = []
    current = min(layout.roster_count, stable__PROJECT_ROSTER_COUNT)
    for did in range(current):
        stats = core__read_stat_words(data, did, layout.stat_table)
        start = stats[0]
        frames = [core__FrameRef("base", start + i) for i in range(12)]
        slots.append(
            core__DigimonSlot(
                did,
                stable__standard_display_name(layout.profile.version, did),
                stats,
                frames,
                core__EvolutionRoute(),            )
        )
    template_id = max(0, current - 1)
    template_stats = list(slots[template_id].stats)
    template_frames = copy.deepcopy(slots[template_id].frames)
    for did in range(current, stable__PROJECT_ROSTER_COUNT):
        stats = list(template_stats)
        stats[core__ALBUM_ORDER_STAT_INDEX] = did
        stats[core__ALBUM_VISIBLE_STAT_INDEX] = 1
        slots.append(
            core__DigimonSlot(
                did,
                stable__standard_display_name(layout.profile.version, did),
                stats,
                copy.deepcopy(template_frames),
                core__EvolutionRoute(False, 0, []),
            )
        )
    project = core__Project(
        slots=slots,
        rom_files={"vanilla": str(path.resolve()), "profile_version": str(layout.profile.version)},
    )
    evolution_loader__attach_paths(project, data, layout)
    jogress___attach_jogress(project, data, layout)
    return (project, data, images, layout)


def stable__identify_layout(data: bytes) -> stable__RomLayout:
    if len(data) not in (stable__STOCK_ROM_SIZE, stable__EXTENDED_ROM_SIZE):
        raise ValueError("8 MiB 또는 16 MiB ROM만 지원합니다")
    meta = stable__read_meta(data)
    if meta and all(
        (
            k in meta
            for k in ("profile_version", "roster_count", "image_count", "stat_table", "size_table")
        )
    ):
        profile = stable__PROFILES[int(meta["profile_version"])]
        return stable__RomLayout(
            profile,
            int(meta["roster_count"]),
            int(meta["image_count"]),
            int(meta["stat_table"]),
            int(meta["size_table"]),
            str(meta.get("mode", "patched")),
        )
    return jogress__identify_layout(data)


def stable__load_project(path: Path):
    obj = json.loads(path.read_text(encoding="utf-8"))
    if obj.get("format") == stable__PROJECT_FORMAT:
        converted = dict(obj)
        converted["format"] = jogress__PROJECT_FORMAT
        temp = path.with_suffix(path.suffix + ".\x7615load.tmp")
        try:
            temp.write_text(json.dumps(converted, ensure_ascii=False, indent=2), encoding="utf-8")
            project, data, images, layout = jogress__load_project(temp)
            project.project_path = path
            return (project, data, images, layout)
        finally:
            try:
                temp.unlink()
            except OSError:
                pass
    return jogress__load_project(path)


def stable__project_to_dict(project: core.Project, profile_version: int) -> dict[str, Any]:
    obj = jogress__project_to_dict(project, profile_version)
    obj["format"] = stable__PROJECT_FORMAT
    obj["app_version"] = stable__APP_VERSION
    return obj


def stable__save_project(project: core.Project, profile_version: int, path: Path) -> None:
    obj = stable__project_to_dict(project, profile_version)
    base = Path(obj["base_rom"])
    if base.is_absolute():
        try:
            obj["base_rom"] = os.path.relpath(base, path.parent).replace("\\", "/")
        except ValueError:
            pass
    path.write_text(json.dumps(obj, ensure_ascii=False, indent=2), encoding="utf-8")
    project.project_path = path


def stable__standard_display_name(profile_version: int, digimon_id: int) -> str:
    return f"VP{profile_version} ID {digimon_id:03d}"


globals()["universal__APP_VERSION"] = stable__APP_VERSION
globals()["universal__PROJECT_FORMAT"] = stable__PROJECT_FORMAT
globals()["universal__PROJECT_ROSTER_COUNT"] = stable__PROJECT_ROSTER_COUNT
globals()["universal__STANDARD_ROSTER_COUNT"] = stable__STANDARD_ROSTER_COUNT
globals()["universal__EXTENDED_ROSTER_COUNT"] = stable__EXTENDED_ROSTER_COUNT
globals()["universal__identify_layout"] = stable__identify_layout
globals()["universal__create_project_from_rom"] = stable__create_project_from_rom
globals()["universal__save_universal_project"] = stable__save_project
globals()["universal__load_universal_project"] = stable__load_project
globals()["universal__build_universal_rom"] = stable__build_rom


class stable__GUI(ui__GUI):

    pass


import argparse
import copy
import json
import os
import struct
import traceback
from pathlib import Path
from typing import Any, Optional

acquired_route__APP_VERSION = "23.0.0"
acquired_route__PROJECT_FORMAT = "PenCUniversalProject\x5623"
acquired_route__PROJECT_ROSTER_COUNT = stable__PROJECT_ROSTER_COUNT
acquired_route__STANDARD_ROSTER_COUNT = stable__STANDARD_ROSTER_COUNT
acquired_route__EXTENDED_ROSTER_COUNT = stable__EXTENDED_ROSTER_COUNT
acquired_route__METADATA_OFFSET = stable__METADATA_OFFSET
acquired_route__METADATA_SIZE = stable__METADATA_SIZE
acquired_route__METADATA_MAGIC = stable__METADATA_MAGIC
acquired_route__PROFILES = stable__PROFILES
acquired_route__RomLayout = stable__RomLayout
acquired_route__STOCK_ACQUIRED_BASE = 2127
acquired_route__EXT_ACQUIRED_BASE = relocation__ACQUIRED_RAM_BASE
acquired_route__EXT_ACQUIRED_BIASED_BASE = acquired_route__EXT_ACQUIRED_BASE - 4
acquired_route__STOCK_ACQUIRED_MAX_ID = 63
acquired_route__SJ18_SIZE = 8 + jogress__MAX_SPECIAL_JOGRESS_ROUTES * 6


def acquired_route__read_meta(data: bytes) -> Optional[dict[str, Any]]:
    return stable__read_meta(data)


def acquired_route___acquired_test_router(resume_raw: int) -> list[int]:

    w: list[int] = [38401, relocation__cmp16_word(3), acquired_route__STOCK_ACQUIRED_MAX_ID]
    ja_high = len(w)
    w.append(0)
    w += [relocation__mov16_word(2), acquired_route__STOCK_ACQUIRED_BASE]
    jmp_resume = len(w)
    w.append(0)
    high = len(w)
    w += [relocation__mov16_word(2), acquired_route__EXT_ACQUIRED_BIASED_BASE]
    resume = len(w)
    w += list(core__far_goto_words(resume_raw))
    w[ja_high] = acquired_route___branch(9, ja_high, high)
    w[jmp_resume] = acquired_route___branch(14, jmp_resume, resume)
    return w


def acquired_route___branch(cond: int, src_index: int, dst_index: int) -> int:
    distance = dst_index - (src_index + 1)
    if not 0 <= distance <= 63:
        raise ValueError(f"로컬 분기 거리 초과: {distance}")
    return relocation__local_branch(cond, distance)


def acquired_route___generic_set_router(resume_raw: int) -> list[int]:

    w: list[int] = [8259, 37893, relocation__cmp16_word(2), acquired_route__STOCK_ACQUIRED_BASE]
    je_acquired = len(w)
    w.append(0)
    w += [relocation__cmp16_word(2), acquired_route__EXT_ACQUIRED_BASE]
    bne_resume = len(w)
    w.append(0)
    acquired = len(w)
    w += [38400, relocation__cmp16_word(3), acquired_route__STOCK_ACQUIRED_MAX_ID]
    ja_high = len(w)
    w.append(0)
    w += [relocation__mov16_word(2), acquired_route__STOCK_ACQUIRED_BASE]
    jmp_resume = len(w)
    w.append(0)
    high = len(w)
    w += [relocation__mov16_word(2), acquired_route__EXT_ACQUIRED_BIASED_BASE]
    resume = len(w)
    w += list(core__far_goto_words(resume_raw))
    w[je_acquired] = acquired_route___branch(5, je_acquired, acquired)
    w[bne_resume] = acquired_route___branch(4, bne_resume, resume)
    w[ja_high] = acquired_route___branch(9, ja_high, high)
    w[jmp_resume] = acquired_route___branch(14, jmp_resume, resume)
    return w


def acquired_route___helper_start(report: dict[str, Any]) -> int:
    special = report.get("special_jogress", {})
    sj18 = special.get("sj18_compat_offset")
    if sj18 is not None:
        start = int(sj18) + acquired_route__SJ18_SIZE
    else:
        start = int(special.get("code_offset", report["tables"]["evo"])) + int(
            special.get("bytes_used", 0)
        )
    return start + 31 & ~31


def acquired_route___put_words(out: bytearray, offset: int, words: list[int]) -> int:
    blob = struct.pack("<" + "H" * len(words), *words)
    if offset + len(blob) > len(out):
        raise ValueError("획득 비트 라우팅 코드가 ROM 범위를 벗어납니다")
    if any(out[offset : offset + len(blob)]):
        raise ValueError(f"획득 비트 라우팅 공간이 비어 있지 않습니다: {offset:#x}")
    out[offset : offset + len(blob)] = blob
    return offset + len(blob)


def acquired_route___rewrite_meta(out: bytearray, acquired: dict[str, Any], extended: bool) -> None:
    meta = acquired_route__read_meta(out) or {}
    meta.update(
        {
            "format": acquired_route__PROJECT_FORMAT,
            "app_version": acquired_route__APP_VERSION,
            "mode": (
                "extended16-\x7623-order-routed-acquired"
                if extended
                else "standard8-\x7623-order-routed-acquired"
            ),
            "album_policy": "\x5620/\x5615/\x5613 entry and visibility unchanged",
            "acquired_state_policy": acquired["policy"],
            "\x7623_acquired_state": acquired,
        }
    )
    encoded = json.dumps(meta, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
    if len(encoded) + 12 > acquired_route__METADATA_SIZE:
        raise ValueError("\x5623 메타데이터 공간 초과")
    out[
        acquired_route__METADATA_OFFSET : acquired_route__METADATA_OFFSET
        + acquired_route__METADATA_SIZE
    ] = (b"\x00" * acquired_route__METADATA_SIZE)
    out[acquired_route__METADATA_OFFSET : acquired_route__METADATA_OFFSET + 8] = (
        acquired_route__METADATA_MAGIC
    )
    core__write_u32(out, acquired_route__METADATA_OFFSET + 8, len(encoded))
    out[
        acquired_route__METADATA_OFFSET + 12 : acquired_route__METADATA_OFFSET + 12 + len(encoded)
    ] = encoded


def acquired_route__build_rom(
    project: core.Project, source: bytes, layout: RomLayout, target: int, extended: bool
):
    base, report = stable__build_rom(project, source, layout, target, extended)
    out = bytearray(base)
    profile = layout.profile
    visibility_before = bytes(
        out[profile.album_visibility_function : profile.album_visibility_function_end]
    )
    cursor_before = bytes(out[profile.album_cursor_hook : profile.album_cursor_hook + 4])
    acquired = acquired_route__patch_acquired_state_only(out, profile, report)
    if (
        bytes(out[profile.album_visibility_function : profile.album_visibility_function_end])
        != visibility_before
    ):
        raise AssertionError("앨범 표시 함수가 변경되었습니다")
    if bytes(out[profile.album_cursor_hook : profile.album_cursor_hook + 4]) != cursor_before:
        raise AssertionError("앨범 진입/커서 훅이 변경되었습니다")
    acquired_route___rewrite_meta(out, acquired, extended)
    final = copy.deepcopy(report)
    final["format"] = "PenC Universal Editor \x5623 acquired-state report"
    final["app_version"] = acquired_route__APP_VERSION
    final["album_entry_policy"] = "byte-identical to \x5620/\x5615/\x5613"
    final["album_visibility_policy"] = "byte-identical to \x5620/\x5615/\x5613"
    final["acquired_state"] = acquired
    final["output_sha256"] = core__sha256(out)
    final["hardware_test_priority"] = [
        "album enters without reset",
        "already registered ID 1 shows its real sprite instead of locked state",
        "newly registered ID below 64 appears immediately and survives reboot",
        "album number 100 (ID 99) acquisition appears during the same powered session",
        "album number 114 (ID 113) acquisition appears during the same powered session",
    ]
    return (bytes(out), final)


def acquired_route__create_project_from_rom(path: Path):
    return stable__create_project_from_rom(path)


def acquired_route__identify_layout(data: bytes) -> acquired_route__RomLayout:
    meta = acquired_route__read_meta(data)
    if meta and meta.get("format") == acquired_route__PROJECT_FORMAT:
        profile = acquired_route__PROFILES[int(meta["profile_version"])]
        return acquired_route__RomLayout(
            profile,
            int(meta["roster_count"]),
            int(meta["image_count"]),
            int(meta["stat_table"]),
            int(meta["size_table"]),
            str(meta.get("mode", "patched")),
        )
    return stable__identify_layout(data)


def acquired_route__load_project(path: Path):
    obj = json.loads(path.read_text(encoding="utf-8"))
    if obj.get("format") == acquired_route__PROJECT_FORMAT:
        converted = dict(obj)
        converted["format"] = stable__PROJECT_FORMAT
        temp = path.with_suffix(path.suffix + ".\x7620load.tmp")
        try:
            temp.write_text(json.dumps(converted, ensure_ascii=False, indent=2), encoding="utf-8")
            project, data, images, layout = stable__load_project(temp)
            project.project_path = path
            return (project, data, images, layout)
        finally:
            try:
                temp.unlink()
            except OSError:
                pass
    return stable__load_project(path)


def acquired_route__patch_acquired_state_only(
    out: bytearray, profile: Any, report: dict[str, Any]
) -> dict[str, Any]:

    generic_set = profile.album_visibility_function - 248
    acquired_test = profile.album_visibility_function - 166
    expected_generic = struct.pack("<2H", 8259, 37893)
    expected_test = struct.pack("<2H", 38154, acquired_route__EXT_ACQUIRED_BASE)
    generic_patch_site = generic_set + 40
    test_patch_site = acquired_test + 46
    if bytes(out[generic_patch_site : generic_patch_site + 4]) != expected_generic:
        raise ValueError(
            f"획득 설정 함수 패턴 불일치 @{generic_patch_site:#x}: {out[generic_patch_site:generic_patch_site + 4].hex()}"
        )
    if bytes(out[test_patch_site : test_patch_site + 4]) != expected_test:
        raise ValueError(
            f"획득 검사 함수 패턴 불일치 @{test_patch_site:#x}: {out[test_patch_site:test_patch_site + 4].hex()}"
        )
    cursor = acquired_route___helper_start(report)
    generic_impl = cursor
    cursor = acquired_route___put_words(
        out, cursor, acquired_route___generic_set_router(generic_patch_site + 4)
    )
    cursor = cursor + 1 & ~1
    test_impl = cursor
    cursor = acquired_route___put_words(
        out, cursor, acquired_route___acquired_test_router(test_patch_site + 4)
    )
    core__write_far_goto(out, generic_patch_site, generic_impl)
    core__write_far_goto(out, test_patch_site, test_impl)
    return {
        "policy": "\x5620 album entry unchanged; acquired SET/TEST route by saved stat[13] album order",
        "stock_ids": "album order 0..63 uses original save-backed bitmap 0x084F",
        "extended_ids": "album order 64+ uses storage 0x27A0 via biased helper base 0x279C",
        "stock_acquired_base": acquired_route__STOCK_ACQUIRED_BASE,
        "extension_acquired_storage": acquired_route__EXT_ACQUIRED_BASE,
        "extension_acquired_biased_base": acquired_route__EXT_ACQUIRED_BIASED_BASE,
        "generic_set_entry": generic_set,
        "generic_set_patch_site": generic_patch_site,
        "generic_set_router": generic_impl,
        "setter_order_source": "[bp+0] (stat[13])",
        "acquired_test_entry": acquired_test,
        "acquired_test_patch_site": test_patch_site,
        "acquired_test_router": test_impl,
        "tester_order_source": "[bp+1] (stat[13])",
        "tester_patch_keeps_prior_arg_allocation": True,
        "router_end": cursor,
        "full_power_persistence": "IDs 0..63 use stock save; IDs 64+ use corrected extension RAM and remain RAM-only until save format is extended",
    }


def acquired_route__project_to_dict(project: core.Project, profile_version: int) -> dict[str, Any]:
    obj = stable__project_to_dict(project, profile_version)
    obj["format"] = acquired_route__PROJECT_FORMAT
    obj["app_version"] = acquired_route__APP_VERSION
    return obj


def acquired_route__save_project(project: core.Project, profile_version: int, path: Path) -> None:
    obj = acquired_route__project_to_dict(project, profile_version)
    base = Path(obj["base_rom"])
    if base.is_absolute():
        try:
            obj["base_rom"] = os.path.relpath(base, path.parent).replace("\\", "/")
        except ValueError:
            pass
    path.write_text(json.dumps(obj, ensure_ascii=False, indent=2), encoding="utf-8")
    project.project_path = path


globals()["universal__APP_VERSION"] = acquired_route__APP_VERSION
globals()["universal__PROJECT_FORMAT"] = acquired_route__PROJECT_FORMAT
globals()["universal__PROJECT_ROSTER_COUNT"] = acquired_route__PROJECT_ROSTER_COUNT
globals()["universal__STANDARD_ROSTER_COUNT"] = acquired_route__STANDARD_ROSTER_COUNT
globals()["universal__EXTENDED_ROSTER_COUNT"] = acquired_route__EXTENDED_ROSTER_COUNT
globals()["universal__identify_layout"] = acquired_route__identify_layout
globals()["universal__create_project_from_rom"] = acquired_route__create_project_from_rom
globals()["universal__save_universal_project"] = acquired_route__save_project
globals()["universal__load_universal_project"] = acquired_route__load_project
globals()["universal__build_universal_rom"] = acquired_route__build_rom


class acquired_route__GUI(stable__GUI):

    def _open_rom(self, path: Path) -> None:
        universal__UniversalEditorGUI._open_rom(self, path)
        self.root.title(
            f"{self.profile.label} 통합 로스터 편집기 V{acquired_route__APP_VERSION} - {path.name}"
        )
        self.update_status(
            f"{self.profile.label} | 앨범 진입 \x5620 유지 | 획득 stat[13] 0~63 원본 / 64+ 확장영역"
        )
        self._refresh_route_selector(prefer_existing=True)
        self.refresh_jogress_tab()

    def open_project(self, path: Path) -> None:
        project, data, images, layout = acquired_route__load_project(path.resolve())
        self.profile, self.layout = (layout.profile, layout)
        album_layers__activate(self.profile, acquired_route__PROJECT_ROSTER_COUNT)
        globals()["core__ORIGINAL_STAT_TABLE"] = layout.stat_table
        self.project, self.vanilla, self.base_images = (project, data, images)
        self.rom_paths = {"vanilla": Path(project.rom_files["vanilla"]).resolve()}
        self.dirty = False
        self.refresh_roster()
        self.select_slot(0)
        self.root.title(
            f"{layout.profile.label} 통합 로스터 편집기 V{acquired_route__APP_VERSION} - {path.name}"
        )
        self.update_status(f"프로젝트 열기: {path.name}")
        self._refresh_route_selector(prefer_existing=True)
        self.refresh_jogress_tab()


import argparse
import copy
import json
import os
import struct
import traceback
from pathlib import Path
from typing import Any, Optional

acquired_banks__APP_VERSION = "24.0.0"
acquired_banks__PROJECT_FORMAT = "PenCUniversalProject\x5624"
acquired_banks__PROJECT_ROSTER_COUNT = stable__PROJECT_ROSTER_COUNT
acquired_banks__STANDARD_ROSTER_COUNT = stable__STANDARD_ROSTER_COUNT
acquired_banks__EXTENDED_ROSTER_COUNT = stable__EXTENDED_ROSTER_COUNT
acquired_banks__STOCK_ROM_SIZE = stable__STOCK_ROM_SIZE
acquired_banks__EXTENDED_ROM_SIZE = stable__EXTENDED_ROM_SIZE
acquired_banks__METADATA_OFFSET = stable__METADATA_OFFSET
acquired_banks__METADATA_SIZE = stable__METADATA_SIZE
acquired_banks__METADATA_MAGIC = stable__METADATA_MAGIC
acquired_banks__PROFILES = stable__PROFILES
acquired_banks__RomLayout = stable__RomLayout
acquired_banks__STOCK_ACQUIRED_BASE = 2127
acquired_banks__EXT_ACQUIRED_BASE = relocation__ACQUIRED_RAM_BASE
acquired_banks__ACQUIRED_BANK_SIZE_IDS = 64
acquired_banks__ACQUIRED_BANK_WORDS = 4
acquired_banks__ACQUIRED_BANK_BASES = (
    acquired_banks__STOCK_ACQUIRED_BASE,
    acquired_banks__EXT_ACQUIRED_BASE + 0 * acquired_banks__ACQUIRED_BANK_WORDS,
    acquired_banks__EXT_ACQUIRED_BASE + 1 * acquired_banks__ACQUIRED_BANK_WORDS,
    acquired_banks__EXT_ACQUIRED_BASE + 2 * acquired_banks__ACQUIRED_BANK_WORDS,
    acquired_banks__EXT_ACQUIRED_BASE + 3 * acquired_banks__ACQUIRED_BANK_WORDS,
)
acquired_banks__SJ18_SIZE = 8 + jogress__MAX_SPECIAL_JOGRESS_ROUTES * 6
acquired_banks__BIT_SET_TARGET = {0: 44540, 1: 45920, 2: 45836, 3: 45860, 4: 44418, 5: 44442}
acquired_banks__BIT_TEST_TARGET = {0: 44816, 1: 46196, 2: 46112, 3: 46136, 4: 44694, 5: 44718}
acquired_banks__HELPER_ID_MASK_WORD = 46207


def acquired_banks__read_meta(data: bytes) -> Optional[dict[str, Any]]:
    return stable__read_meta(data)


def acquired_banks___acquired_test_router(resume_raw: int) -> tuple[list[int], dict[str, Any]]:
    w: list[int] = []
    detail = acquired_banks___append_bank_selector(w, 1, resume_raw)
    return (w, detail)


def acquired_banks___append_bank_selector(
    w: list[int], local_offset: int, resume_raw: int
) -> dict[str, Any]:

    w.append(acquired_banks___load_bp(3, local_offset))
    bank_labels: list[int] = []
    ja_slots: list[int] = []
    commit_jumps: list[int] = []
    w += [relocation__cmp16_word(3), 63]
    ja_slots.append(len(w))
    w.append(0)
    w += [relocation__mov16_word(2), acquired_banks__ACQUIRED_BANK_BASES[0]]
    commit_jumps.append(len(w))
    w.append(0)
    for bank in range(1, 4):
        bank_labels.append(len(w))
        w += acquired_banks___sub64(3)
        w += [relocation__cmp16_word(3), 63]
        ja_slots.append(len(w))
        w.append(0)
        w += [relocation__mov16_word(2), acquired_banks__ACQUIRED_BANK_BASES[bank]]
        commit_jumps.append(len(w))
        w.append(0)
    bank_labels.append(len(w))
    w += acquired_banks___sub64(3)
    w += [relocation__mov16_word(2), acquired_banks__ACQUIRED_BANK_BASES[4]]
    commit = len(w)
    w.append(acquired_banks___store_bp(3, local_offset))
    w += list(core__far_goto_words(resume_raw))
    for i, slot in enumerate(ja_slots):
        w[slot] = acquired_banks___branch(9, slot, bank_labels[i])
    for slot in commit_jumps:
        w[slot] = acquired_banks___branch(14, slot, commit)
    return {
        "local_offset": local_offset,
        "bank_labels": bank_labels,
        "commit_index": commit,
        "resume_raw": resume_raw,
    }


def acquired_banks___branch(cond: int, src_index: int, dst_index: int) -> int:
    distance = dst_index - (src_index + 1)
    if not 0 <= distance <= 63:
        raise ValueError(f"로컬 분기 거리 초과: {distance}")
    return relocation__local_branch(cond, distance)


def acquired_banks___find_mask_word(out: bytes, start: int, window: int = 128) -> list[int]:
    found: list[int] = []
    end = min(len(out), start + window)
    for off in range(start, end, 2):
        if core__read_u16(out, off) == acquired_banks__HELPER_ID_MASK_WORD:
            found.append(off)
    return found


def acquired_banks___generic_set_router(resume_raw: int) -> tuple[list[int], dict[str, Any]]:

    w: list[int] = [8259, 37893, relocation__cmp16_word(2), acquired_banks__STOCK_ACQUIRED_BASE]
    je_stock = len(w)
    w.append(0)
    w += [relocation__cmp16_word(2), acquired_banks__EXT_ACQUIRED_BASE]
    je_ext = len(w)
    w.append(0)
    unrelated = len(w)
    w += list(core__far_goto_words(resume_raw))
    acquired = len(w)
    detail = acquired_banks___append_bank_selector(w, 0, resume_raw)
    w[je_stock] = acquired_banks___branch(5, je_stock, acquired)
    w[je_ext] = acquired_banks___branch(5, je_ext, acquired)
    detail.update({"unrelated_index": unrelated, "acquired_index": acquired})
    return (w, detail)


def acquired_banks___helper_start(report: dict[str, Any]) -> int:
    special = report.get("special_jogress", {})
    sj18 = special.get("sj18_compat_offset")
    if sj18 is not None:
        start = int(sj18) + acquired_banks__SJ18_SIZE
    else:
        start = int(special.get("code_offset", report["tables"]["evo"])) + int(
            special.get("bytes_used", 0)
        )
    return start + 31 & ~31


def acquired_banks___load_bp(reg: int, offset: int) -> int:
    if not (0 <= reg <= 7 and 0 <= offset <= 63):
        raise ValueError("잘못된 bp load 인코딩")
    return 9 << 12 | reg << 9 | offset


def acquired_banks___put_words(out: bytearray, offset: int, words: list[int]) -> int:
    blob = struct.pack("<" + "H" * len(words), *words)
    if offset + len(blob) > len(out):
        raise ValueError("\x5624 획득 비트 코드가 ROM 범위를 벗어납니다")
    if any(out[offset : offset + len(blob)]):
        raise ValueError(f"\x5624 cave가 비어 있지 않습니다: {offset:#x}")
    out[offset : offset + len(blob)] = blob
    return offset + len(blob)


def acquired_banks___rewrite_meta(out: bytearray, acquired: dict[str, Any], extended: bool) -> None:
    meta = acquired_banks__read_meta(out) or {}
    meta.update(
        {
            "format": acquired_banks__PROJECT_FORMAT,
            "app_version": acquired_banks__APP_VERSION,
            "mode": (
                "extended16-\x7624-banked-acquired"
                if extended
                else "standard8-\x7624-banked-acquired"
            ),
            "album_policy": "\x5620/\x5615/\x5613 entry, cursor and visibility unchanged",
            "acquired_state_policy": acquired["policy"],
            "\x7624_acquired_state": acquired,
        }
    )
    encoded = json.dumps(meta, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
    if len(encoded) + 12 > acquired_banks__METADATA_SIZE:
        raise ValueError("\x5624 메타데이터 공간 초과")
    out[
        acquired_banks__METADATA_OFFSET : acquired_banks__METADATA_OFFSET
        + acquired_banks__METADATA_SIZE
    ] = (b"\x00" * acquired_banks__METADATA_SIZE)
    out[acquired_banks__METADATA_OFFSET : acquired_banks__METADATA_OFFSET + 8] = (
        acquired_banks__METADATA_MAGIC
    )
    core__write_u32(out, acquired_banks__METADATA_OFFSET + 8, len(encoded))
    out[
        acquired_banks__METADATA_OFFSET + 12 : acquired_banks__METADATA_OFFSET + 12 + len(encoded)
    ] = encoded


def acquired_banks___store_bp(reg: int, offset: int) -> int:
    if not (0 <= reg <= 7 and 0 <= offset <= 63):
        raise ValueError("잘못된 bp store 인코딩")
    return 13 << 12 | reg << 9 | offset


def acquired_banks___sub64(reg: int = 3) -> list[int]:
    return [acquired_banks___sub_imm6(reg, 63), acquired_banks___sub_imm6(reg, 1)]


def acquired_banks___sub_imm6(reg: int, value: int) -> int:
    if not (0 <= reg <= 7 and 0 <= value <= 63):
        raise ValueError("잘못된 imm6 subtract 인코딩")
    return 2 << 12 | reg << 9 | 1 << 6 | value


def acquired_banks__build_rom(
    project: core.Project, source: bytes, layout: RomLayout, target: int, extended: bool
):
    base, report = stable__build_rom(project, source, layout, target, extended)
    out = bytearray(base)
    profile = layout.profile
    visibility_before = bytes(
        out[profile.album_visibility_function : profile.album_visibility_function_end]
    )
    cursor_before = bytes(out[profile.album_cursor_hook : profile.album_cursor_hook + 4])
    acquired = acquired_banks__patch_banked_acquired_state(out, profile, report)
    if (
        bytes(out[profile.album_visibility_function : profile.album_visibility_function_end])
        != visibility_before
    ):
        raise AssertionError("앨범 표시 함수가 변경되었습니다")
    if bytes(out[profile.album_cursor_hook : profile.album_cursor_hook + 4]) != cursor_before:
        raise AssertionError("앨범 진입/커서 훅이 변경되었습니다")
    acquired_banks___rewrite_meta(out, acquired, extended)
    final = copy.deepcopy(report)
    final["format"] = "PenC Universal Editor \x5624 banked acquired-state report"
    final["app_version"] = acquired_banks__APP_VERSION
    final["album_entry_policy"] = "byte-identical to \x5620/\x5615/\x5613"
    final["album_visibility_policy"] = "byte-identical to \x5620/\x5615/\x5613"
    final["acquired_state"] = acquired
    final["output_sha256"] = core__sha256(out)
    final["hardware_test_priority"] = [
        "album enters without reset",
        "ID 63 remains acquired",
        "album number 100 / ID 99 becomes acquired immediately",
        "album number 113 / ID 112 becomes acquired immediately",
        "album number 114 / ID 113 becomes acquired immediately",
    ]
    return (bytes(out), final)


def acquired_banks__create_project_from_rom(path: Path):
    return stable__create_project_from_rom(path)


def acquired_banks__identify_layout(data: bytes) -> acquired_banks__RomLayout:
    meta = acquired_banks__read_meta(data)
    if meta and meta.get("format") == acquired_banks__PROJECT_FORMAT:
        profile = acquired_banks__PROFILES[int(meta["profile_version"])]
        return acquired_banks__RomLayout(
            profile,
            int(meta["roster_count"]),
            int(meta["image_count"]),
            int(meta["stat_table"]),
            int(meta["size_table"]),
            str(meta.get("mode", "patched")),
        )
    return stable__identify_layout(data)


def acquired_banks__load_project(path: Path):
    obj = json.loads(path.read_text(encoding="utf-8"))
    if obj.get("format") == acquired_banks__PROJECT_FORMAT:
        converted = dict(obj)
        converted["format"] = stable__PROJECT_FORMAT
        temp = path.with_suffix(path.suffix + ".\x7620load.tmp")
        try:
            temp.write_text(json.dumps(converted, ensure_ascii=False, indent=2), encoding="utf-8")
            project, data, images, layout = stable__load_project(temp)
            project.project_path = path
            return (project, data, images, layout)
        finally:
            try:
                temp.unlink()
            except OSError:
                pass
    return stable__load_project(path)


def acquired_banks__patch_banked_acquired_state(
    out: bytearray, profile: Any, report: dict[str, Any]
) -> dict[str, Any]:

    generic_set = profile.album_visibility_function - 248
    acquired_test = profile.album_visibility_function - 166
    generic_patch_site = generic_set + 40
    test_patch_site = acquired_test + 46
    expected_generic = struct.pack("<2H", 8259, 37893)
    expected_test = struct.pack("<2H", 38154, acquired_banks__EXT_ACQUIRED_BASE)
    if bytes(out[generic_patch_site : generic_patch_site + 4]) != expected_generic:
        raise ValueError(
            f"획득 설정 함수 패턴 불일치 @{generic_patch_site:#x}: {out[generic_patch_site:generic_patch_site + 4].hex()}"
        )
    if bytes(out[test_patch_site : test_patch_site + 4]) != expected_test:
        raise ValueError(
            f"획득 검사 함수 패턴 불일치 @{test_patch_site:#x}: {out[test_patch_site:test_patch_site + 4].hex()}"
        )
    set_helper = acquired_banks__BIT_SET_TARGET[profile.version]
    test_helper = acquired_banks__BIT_TEST_TARGET[profile.version]
    set_masks = acquired_banks___find_mask_word(out, set_helper)
    test_masks = acquired_banks___find_mask_word(out, test_helper)
    if not set_masks or not test_masks:
        raise ValueError(f"원본 64-ID 마스크를 찾지 못했습니다: set={set_masks}, test={test_masks}")
    cursor = acquired_banks___helper_start(report)
    generic_impl = cursor
    generic_words, generic_detail = acquired_banks___generic_set_router(generic_patch_site + 4)
    cursor = acquired_banks___put_words(out, cursor, generic_words)
    cursor = cursor + 1 & ~1
    test_impl = cursor
    test_words, test_detail = acquired_banks___acquired_test_router(test_patch_site + 4)
    cursor = acquired_banks___put_words(out, cursor, test_words)
    core__write_far_goto(out, generic_patch_site, generic_impl)
    core__write_far_goto(out, test_patch_site, test_impl)
    examples = {}
    for order in (63, 64, 99, 112, 113, 127, 128, 191, 192, 255, 256, 265):
        bank = order // 64
        normalized = order & 63
        base = acquired_banks__ACQUIRED_BANK_BASES[bank]
        examples[str(order)] = {
            "bank": bank,
            "helper_id": normalized,
            "base": base,
            "word": base + (normalized >> 4),
            "bit": normalized & 15,
        }
    return {
        "policy": "64-ID bank selection + local album-order normalization before stock helper",
        "stock_helper_masks_id_to_0x3f": True,
        "set_helper": set_helper,
        "set_helper_mask_sites": set_masks,
        "test_helper": test_helper,
        "test_helper_mask_sites": test_masks,
        "bank_size_ids": acquired_banks__ACQUIRED_BANK_SIZE_IDS,
        "bank_words": acquired_banks__ACQUIRED_BANK_WORDS,
        "bank_bases": list(acquired_banks__ACQUIRED_BANK_BASES),
        "generic_set_entry": generic_set,
        "generic_set_patch_site": generic_patch_site,
        "generic_set_router": generic_impl,
        "generic_set_words": len(generic_words),
        "generic_set_detail": generic_detail,
        "acquired_test_entry": acquired_test,
        "acquired_test_patch_site": test_patch_site,
        "acquired_test_router": test_impl,
        "acquired_test_words": len(test_words),
        "acquired_test_detail": test_detail,
        "router_end": cursor,
        "examples": examples,
        "persistence": "bank0 is stock-save-backed; extension banks remain RAM-only until save format is widened",
    }


def acquired_banks__project_to_dict(project: core.Project, profile_version: int) -> dict[str, Any]:
    obj = stable__project_to_dict(project, profile_version)
    obj["format"] = acquired_banks__PROJECT_FORMAT
    obj["app_version"] = acquired_banks__APP_VERSION
    return obj


def acquired_banks__save_project(project: core.Project, profile_version: int, path: Path) -> None:
    obj = acquired_banks__project_to_dict(project, profile_version)
    base = Path(obj["base_rom"])
    if base.is_absolute():
        try:
            obj["base_rom"] = os.path.relpath(base, path.parent).replace("\\", "/")
        except ValueError:
            pass
    path.write_text(json.dumps(obj, ensure_ascii=False, indent=2), encoding="utf-8")
    project.project_path = path


globals()["universal__APP_VERSION"] = acquired_banks__APP_VERSION
globals()["universal__PROJECT_FORMAT"] = acquired_banks__PROJECT_FORMAT
globals()["universal__PROJECT_ROSTER_COUNT"] = acquired_banks__PROJECT_ROSTER_COUNT
globals()["universal__STANDARD_ROSTER_COUNT"] = acquired_banks__STANDARD_ROSTER_COUNT
globals()["universal__EXTENDED_ROSTER_COUNT"] = acquired_banks__EXTENDED_ROSTER_COUNT
globals()["universal__identify_layout"] = acquired_banks__identify_layout
globals()["universal__create_project_from_rom"] = acquired_banks__create_project_from_rom
globals()["universal__save_universal_project"] = acquired_banks__save_project
globals()["universal__load_universal_project"] = acquired_banks__load_project
globals()["universal__build_universal_rom"] = acquired_banks__build_rom


class acquired_banks__GUI(stable__GUI):

    pass


import argparse
import copy
import json
import os
import struct
import traceback
from pathlib import Path
from typing import Any, Optional

acquired_safe__APP_VERSION = "26.0.0"
acquired_safe__PROJECT_FORMAT = "PenCUniversalProject\x5626"
acquired_safe__PROJECT_ROSTER_COUNT = acquired_banks__PROJECT_ROSTER_COUNT
acquired_safe__STANDARD_ROSTER_COUNT = acquired_banks__STANDARD_ROSTER_COUNT
acquired_safe__EXTENDED_ROSTER_COUNT = acquired_banks__EXTENDED_ROSTER_COUNT
acquired_safe__STOCK_ROM_SIZE = acquired_banks__STOCK_ROM_SIZE
acquired_safe__EXTENDED_ROM_SIZE = acquired_banks__EXTENDED_ROM_SIZE
acquired_safe__METADATA_OFFSET = acquired_banks__METADATA_OFFSET
acquired_safe__METADATA_SIZE = acquired_banks__METADATA_SIZE
acquired_safe__METADATA_MAGIC = acquired_banks__METADATA_MAGIC
acquired_safe__PROFILES = acquired_banks__PROFILES
acquired_safe__RomLayout = acquired_banks__RomLayout
acquired_safe__STOCK_ACQUIRED_BASE = 2127
acquired_safe__LEGACY_RELOCATED_ACQUIRED_BASE = 10144
acquired_safe__SAVE_EXT_ACQUIRED_BASE = 2131
acquired_safe__RELOCATED_EXT_ACQUIRED_BASE = 10144
acquired_safe__ACQUIRED_BANK_WORDS = 4
acquired_safe__ACQUIRED_BANK_BASES = (
    acquired_safe__STOCK_ACQUIRED_BASE,
    acquired_safe__SAVE_EXT_ACQUIRED_BASE,
    acquired_safe__RELOCATED_EXT_ACQUIRED_BASE + 0 * acquired_safe__ACQUIRED_BANK_WORDS,
    acquired_safe__RELOCATED_EXT_ACQUIRED_BASE + 1 * acquired_safe__ACQUIRED_BANK_WORDS,
    acquired_safe__RELOCATED_EXT_ACQUIRED_BASE + 2 * acquired_safe__ACQUIRED_BANK_WORDS,
)


def acquired_safe__read_meta(data: bytes) -> Optional[dict[str, Any]]:
    return acquired_banks__read_meta(data)


def acquired_safe___acquired_test_router(resume_raw: int) -> tuple[list[int], dict[str, Any]]:
    w: list[int] = []
    original_bases = acquired_banks__ACQUIRED_BANK_BASES
    try:
        globals()["acquired_banks__ACQUIRED_BANK_BASES"] = acquired_safe__ACQUIRED_BANK_BASES
        detail = acquired_banks___append_bank_selector(w, 1, resume_raw)
    finally:
        globals()["acquired_banks__ACQUIRED_BANK_BASES"] = original_bases
    return (w, detail)


def acquired_safe___generic_set_router(resume_raw: int) -> tuple[list[int], dict[str, Any]]:

    w: list[int] = [8259, 37893, relocation__cmp16_word(2), acquired_safe__STOCK_ACQUIRED_BASE]
    je_stock = len(w)
    w.append(0)
    w += [relocation__cmp16_word(2), acquired_safe__LEGACY_RELOCATED_ACQUIRED_BASE]
    je_legacy = len(w)
    w.append(0)
    unrelated = len(w)
    w += list(core__far_goto_words(resume_raw))
    acquired = len(w)
    original_bases = acquired_banks__ACQUIRED_BANK_BASES
    try:
        globals()["acquired_banks__ACQUIRED_BANK_BASES"] = acquired_safe__ACQUIRED_BANK_BASES
        detail = acquired_banks___append_bank_selector(w, 0, resume_raw)
    finally:
        globals()["acquired_banks__ACQUIRED_BANK_BASES"] = original_bases
    w[je_stock] = acquired_banks___branch(5, je_stock, acquired)
    w[je_legacy] = acquired_banks___branch(5, je_legacy, acquired)
    detail.update({"unrelated_index": unrelated, "acquired_index": acquired})
    return (w, detail)


def acquired_safe___remap_acquired_clear(out: bytearray, report: dict[str, Any]) -> dict[str, Any]:

    album_ram = report.get("album_ram", {})
    hook = int(album_ram["acquired_clear_start"])
    count = int(album_ram["word_count"])
    trampoline = relocation__far_target(out, hook)
    if trampoline is None:
        raise ValueError(f"획득 RAM clear 훅을 찾지 못했습니다: {hook:#x}")
    patched: list[dict[str, int]] = []
    cursor = trampoline
    end = min(len(out), trampoline + 8 + count * 12 + 32)
    while cursor + 8 <= end and len(patched) < count:
        if core__read_u16(out, cursor) == 65024 and core__read_u16(out, cursor + 2) == 39180:
            literal_off = cursor + 4
            value = core__read_u16(out, literal_off)
            expected = acquired_safe__LEGACY_RELOCATED_ACQUIRED_BASE + len(patched)
            if value == expected:
                idx = len(patched)
                if idx < acquired_safe__ACQUIRED_BANK_WORDS:
                    new_value = acquired_safe__SAVE_EXT_ACQUIRED_BASE + idx
                else:
                    new_value = acquired_safe__RELOCATED_EXT_ACQUIRED_BASE + (
                        idx - acquired_safe__ACQUIRED_BANK_WORDS
                    )
                core__write_u16(out, literal_off, new_value)
                patched.append({"offset": literal_off, "old": value, "new": new_value})
                cursor += 8
                continue
        cursor += 2
    if len(patched) != count:
        raise ValueError(f"획득 RAM clear 주소 치환 수 불일치: {len(patched)} != {count}")
    return {
        "hook": hook,
        "trampoline": trampoline,
        "word_count": count,
        "old_base": acquired_safe__LEGACY_RELOCATED_ACQUIRED_BASE,
        "save_extension_base": acquired_safe__SAVE_EXT_ACQUIRED_BASE,
        "relocated_extension_base": acquired_safe__RELOCATED_EXT_ACQUIRED_BASE,
        "patched": patched,
    }


def acquired_safe___rewrite_meta(out: bytearray, acquired: dict[str, Any], extended: bool) -> None:
    meta = acquired_safe__read_meta(out) or {}
    meta.update(
        {
            "format": acquired_safe__PROJECT_FORMAT,
            "app_version": acquired_safe__APP_VERSION,
            "mode": (
                "extended16-\x7626-banked-acquired"
                if extended
                else "standard8-\x7626-banked-acquired"
            ),
            "album_policy": "\x5620/\x5615/\x5613 entry, cursor and visibility unchanged",
            "acquired_state_policy": acquired["policy"],
            "\x7626_acquired_state": {
                "bank_bases": acquired["bank_bases"],
                "save_extension_range": acquired["save_extension_range"],
                "relocated_extension_range": acquired["relocated_extension_range"],
                "legacy_\x7620_caller_base": acquired["legacy_\x7620_caller_base"],
                "clear_map": acquired["clear_retarget"]["patched"],
                "persistence": acquired["persistence"],
            },
        }
    )
    encoded = json.dumps(meta, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
    if len(encoded) + 12 > acquired_safe__METADATA_SIZE:
        raise ValueError("\x5626 메타데이터 공간 초과")
    out[
        acquired_safe__METADATA_OFFSET : acquired_safe__METADATA_OFFSET
        + acquired_safe__METADATA_SIZE
    ] = (b"\x00" * acquired_safe__METADATA_SIZE)
    out[acquired_safe__METADATA_OFFSET : acquired_safe__METADATA_OFFSET + 8] = (
        acquired_safe__METADATA_MAGIC
    )
    core__write_u32(out, acquired_safe__METADATA_OFFSET + 8, len(encoded))
    out[
        acquired_safe__METADATA_OFFSET + 12 : acquired_safe__METADATA_OFFSET + 12 + len(encoded)
    ] = encoded


def acquired_safe__build_rom(
    project: core.Project, source: bytes, layout: RomLayout, target: int, extended: bool
):
    base, report = stable__build_rom(project, source, layout, target, extended)
    out = bytearray(base)
    profile = layout.profile
    visibility_before = bytes(
        out[profile.album_visibility_function : profile.album_visibility_function_end]
    )
    cursor_before = bytes(out[profile.album_cursor_hook : profile.album_cursor_hook + 4])
    acquired = acquired_safe__patch_collision_free_acquired_state(out, profile, report)
    if (
        bytes(out[profile.album_visibility_function : profile.album_visibility_function_end])
        != visibility_before
    ):
        raise AssertionError("앨범 표시 함수가 변경되었습니다")
    if bytes(out[profile.album_cursor_hook : profile.album_cursor_hook + 4]) != cursor_before:
        raise AssertionError("앨범 진입/커서 훅이 변경되었습니다")
    acquired_safe___rewrite_meta(out, acquired, extended)
    final = copy.deepcopy(report)
    final["format"] = "PenC Universal Editor \x5626 collision-free acquired-state report"
    final["app_version"] = acquired_safe__APP_VERSION
    final["album_entry_policy"] = "byte-identical to \x5620/\x5615/\x5613"
    final["album_visibility_policy"] = "byte-identical to \x5620/\x5615/\x5613"
    final["acquired_state"] = acquired
    final["output_sha256"] = core__sha256(out)
    final["hardware_test_priority"] = [
        "album enters without reset",
        "ID 63 remains acquired",
        "ID 77 becomes acquired without neighbouring false positives",
        "album number 100 / ID 99 becomes acquired without patterned false positives",
        "ID 113 becomes acquired without patterned false positives",
    ]
    return (bytes(out), final)

