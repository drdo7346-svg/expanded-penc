class jogress__GUI(evolution_ui__GUI):

    def __init__(self, root: Any, initial_project: Optional[Path] = None) -> None:
        self.jogress_tab = None
        self.attribute_vars: list[Any] = []
        self.attribute_combos: list[Any] = []
        self.special_tree = None
        super().__init__(root, initial_project=None)
        self._build_jogress_tab()
        if initial_project:
            self.open_project(initial_project)
        elif self.project is not None:
            self.refresh_jogress_tab()
        self.root.title(self.root.title().replace("\x5614", "\x5615"))


    def _id_choices(self, include_none: bool = False) -> list[str]:
        choices = (
            [f"{slot.digimon_id:03d}  {slot.name}" for slot in self.project.slots]
            if self.project
            else []
        )
        return ["[없음]"] + choices if include_none else choices

    @staticmethod
    def _choice_id(text: str) -> int:
        if text.startswith("[없음]") or not text.strip():
            return -1
        return int(text.split()[0])


    def load_slot(self, slot_id: int) -> None:
        super().load_slot(slot_id)
        self.refresh_jogress_tab()


    def refresh_roster(self) -> None:
        super().refresh_roster()
        self.refresh_jogress_tab()

    def validate_action(self) -> None:
        from tkinter import messagebox

        if self.project is None:
            return
        try:
            self.commit_current_slot()
            core__validate_project(self.project)
            jogress___validate_project_jogress(self.project)
            enabled = sum((1 for route in self.project.special_jogress_routes if route.enabled))
            attribute = sum(
                (1 for row in self.project.attribute_jogress_rows for value in row if value >= 0)
            )
            messagebox.showinfo(
                "검증 통과",
                f"로스터·스프라이트·진화조건 검증 통과\n속성 조그레스 결과 {attribute}개\n특수 조그레스 {enabled}/{len(self.project.special_jogress_routes)}개 사용",
                parent=self.root,
            )
            self.update_status("프로젝트 검증 통과")
        except Exception as exc:
            self.show_error("프로젝트 검증 실패", exc)


