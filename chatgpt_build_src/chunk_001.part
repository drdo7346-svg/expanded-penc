        "stat_table": tl["stat"],
        "size_table": tl["size"],
        "jogress_pointer_table": tl["jog_ptr"],
        "jogress_rows": tl["jog_rows"],
        "evolution_cave": tl["evo"],
        "mode": mode,
        "acquired_ram_base": album_layers__ACQUIRED_RAM_BASE,
        "visible_ram_base": album_layers__VISIBLE_RAM_BASE,
        **extra,
    }
    b = json.dumps(payload, ensure_ascii=False, separators=(",", ":")).encode()
    if len(b) + 12 > album_layers__METADATA_SIZE:
        raise ValueError("메타데이터 공간 초과")
    out[
        album_layers__METADATA_OFFSET : album_layers__METADATA_OFFSET + album_layers__METADATA_SIZE
    ] = (b"\x00" * album_layers__METADATA_SIZE)
    out[album_layers__METADATA_OFFSET : album_layers__METADATA_OFFSET + 8] = (
        album_layers__METADATA_MAGIC
    )
    core__write_u32(out, album_layers__METADATA_OFFSET + 8, len(b))
    out[album_layers__METADATA_OFFSET + 12 : album_layers__METADATA_OFFSET + 12 + len(b)] = b


globals()["universal__APP_VERSION"] = album_layers__APP_VERSION
globals()["universal__PROJECT_FORMAT"] = album_layers__PROJECT_FORMAT
globals()["universal__PROJECT_ROSTER_COUNT"] = album_layers__PROJECT_ROSTER_COUNT
globals()["universal__STANDARD_ROSTER_COUNT"] = album_layers__STANDARD_ROSTER_COUNT
globals()["universal__EXTENDED_ROSTER_COUNT"] = album_layers__EXTENDED_ROSTER_COUNT
globals()["universal__activate"] = album_layers__activate
globals()["universal__identify_layout"] = album_layers__identify_layout
globals()["universal__read_images_flexible"] = album_layers__read_images_flexible
globals()["universal__create_project_from_rom"] = album_layers__create_project_from_rom
globals()["universal__save_universal_project"] = album_layers__save_project
globals()["universal__load_universal_project"] = album_layers__load_project
globals()["universal__build_universal_rom"] = album_layers__build_rom


class album_layers__GUI(universal__UniversalEditorGUI):

    def _retitle_roster_label(self):

        def walk(w):
            for c in w.winfo_children():
                try:
                    t = c.cget("text")
                    if str(t).startswith("로스터 ID"):
                        c.configure(
                            text="로스터 ID 000–265 (000–113: 8MB 슬롯, 114–265: 16MB 슬롯)"
                        )
                except Exception:
                    pass
                walk(c)

        walk(self.root)


    def update_capacity(self):
        if self.project is None or self.profile is None:
            return
        try:
            a = album_layers__table_layout(self.profile, album_layers__STANDARD_ROSTER_COUNT)
            b = album_layers__table_layout(self.profile, album_layers__EXTENDED_ROSTER_COUNT)
            self.capacity_var.set(
                f"8MB 최대 {album_layers__STANDARD_ROSTER_COUNT}슬롯(완전 고유 45마리 기준) | 16MB 최대 {album_layers__EXTENDED_ROSTER_COUNT}슬롯(완전 고유 197마리 기준) | 동일 프레임 자동 공유 | 도감 번호 001–266"
            )
        except Exception as exc:
            self.capacity_var.set(str(exc))


import argparse
import copy
import json
import os
import struct
import sys
import traceback
from dataclasses import asdict, dataclass, field
from pathlib import Path
from typing import Any, Optional

evolution_loader__APP_VERSION = "12.0.0"
evolution_loader__PROJECT_FORMAT = "PenCUniversalProject\x5612"
evolution_loader__PROJECT_ROSTER_COUNT = album_layers__PROJECT_ROSTER_COUNT
evolution_loader__EXTENDED_ROSTER_COUNT = album_layers__EXTENDED_ROSTER_COUNT


@dataclass(frozen=True)
class evolution_loader__RomCondition:
    variable: str
    operator: str
    value: int

    def to_dict(self) -> dict[str, Any]:
        return {"variable": self.variable, "operator": self.operator, "value": self.value}

    @classmethod
    def from_dict(cls, obj: dict[str, Any]) -> "RomCondition":
        return cls(str(obj["variable"]), str(obj["operator"]), int(obj["value"]))


@dataclass(frozen=True)
class evolution_loader__RomEvolutionPath:
    source_id: int
    result_id: int
    conditions: tuple[evolution_loader__RomCondition, ...] = ()
    origin: str = "stock"
    handler: int = 0

    def to_dict(self) -> dict[str, Any]:
        return {
            "source_id": self.source_id,
            "result_id": self.result_id,
            "conditions": [c.to_dict() for c in self.conditions],
            "origin": self.origin,
            "handler": self.handler,
        }

    @classmethod
    def from_dict(cls, obj: dict[str, Any]) -> "RomEvolutionPath":
        return cls(
            int(obj["source_id"]),
            int(obj["result_id"]),
            tuple((evolution_loader__RomCondition.from_dict(x) for x in obj.get("conditions", []))),
            str(obj.get("origin", "stock")),
            int(obj.get("handler", 0)),
        )


evolution_loader__VARIABLE_LABELS = {
    "mem_082e": "케어 미스 횟수",
    "mem_0832": "훈련 횟수",
    "album_visible": "앨범 표시/해금 상태",
}
evolution_loader__VARIABLE_TO_KIND = {"mem_082e": 6, "mem_0832": 9}
evolution_loader__OP_TO_ID = {"<=": 0, "<": 1, ">=": 2, ">": 3, "!=": 4, "==": 5}


def evolution_loader__condition_text(cond: RomCondition) -> str:
    return f"{evolution_loader__VARIABLE_LABELS.get(cond.variable, cond.variable)} {cond.operator} {cond.value}"


def evolution_loader__path_condition_text(path: RomEvolutionPath) -> str:
    if not path.conditions:
        return "항상"
    return " AND ".join((evolution_loader__condition_text(c) for c in path.conditions))


evolution_loader__CC_NAMES = (
    "b",
    "ae",
    "ge",
    "l",
    "ne",
    "e",
    "pl",
    "mi",
    "be",
    "a",
    "le",
    "g",
    "vc",
    "vs",
    "jmp",
    "?",
)
evolution_loader__CC_TO_OPERATOR = {
    "e": "==",
    "ne": "!=",
    "a": ">",
    "ae": ">=",
    "b": "<",
    "be": "<=",
    "g": ">",
    "ge": ">=",
    "l": "<",
    "le": "<=",
}
evolution_loader__INVERSE_OPERATOR = {
    "==": "!=",
    "!=": "==",
    ">": "<=",
    ">=": "<",
    "<": ">=",
    "<=": ">",
}


@dataclass(frozen=True)
class evolution_loader___Expr:
    kind: str
    value: Any = None


evolution_loader___UNKNOWN = evolution_loader___Expr("unknown", None)


def evolution_loader___constant(value: int) -> evolution_loader___Expr:
    return evolution_loader___Expr("constant", int(value))


def evolution_loader___variable(name: str) -> evolution_loader___Expr:
    return evolution_loader___Expr("variable", str(name))


@dataclass
class evolution_loader___State:
    pc: int
    regs: list[evolution_loader___Expr] = field(
        default_factory=lambda: [evolution_loader___UNKNOWN] * 8
    )
    result: evolution_loader___Expr = evolution_loader___UNKNOWN
    cmp_left: evolution_loader___Expr = evolution_loader___UNKNOWN
    cmp_right: evolution_loader___Expr = evolution_loader___UNKNOWN
    conditions: list[evolution_loader__RomCondition] = field(default_factory=list)
    steps: int = 0


def evolution_loader___read_u16(data: bytes, offset: int) -> int:
    return struct.unpack_from("<H", data, offset)[0]


def evolution_loader___append_condition(state: _State, operator: str, truth: bool) -> None:
    if not truth:
        operator = evolution_loader__INVERSE_OPERATOR[operator]
    left, right = (state.cmp_left, state.cmp_right)
    if left.kind == "variable" and right.kind == "constant":
        state.conditions.append(
            evolution_loader__RomCondition(str(left.value), operator, int(right.value))
        )
    elif right.kind == "variable" and left.kind == "constant":
        reverse = {"==": "==", "!=": "!=", ">": "<", ">=": "<=", "<": ">", "<=": ">="}[operator]
        state.conditions.append(
            evolution_loader__RomCondition(str(right.value), reverse, int(left.value))
        )


def evolution_loader___branch_info(word: int, pc: int) -> Optional[tuple[str, int]]:
    op0 = word >> 12
    a = word >> 9 & 7
    op1 = word >> 6 & 7
    imm = word & 63
    if a == 7 and op1 in (0, 1) and (op0 <= 14):
        distance = imm * 2
        target = pc + 2 + (distance if op1 == 0 else -distance)
        return (evolution_loader__CC_NAMES[op0], target)
    return None


def evolution_loader___condition_rank(cond: RomCondition) -> tuple[str, int, int]:
    order = {">": 0, ">=": 1, "==": 2, "!=": 3, "<=": 4, "<": 5}
    return (cond.variable, order.get(cond.operator, 9), cond.value)


def evolution_loader___execute_stock_handler(
    data: bytes, profile: Any, start: int, max_steps: int = 700
) -> list[tuple[int, tuple[evolution_loader__RomCondition, ...]]]:
    queue = [evolution_loader___State(start)]
    completed: list[tuple[int, tuple[evolution_loader__RomCondition, ...]]] = []
    seen: set[Any] = set()
    while queue:
        state = queue.pop()
        if state.steps > max_steps or not 0 <= state.pc + 2 <= len(data):
            continue
        key = (
            state.pc,
            tuple(state.regs),
            state.result,
            state.cmp_left,
            state.cmp_right,
            tuple(state.conditions),
        )
        if key in seen:
            continue
        seen.add(key)
        pc = state.pc
        if pc == profile.evolution_result_return:
            if state.result.kind == "constant":
                completed.append(
                    (
                        int(state.result.value),
                        evolution_loader___simplify_conditions(state.conditions),
                    )
                )
            continue
        word = evolution_loader___read_u16(data, pc)
        op0 = word >> 12
        a = word >> 9 & 7
        op1 = word >> 6 & 7
        n = word >> 3 & 7
        b = word & 7
        imm = word & 63
        next_state = copy.deepcopy(state)
        next_state.steps += 1
        next_state.pc = pc + 2
        branch = evolution_loader___branch_info(word, pc)
        if branch:
            cc, target = branch
            if cc == "jmp":
                next_state.pc = target
                queue.append(next_state)
                continue
            operator = evolution_loader__CC_TO_OPERATOR.get(cc)
            if operator:
                taken = copy.deepcopy(next_state)
                taken.pc = target
                evolution_loader___append_condition(taken, operator, True)
                not_taken = copy.deepcopy(next_state)
                evolution_loader___append_condition(not_taken, operator, False)
                queue.extend((not_taken, taken))
                continue
            unknown_taken = copy.deepcopy(next_state)
            unknown_taken.pc = target
            queue.extend((next_state, unknown_taken))
            continue
        if op0 == 15 and op1 in (1, 2):
            if pc + 4 > len(data):
                continue
            second = evolution_loader___read_u16(data, pc + 2)
            target = evolution_loader___far_raw(word, second)
            next_state.pc = pc + 4
            if op1 == 2:
                if target == profile.evolution_result_return:
                    if next_state.result.kind == "constant":
                        completed.append(
                            (
                                int(next_state.result.value),
                                evolution_loader___simplify_conditions(next_state.conditions),
                            )
                        )
                    continue
                next_state.pc = target
                queue.append(next_state)
                continue
            if target == profile.album_visibility_function:
                next_state.regs[1] = evolution_loader___variable("album_visible")
            else:
                next_state.regs[1] = evolution_loader___variable(f"call_{target:06x}")
            queue.append(next_state)
            continue
        if op0 == 15 and op1 == 0:
            queue.append(next_state)
            continue
        if op0 == 13 and op1 == 2 or (op0 == 9 and op1 == 2):
            queue.append(next_state)
            continue
        if op1 == 4 and n in (1, 2, 3) and (op0 in (0, 1, 2, 3, 4, 6, 8, 9, 10, 11, 12, 13)):
            if pc + 4 > len(data):
                continue
            operand16 = evolution_loader___read_u16(data, pc + 2)
            next_state.pc = pc + 4
            if n == 1:
                if op0 == 9:
                    next_state.regs[a] = evolution_loader___constant(operand16)
                elif op0 == 4:
                    next_state.cmp_left = next_state.regs[b]
                    next_state.cmp_right = evolution_loader___constant(operand16)
                else:
                    next_state.regs[a] = evolution_loader___UNKNOWN
            elif n == 2:
                if op0 == 9:
                    next_state.regs[a] = evolution_loader___variable(f"mem_{operand16:04x}")
                elif op0 == 4:
                    next_state.cmp_left = next_state.regs[b]
                    next_state.cmp_right = evolution_loader___variable(f"mem_{operand16:04x}")
                else:
                    next_state.regs[a] = evolution_loader___UNKNOWN
            queue.append(next_state)
            continue
        if op0 in (0, 1, 2, 3, 4, 6, 8, 9, 10, 11, 12, 13):
            if op1 == 1:
                operand = evolution_loader___constant(imm)
            elif op1 == 0:
                operand = evolution_loader___variable(f"bp_{imm}")
            elif op1 == 3:
                register_value = next_state.regs[b]
                if n >= 4:
                    operand = (
                        evolution_loader___variable(f"mem_{int(register_value.value):04x}")
                        if register_value.kind == "constant"
                        else evolution_loader___variable(f"mem_{register_value.value}")
                    )
                else:
                    operand = evolution_loader___variable(f"ind_{b}_{n}")
            elif op1 == 4 and n == 0:
                operand = next_state.regs[b]
            else:
                operand = evolution_loader___UNKNOWN
            if op0 == 9:
                next_state.regs[a] = operand
            elif op0 == 4:
                next_state.cmp_left = next_state.regs[a]
                next_state.cmp_right = operand
            elif op0 == 13:
                if op1 == 0 and imm == 0:
                    next_state.result = next_state.regs[a]
            else:
                next_state.regs[a] = evolution_loader___UNKNOWN
            queue.append(next_state)
            continue
    output: list[tuple[int, tuple[evolution_loader__RomCondition, ...]]] = []
    for item in completed:
        if item not in output:
            output.append(item)
    return output


def evolution_loader___far_raw(first: int, second: int) -> int:
    word_address = (first & 63) << 16 | second
    return (word_address - 2097152) * 2


def evolution_loader___pointer_raw(low: int, high: int) -> int:
    return ((high << 16 | low) - 2097152) * 2


def evolution_loader___simplify_conditions(
    conditions: list[RomCondition],
) -> tuple[evolution_loader__RomCondition, ...]:

    unique: list[evolution_loader__RomCondition] = []
    for cond in conditions:
        if cond not in unique:
            unique.append(cond)
    output: list[evolution_loader__RomCondition] = []
    for variable in dict.fromkeys((c.variable for c in unique)):
        items = [c for c in unique if c.variable == variable]
        equals = [c for c in items if c.operator == "=="]
        not_equals = [c for c in items if c.operator == "!="]
        lowers = [c for c in items if c.operator in (">", ">=")]
        uppers = [c for c in items if c.operator in ("<", "<=")]
        if equals:
            output.append(equals[-1])
            output.extend(not_equals)
            continue
        if lowers:
            output.append(max(lowers, key=lambda c: (c.value, c.operator == ">")))
        if uppers:
            output.append(min(uppers, key=lambda c: (c.value, c.operator == "<")))
        output.extend(not_equals)
    return tuple(sorted(output, key=evolution_loader___condition_rank))


def evolution_loader__attach_paths(
    project: core.Project, data: bytes, layout: RomLayout
) -> list[evolution_loader__RomEvolutionPath]:
    paths = evolution_loader__extract_all_paths(data, layout)
    setattr(project, "rom_evolution_paths", paths)
    setattr(
        project,
        "rom_evolution_parse_report",
        {
            "stock_paths": sum((p.origin == "stock" for p in paths)),
            "custom_paths": sum((p.origin == "custom" for p in paths)),
            "total_paths": len(paths),
        },
    )
    return paths


def evolution_loader__create_project_from_rom(path: Path):
    project, data, images, layout = album_layers__create_project_from_rom(path)
    evolution_loader__attach_paths(project, data, layout)
    return (project, data, images, layout)


def evolution_loader__extract_all_paths(
    data: bytes, layout: RomLayout
) -> list[evolution_loader__RomEvolutionPath]:
    custom = evolution_loader__extract_custom_paths(data, layout)
    stock = evolution_loader__extract_stock_paths(data, layout.profile)
    return custom + stock


def evolution_loader__extract_custom_paths(
    data: bytes, layout: RomLayout
) -> list[evolution_loader__RomEvolutionPath]:
    meta = album_layers__read_meta(data)
    if not meta or "evolution_cave" not in meta:
        return []
    start = int(meta["evolution_cave"])
    if not 0 <= start < len(data) - 16:
        return []
    reverse_branch = {
        int(high): int(op_id) for op_id, high in core__OPERATOR_INVERSE_BRANCH_HIGH.items()
    }
    reverse_address = {
        int(address): int(kind) for kind, address in core__CONDITION_STAT_ADDRESS.items()
    }
    # Godzilla exports retain the table format but relocate condition SRAM.
    # These translated addresses are disjoint from the original condition set.
    reverse_address.update(
        {
            godzilla__map_ram(address): int(kind)
            for kind, address in core__CONDITION_STAT_ADDRESS.items()
        }
    )
    id_to_symbol = {v: k for k, v in evolution_loader__OP_TO_ID.items()}
    paths: list[evolution_loader__RomEvolutionPath] = []
    pc = start
    cmp_word = relocation__cmp16_word(4)
    mov_word = relocation__mov16_word(4)
    hard_end = min(len(data), int(meta.get("evolution_cave_end", start + 131072)))
    while pc + 8 <= hard_end:
        words4 = struct.unpack_from("<4H", data, pc)
        if words4[0] == 65024 and words4[1] == 39180 and (words4[2] == 2086):
            break
        if words4[0] != 38912 or words4[1] != cmp_word:
            break
        source_id = int(words4[2])
        route_start = pc
        pc += 8
        conditions: list[evolution_loader__RomCondition] = []
        while pc + 14 <= hard_end:
            chunk = struct.unpack_from("<7H", data, pc)
            if chunk[0:2] != (65024, 39180) or chunk[3] != 39140 or chunk[4] != cmp_word:
                break
            address = int(chunk[2])
            kind = reverse_address.get(address)
            branch_high = int(chunk[6] >> 8)
            op_id = reverse_branch.get(branch_high)
            if kind is None or op_id is None:
                break
            variable = next(
                (name for name, k in evolution_loader__VARIABLE_TO_KIND.items() if k == kind),
                f"kind_{kind}",
            )
            conditions.append(
                evolution_loader__RomCondition(variable, id_to_symbol[op_id], int(chunk[5]))
            )
            pc += 14
        if pc + 10 > hard_end:
            break
        result_chunk = struct.unpack_from("<5H", data, pc)
        if result_chunk[0] != mov_word or result_chunk[2] != 55296:
            break
        result_id = int(result_chunk[1])
        paths.append(
            evolution_loader__RomEvolutionPath(
                source_id, result_id, tuple(conditions), "custom", route_start
            )
        )
        pc += 10
    return paths


def evolution_loader__extract_stock_paths(
    data: bytes, profile: Any
) -> list[evolution_loader__RomEvolutionPath]:
    table = profile.evolution_result_return + 14
    paths: list[evolution_loader__RomEvolutionPath] = []
    for source_id in range(profile.stock_roster_count):
        entry = table + source_id * 4
        if entry + 4 > len(data):
            break
        low, high = struct.unpack_from("<HH", data, entry)
        target = evolution_loader___pointer_raw(low, high)
        if target & 1 or not 0 <= target < min(len(data), 4194304):
            continue
        decoded = evolution_loader___execute_stock_handler(data, profile, target)
        for result_id, conditions in decoded:
            if 0 <= result_id < evolution_loader__PROJECT_ROSTER_COUNT:
                path = evolution_loader__RomEvolutionPath(
                    source_id, result_id, conditions, "stock", target
                )
                if path not in paths:
                    paths.append(path)
    return paths


def evolution_loader__load_project(path: Path):
    project, data, images, layout = album_layers__load_project(path)
    try:
        evolution_loader__attach_paths(project, data, layout)
    except Exception:
        try:
            obj = json.loads(path.read_text(encoding="utf-8"))
            stored = [
                evolution_loader__RomEvolutionPath.from_dict(x)
                for x in obj.get("rom_evolution_paths", [])
            ]
            setattr(project, "rom_evolution_paths", stored)
            setattr(
                project,
                "rom_evolution_parse_report",
                {
                    "stock_paths": sum((p.origin == "stock" for p in stored)),
                    "custom_paths": sum((p.origin == "custom" for p in stored)),
                    "total_paths": len(stored),
                },
            )
        except Exception:
            setattr(project, "rom_evolution_paths", [])
    return (project, data, images, layout)


def evolution_loader__load_project_any(path: Path):
    obj = json.loads(path.read_text(encoding="utf-8"))
    if obj.get("format") == evolution_loader__PROJECT_FORMAT:
        version = int(obj["profile_version"])
        base = Path(obj.get("base_rom", ""))
        if not base.is_absolute():
            base = (path.parent / base).resolve()
        project, data, images, layout = evolution_loader__create_project_from_rom(base)
        if layout.profile.version != version:
            raise ValueError("프로젝트와 기반 ROM 버전이 다릅니다")
        loaded = [core__DigimonSlot.from_dict(x) for x in obj.get("slots", [])]
        for i, slot in enumerate(loaded[:evolution_loader__PROJECT_ROSTER_COUNT]):
            project.slots[i] = slot
        project.project_path = path
        project.rom_files = {"vanilla": str(base), "profile_version": str(version)}
        stored = [
            evolution_loader__RomEvolutionPath.from_dict(x)
            for x in obj.get("rom_evolution_paths", [])
        ]
        if stored:
            setattr(project, "rom_evolution_paths", stored)
            setattr(
                project, "rom_evolution_parse_report", obj.get("rom_evolution_parse_report", {})
            )
        return (project, data, images, layout)
    return evolution_loader__load_project(path)


def evolution_loader__project_to_dict(
    project: core.Project, profile_version: int
) -> dict[str, Any]:
    obj = album_layers__project_to_dict(project, profile_version)
    obj["format"] = evolution_loader__PROJECT_FORMAT
    obj["app_version"] = evolution_loader__APP_VERSION
    obj["rom_evolution_paths"] = [p.to_dict() for p in getattr(project, "rom_evolution_paths", [])]
    obj["rom_evolution_parse_report"] = getattr(project, "rom_evolution_parse_report", {})
    return obj


def evolution_loader__save_project(project: core.Project, profile_version: int, path: Path) -> None:
    obj = evolution_loader__project_to_dict(project, profile_version)
    base = Path(obj["base_rom"])
    if base.is_absolute():
        try:
            obj["base_rom"] = os.path.relpath(base, path.parent).replace("\\", "/")
        except ValueError:
            pass
    path.write_text(json.dumps(obj, ensure_ascii=False, indent=2), encoding="utf-8")
    project.project_path = path


globals()["universal__APP_VERSION"] = evolution_loader__APP_VERSION
globals()["universal__PROJECT_FORMAT"] = evolution_loader__PROJECT_FORMAT
globals()["universal__create_project_from_rom"] = evolution_loader__create_project_from_rom
globals()["universal__load_universal_project"] = evolution_loader__load_project_any
globals()["universal__save_universal_project"] = evolution_loader__save_project
globals()["universal__build_universal_rom"] = album_layers__build_rom


class evolution_loader__GUI(album_layers__GUI):

    def __init__(self, root: Any, initial_project: Optional[Path] = None) -> None:
        self.stock_evolution_tab = None
        self.stock_path_tree = None
        self.stock_path_summary_var = None
        self.stock_show_all_var = None
        self._visible_stock_paths: list[evolution_loader__RomEvolutionPath] = []
        super().__init__(root, initial_project)
        self._build_rom_evolution_tab()
        self.refresh_rom_evolution_tab()
        self.root.title(self.root.title().replace("\x5611", "\x5612"))


    def _slot_label(self, digimon_id: int) -> str:
        if self.project is not None and 0 <= digimon_id < len(self.project.slots):
            return f"{digimon_id:03d} {self.project.slots[digimon_id].name}"
        return f"{digimon_id:03d}"

    def copy_selected_rom_path(self) -> None:
        from tkinter import messagebox

        if self.project is None or self.stock_path_tree is None:
            return
        selection = self.stock_path_tree.selection()
        if not selection:
            messagebox.showinfo("ROM 진화 경로", "복사할 경로 행을 선택하십시오.", parent=self.root)
            return
        path = self._visible_stock_paths[int(selection[0])]
        if path.result_id != self.current_id:
            self.select_slot(path.result_id)
        slot = self.project.slots[path.result_id]
        converted: list[core__EvolutionCondition] = []
        omitted: list[evolution_loader__RomCondition] = []
        for cond in path.conditions:
            kind = evolution_loader__VARIABLE_TO_KIND.get(cond.variable)
            operator = evolution_loader__OP_TO_ID.get(cond.operator)
            if kind is None or operator is None:
                omitted.append(cond)
                continue
            converted.append(core__EvolutionCondition(kind, operator, cond.value))
        if not converted and (not omitted):
            converted = [core__EvolutionCondition(0, 5, 0)]
        slot.evolution.enabled = True
        slot.evolution.source_id = path.source_id
        slot.evolution.conditions = converted
        self.load_slot(path.result_id)
        self.dirty = True
        origin = "사용자 확장" if path.origin == "custom" else "원본"
        note = ""
        if omitted:
            note = (
                "\n\n다음 원본 전용 조건은 사용자 조건 형식으로 변환하지 않았습니다:\n- "
                + "\n- ".join((evolution_loader__condition_text(c) for c in omitted))
            )
        messagebox.showinfo(
            "진화 경로 복사 완료",
            f"{origin} 경로를 사용자 진화 탭으로 복사했습니다.\n{self._slot_label(path.source_id)} → {self._slot_label(path.result_id)}\n조건: {evolution_loader__path_condition_text(path)}{note}",
            parent=self.root,
        )
        self.notebook.select(self.evolution_tab)


    def show_current_result_paths(self) -> None:
        if self.stock_show_all_var is not None:
            self.stock_show_all_var.set(False)
        self.refresh_rom_evolution_tab()


import argparse
import copy
import json
import os
import struct
import sys
import traceback
from dataclasses import asdict
from pathlib import Path
from typing import Any, Optional

evolution_merge__APP_VERSION = "13.0.0"
evolution_merge__PROJECT_FORMAT = "PenCUniversalProject\x5613"
evolution_merge__PROJECT_ROSTER_COUNT = album_layers__PROJECT_ROSTER_COUNT
evolution_merge__STANDARD_ROSTER_COUNT = album_layers__STANDARD_ROSTER_COUNT
evolution_merge__EXTENDED_ROSTER_COUNT = album_layers__EXTENDED_ROSTER_COUNT
evolution_merge__STOCK_ROM_SIZE = album_layers__STOCK_ROM_SIZE
evolution_merge__EXTENDED_ROM_SIZE = album_layers__EXTENDED_ROM_SIZE
evolution_merge__FLASH_BANK1 = album_layers__FLASH_BANK1
evolution_merge__SAVE_TAIL_START = album_layers__SAVE_TAIL_START
evolution_merge__SAVE_TAIL_END = album_layers__SAVE_TAIL_END
evolution_merge__METADATA_OFFSET = album_layers__METADATA_OFFSET
evolution_merge__METADATA_SIZE = album_layers__METADATA_SIZE
evolution_merge__METADATA_MAGIC = album_layers__METADATA_MAGIC
evolution_merge__ACQUIRED_RAM_BASE = album_layers__ACQUIRED_RAM_BASE
evolution_merge__VISIBLE_RAM_BASE = album_layers__VISIBLE_RAM_BASE
evolution_merge__PROFILES = album_layers__PROFILES
evolution_merge__RomLayout = album_layers__RomLayout
evolution_merge__STOCK_ALBUM_NUMBER_HEADS = {
    0: ((22718 - 48, bytes.fromhex("4B 96 08 09")), (22718, bytes.fromhex("4C 96 08 09"))),
    1: ((22352 - 48, bytes.fromhex("4B 96 08 09")), (22352, bytes.fromhex("4C 96 08 09"))),
    2: ((22268 - 48, bytes.fromhex("4B 96 08 09")), (22268, bytes.fromhex("4C 96 08 09"))),
    3: ((22292 - 48, bytes.fromhex("4B 96 08 09")), (22292, bytes.fromhex("4C 96 08 09"))),
    4: ((22602 - 48, bytes.fromhex("4B 96 08 09")), (22602, bytes.fromhex("4C 96 08 09"))),
    5: ((22620 - 48, bytes.fromhex("4B 96 08 09")), (22620, bytes.fromhex("4C 96 08 09"))),
}


def evolution_merge__restore_stock_album_number(out: bytearray, profile: Any) -> dict[str, Any]:
    restored = []
    for off, blob in evolution_merge__STOCK_ALBUM_NUMBER_HEADS[profile.version]:
        before = bytes(out[off : off + len(blob)])
        out[off : off + len(blob)] = blob
        restored.append({"offset": off, "before": before.hex(), "after": blob.hex()})
    return {
        "digits": 2,
        "policy": "stock two-digit album routine restored; no number cave/hook",
        "restored_sites": restored,
        "known_display_above_99": "100..109 show F0..F9 and 110..114 show o0..o4",
    }


def evolution_merge___convert_rom_conditions(path: hist_af.RomEvolutionPath):
    converted: list[core__EvolutionCondition] = []
    omitted: list[evolution_loader__RomCondition] = []
    for condition in path.conditions:
        kind = evolution_loader__VARIABLE_TO_KIND.get(condition.variable)
        operator = evolution_loader__OP_TO_ID.get(condition.operator)
        if kind is None or operator is None:
            omitted.append(condition)
        else:
            converted.append(core__EvolutionCondition(kind, operator, condition.value))
    if not converted and (not omitted):
        converted = [core__EvolutionCondition(0, 5, 0)]
    return (converted, omitted)


def evolution_merge__build_rom(
    project: core.Project, source: bytes, layout: RomLayout, target: int, extended: bool
):
    expected = (
        evolution_merge__EXTENDED_ROSTER_COUNT
        if extended
        else evolution_merge__STANDARD_ROSTER_COUNT
    )
    if target != expected:
        raise ValueError(f"\x5613 {('16MB' if extended else '8MB')} 저장 수는 {expected}마리입니다")
    profile = layout.profile
    table = album_layers__table_layout(profile, target)
    album_layers__activate(profile, target, table)
    build_project = core__Project(
        slots=copy.deepcopy(project.slots[:target]), rom_files=dict(project.rom_files)
    )
    core__validate_project(build_project)
    source_images = album_layers__read_images_flexible(
        source, layout.image_count, layout.size_table
    )
    out = bytearray(
        b"\xff"
        * (evolution_merge__EXTENDED_ROM_SIZE if extended else evolution_merge__STOCK_ROM_SIZE)
    )
    out[:evolution_merge__STOCK_ROM_SIZE] = source[:evolution_merge__STOCK_ROM_SIZE]
    original_save_tail = bytes(
        source[evolution_merge__SAVE_TAIL_START:evolution_merge__SAVE_TAIL_END]
    )
    out[evolution_merge__METADATA_OFFSET:relocation__TABLE_AREA_END] = b"\x00" * (
        relocation__TABLE_AREA_END - evolution_merge__METADATA_OFFSET
    )
    final_images = list(source_images[: profile.stock_image_count])
    stat_rows: list[list[int]] = []
    for slot in build_project.slots:
        stats = list(slot.stats)
        if slot.digimon_id < profile.stock_roster_count:
            start = 240 + slot.digimon_id * 12
            stats[0] = start
            if slot.digimon_id < layout.roster_count:
                stats[core__ALBUM_ORDER_STAT_INDEX] = core__read_stat_words(
                    source, slot.digimon_id, layout.stat_table
                )[core__ALBUM_ORDER_STAT_INDEX]
            for frame_index, ref in enumerate(slot.frames):
                final_images[start + frame_index] = core__resolve_frame(ref, source_images)
        else:
            start = profile.stock_image_count + (slot.digimon_id - profile.stock_roster_count) * 12
            stats[0] = start
            stats[core__ALBUM_ORDER_STAT_INDEX] = slot.digimon_id
            final_images.extend((core__resolve_frame(ref, source_images) for ref in slot.frames))
        stat_rows.append(stats)
    if len(final_images) != table["image_count"]:
        raise AssertionError("image count")
    image_report = album_layers__write_images_safe(out, final_images, extended)
    for image_index, image in enumerate(final_images):
        core__write_u16(out, table["size"] + image_index * 4, image.width)
        core__write_u16(out, table["size"] + image_index * 4 + 2, image.height)
    for slot, stats in zip(build_project.slots, stat_rows):
        core__write_stat_words(out, slot.digimon_id, stats, table["stat"])
    core__write_u16(out, profile.stat_lookup_site, table["stat"] // 2 & 65535)
    relocation__patch_size_table_sites(out, profile, table["size"])
    for offset in profile.image_max_offsets:
        core__write_u16(out, offset, table["image_count"] - 1)
    cave = relocation__Cave(out)
    ram_report = album_layers__patch_album_ram_safe(out, source, target, cave)
    for offset in profile.roster_max_offsets:
        relocation__patch_wide_compare(out, offset, target - 1, cave, source)
    album_visibility = relocation__patch_album_visibility(out, source, profile, target - 1, cave)
    album_cursor = relocation__patch_album_cursor(out, profile, target, cave)
    album_number = evolution_merge__restore_stock_album_number(out, profile)
    evolution_blob, evolution_report = relocation__build_evolution_wide(
        build_project.slots, profile, table
    )
    out[table["evo"] : table["evo_end"]] = b"\x00" * (table["evo_end"] - table["evo"])
    out[table["evo"] : table["evo"] + len(evolution_blob)] = evolution_blob
    core__write_far_goto(out, profile.evolution_hook, table["evo"])
    relocation__patch_jogress(out, source, layout, target, table, cave)
    extra = {
        **ram_report,
        **album_visibility,
        "album_cursor": album_cursor,
        "album_number": album_number,
        "album_number_patch_disabled": True,
        "image_pointer_policy": "bank1-positive-plus-wrapped-bank0",
    }
    evolution_merge__write_meta(
        out,
        profile,
        target,
        table,
        (
            "extended16-safe-stock-album-number"
            if extended
            else "standard8-bank1-bank0-stock-album-number"
        ),
        extra,
    )
    if out[evolution_merge__SAVE_TAIL_START:evolution_merge__SAVE_TAIL_END] != original_save_tail:
        raise AssertionError("save tail changed")
    decoded_addresses: list[int] = []
    for image_index in range(table["image_count"]):
        relative = core__read_u32(out, evolution_merge__FLASH_BANK1 + image_index * 4)
        width = core__read_u16(out, table["size"] + image_index * 4)
        height = core__read_u16(out, table["size"] + image_index * 4 + 2)
        if relative & 2147483648:
            address = evolution_merge__FLASH_BANK1 + (relative & 2147483647)
            decoded_addresses.append(address)
            if not evolution_merge__FLASH_BANK1 <= address + 4 <= evolution_merge__SAVE_TAIL_START:
                raise AssertionError(
                    f"invalid compressed image pointer: {image_index} -> {address:#x}"
                )
            payload_words = core__read_u16(out, address)
            output_words = core__read_u16(out, address + 2)
            if output_words != width * height:
                raise AssertionError(f"compressed image output size mismatch: {image_index}")
            if address + 4 + payload_words * 2 > evolution_merge__SAVE_TAIL_START:
                raise AssertionError(f"compressed image crosses save tail: {image_index}")
            continue
        address = relocation__decode_image_address(relative)
        decoded_addresses.append(address)
        in_bank1 = evolution_merge__FLASH_BANK1 <= address < evolution_merge__SAVE_TAIL_START
        in_bank0 = relocation__BANK0_IMAGE_START <= address < evolution_merge__FLASH_BANK1
        in_upper16 = extended and evolution_merge__SAVE_TAIL_END <= address < len(out)
        if not (in_bank1 or in_bank0 or in_upper16):
            raise AssertionError(f"invalid image pointer: {image_index} -> {address:#x}")
        end = address + width * height * 2
        if in_bank0 and end > evolution_merge__FLASH_BANK1:
            raise AssertionError(f"bank0 image crosses bank boundary: {image_index}")
        if in_bank1 and end > evolution_merge__SAVE_TAIL_START:
            raise AssertionError(f"bank1 image crosses save tail: {image_index}")
        if in_upper16 and end > len(out):
            raise AssertionError(f"upper16 image outside ROM: {image_index}")
    report = {
        "format": "PenC Universal Editor \x5613 build report",
        "app_version": evolution_merge__APP_VERSION,
        "profile": profile.label,
        "mode": f"{('16MiB' if extended else '8MiB')}/{target}",
        "rom_size": len(out),
        "roster_count": target,
        "max_id": target - 1,
        "total_image_count": table["image_count"],
        "tables": table,
        "images": image_report,
        "album_number": album_number,
        "album_entry_policy": "\x569-\x5612 three-digit hooks removed; original two-digit draw flow restored. Wide album visibility/cursor and \x5610 sleep-safe RAM relocation remain.",
        "album_ram": ram_report,
        "evolution": evolution_report,
        "save_tail_preserved": True,
        "minimum_image_address": min(decoded_addresses),
        "maximum_image_address": max(decoded_addresses),
        "source_sha256": core__sha256(source),
        "output_sha256": core__sha256(out),
        "hardware_test_priority": [
            "album menu enters without reset",
            "sleep/wake remains functional",
            "album position 5 hidden-slot transition",
            "100+ numbers remain legacy glyphs until a hardware-safe renderer is proven",
        ],
    }
    return (bytes(out), report)


def evolution_merge__create_project_from_rom(path: Path):
    data = path.read_bytes()
    layout = evolution_merge__identify_layout(data)
    album_layers__activate(layout.profile, evolution_merge__PROJECT_ROSTER_COUNT)
    images = album_layers__read_images_flexible(data, layout.image_count, layout.size_table)
    slots: list[core__DigimonSlot] = []
    current = min(layout.roster_count, evolution_merge__PROJECT_ROSTER_COUNT)
    for did in range(current):
        stats = core__read_stat_words(data, did, layout.stat_table)
        start = stats[0]
        frames = [core__FrameRef("base", start + i) for i in range(12)]
        name = (
            core__DEFAULT_DISPLAY_NAMES[did]
            if layout.profile.version == 1 and did < len(core__DEFAULT_DISPLAY_NAMES)
            else f"VP{layout.profile.version} ID {did:03d}"
        )
        slots.append(core__DigimonSlot(did, name, stats, frames, core__EvolutionRoute()))
    template_id = max(0, current - 1)
    template_stats = list(slots[template_id].stats)
    template_frames = copy.deepcopy(slots[template_id].frames)
    for did in range(current, evolution_merge__PROJECT_ROSTER_COUNT):
        stats = list(template_stats)
        stats[core__ALBUM_ORDER_STAT_INDEX] = did
        stats[core__ALBUM_VISIBLE_STAT_INDEX] = 1
        slots.append(
            core__DigimonSlot(
                did,
                f"추가 슬롯 {did:03d}",
                stats,
                copy.deepcopy(template_frames),
                core__EvolutionRoute(False, 0, []),
            )
        )
    project = core__Project(
        slots=slots,
        rom_files={"vanilla": str(path.resolve()), "profile_version": str(layout.profile.version)},
    )
    evolution_loader__attach_paths(project, data, layout)
    return (project, data, images, layout)


def evolution_merge__identify_layout(data: bytes) -> evolution_merge__RomLayout:
    if len(data) not in (evolution_merge__STOCK_ROM_SIZE, evolution_merge__EXTENDED_ROM_SIZE):
        raise ValueError("8 MiB 또는 16 MiB ROM만 지원합니다")
    meta = evolution_merge__read_meta(data)
    if meta and meta.get("format") in (
        evolution_merge__PROJECT_FORMAT,
        evolution_loader__PROJECT_FORMAT,
        album_layers__PROJECT_FORMAT,        "PenCUniversalProject\x5610",
        "PenCUniversalProject\x569",
        relocation__PROJECT_FORMAT,
        "PenCUniversalProject\x567",
        universal__PROJECT_FORMAT,
    ):
        profile = evolution_merge__PROFILES[int(meta["profile_version"])]
        return evolution_merge__RomLayout(
            profile,
            int(meta["roster_count"]),
            int(meta["image_count"]),
            int(meta["stat_table"]),
            int(meta["size_table"]),
            str(meta.get("mode", "patched")),
        )
    return album_layers__identify_layout(data)


def evolution_merge__load_project(path: Path):
    obj = json.loads(path.read_text(encoding="utf-8"))
    if obj.get("format") == evolution_merge__PROJECT_FORMAT:
        version = int(obj["profile_version"])
        base = Path(obj.get("base_rom", ""))
        if not base.is_absolute():
            base = (path.parent / base).resolve()
        project, data, images, layout = evolution_merge__create_project_from_rom(base)
        if layout.profile.version != version:
            raise ValueError("프로젝트와 기반 ROM 버전이 다릅니다")
        loaded = [core__DigimonSlot.from_dict(x) for x in obj.get("slots", [])]
        for index, slot in enumerate(loaded[:evolution_merge__PROJECT_ROSTER_COUNT]):
            project.slots[index] = slot
        project.project_path = path
        project.rom_files = {"vanilla": str(base), "profile_version": str(version)}
        stored = [
            evolution_loader__RomEvolutionPath.from_dict(x)
            for x in obj.get("rom_evolution_paths", [])
        ]
        if stored:
            setattr(project, "rom_evolution_paths", stored)
            setattr(
                project, "rom_evolution_parse_report", obj.get("rom_evolution_parse_report", {})
            )
        return (project, data, images, layout)
    return evolution_loader__load_project_any(path)


def evolution_merge__project_to_dict(project: core.Project, profile_version: int) -> dict[str, Any]:
    obj = album_layers__project_to_dict(project, profile_version)
    obj["format"] = evolution_merge__PROJECT_FORMAT
    obj["app_version"] = evolution_merge__APP_VERSION
    obj["rom_evolution_paths"] = [
        path.to_dict() for path in getattr(project, "rom_evolution_paths", [])
    ]
    obj["rom_evolution_parse_report"] = getattr(project, "rom_evolution_parse_report", {})
    return obj


def evolution_merge__read_meta(data: bytes) -> Optional[dict[str, Any]]:
    return album_layers__read_meta(data)


def evolution_merge__save_project(project: core.Project, profile_version: int, path: Path) -> None:
    obj = evolution_merge__project_to_dict(project, profile_version)
    base = Path(obj["base_rom"])
    if base.is_absolute():
        try:
            obj["base_rom"] = os.path.relpath(base, path.parent).replace("\\", "/")
        except ValueError:
            pass
    path.write_text(json.dumps(obj, ensure_ascii=False, indent=2), encoding="utf-8")
    project.project_path = path


def evolution_merge__write_meta(
    out: bytearray,
    profile: Any,
    count: int,
    table: dict[str, int],
    mode: str,
    extra: dict[str, Any],
) -> None:
    payload = {
        "format": evolution_merge__PROJECT_FORMAT,
        "app_version": evolution_merge__APP_VERSION,
        "profile_version": profile.version,
        "roster_count": count,
        "image_count": table["image_count"],
        "stat_table": table["stat"],
        "size_table": table["size"],
        "jogress_pointer_table": table["jog_ptr"],
        "jogress_rows": table["jog_rows"],
        "evolution_cave": table["evo"],
        "evolution_cave_end": table["evo_end"],
        "mode": mode,
        "acquired_ram_base": evolution_merge__ACQUIRED_RAM_BASE,
        "visible_ram_base": evolution_merge__VISIBLE_RAM_BASE,
        **extra,
    }
    encoded = json.dumps(payload, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
    if len(encoded) + 12 > evolution_merge__METADATA_SIZE:
        raise ValueError("메타데이터 공간 초과")
    out[
        evolution_merge__METADATA_OFFSET : evolution_merge__METADATA_OFFSET
        + evolution_merge__METADATA_SIZE
    ] = (b"\x00" * evolution_merge__METADATA_SIZE)
    out[evolution_merge__METADATA_OFFSET : evolution_merge__METADATA_OFFSET + 8] = (
        evolution_merge__METADATA_MAGIC
    )
    core__write_u32(out, evolution_merge__METADATA_OFFSET + 8, len(encoded))
    out[
        evolution_merge__METADATA_OFFSET + 12 : evolution_merge__METADATA_OFFSET + 12 + len(encoded)
    ] = encoded


globals()["universal__APP_VERSION"] = evolution_merge__APP_VERSION
globals()["universal__PROJECT_FORMAT"] = evolution_merge__PROJECT_FORMAT
globals()["universal__PROJECT_ROSTER_COUNT"] = evolution_merge__PROJECT_ROSTER_COUNT
globals()["universal__STANDARD_ROSTER_COUNT"] = evolution_merge__STANDARD_ROSTER_COUNT
globals()["universal__EXTENDED_ROSTER_COUNT"] = evolution_merge__EXTENDED_ROSTER_COUNT
globals()["universal__activate"] = album_layers__activate
globals()["universal__identify_layout"] = evolution_merge__identify_layout
globals()["universal__read_images_flexible"] = album_layers__read_images_flexible
globals()["universal__create_project_from_rom"] = evolution_merge__create_project_from_rom
globals()["universal__save_universal_project"] = evolution_merge__save_project
globals()["universal__load_universal_project"] = evolution_merge__load_project
globals()["universal__build_universal_rom"] = evolution_merge__build_rom


class evolution_merge__GUI(evolution_loader__GUI):

    def __init__(self, root: Any, initial_project: Optional[Path] = None) -> None:
        self.route_selector = None
        self.route_selector_var = None
        self.evo_enable_check = None
        self.route_info_var = None
        self._route_options: list[tuple[str, Optional[evolution_loader__RomEvolutionPath]]] = []
        self._viewing_rom_path: Optional[evolution_loader__RomEvolutionPath] = None
        self._route_loading = False
        super().__init__(root, initial_project)
        self._install_route_selector()
        self._refresh_route_selector(prefer_existing=True)
        self.root.title(self.root.title().replace("\x5612", "\x5613"))

    def _build_rom_evolution_tab(self) -> None:
        self.stock_evolution_tab = None

    def _ensure_editable_route(self) -> None:
        if self._viewing_rom_path is not None:
            self.copy_viewed_route_to_editor(show_message=False)


    def _on_route_selected(self, _event: Any = None) -> None:
        if self._route_loading or self.route_selector is None:
            return
        self.commit_current_slot()
        self._show_route_option(self.route_selector.current())

    def _on_source_changed(self, _event: Any = None) -> None:
        self._ensure_editable_route()
        self.commit_current_slot()


    def _path_label(self, path: hist_af.RomEvolutionPath, index: int, total: int) -> str:
        origin = "ROM 사용자" if path.origin == "custom" else "원본"
        condition = evolution_loader__path_condition_text(path)
        if len(condition) > 55:
            condition = condition[:52] + "..."
        return f"{origin} 경로 {index}/{total} | {path.source_id:03d} → {path.result_id:03d} | {condition}"

    def _paths_for_current_result(self) -> list[evolution_loader__RomEvolutionPath]:
        if self.project is None:
            return []
        return [
            path
            for path in getattr(self.project, "rom_evolution_paths", [])
            if path.result_id == self.current_id
        ]


    def _show_route_option(self, index: int) -> None:
        if self.project is None or not 0 <= index < len(self._route_options):
            return
        mode, path = self._route_options[index]
        self._route_loading = True
        try:
            if mode == "editor" or path is None:
                self._viewing_rom_path = None
                slot = self.project.slots[self.current_id]
                choices = list(self.evo_source_combo["values"])
                source_id = min(
                    max(slot.evolution.source_id, 0), len(choices) - 1 if choices else 0
                )
                self.evo_source_var.set(choices[source_id] if choices else f"{source_id:03d}")
                self.evo_enabled_var.set(slot.evolution.enabled)
                if self.evo_enable_check is not None:
                    self.evo_enable_check.configure(state="normal")
                self.route_info_var.set(
                    "사용자 편집 경로입니다. 조건 변경 내용은 ROM 생성 시 기본 진화 판정보다 먼저 검사됩니다."
                )
            else:
                self._viewing_rom_path = path
                choices = list(self.evo_source_combo["values"])
                source_id = min(max(path.source_id, 0), len(choices) - 1 if choices else 0)
                self.evo_source_var.set(choices[source_id] if choices else f"{source_id:03d}")
                self.evo_enabled_var.set(True)
                if self.evo_enable_check is not None:
                    self.evo_enable_check.configure(state="disabled")
                unsupported = [
                    c
                    for c in path.conditions
                    if c.variable not in evolution_loader__VARIABLE_TO_KIND
                ]
                note = ""
                if unsupported:
                    note = " | 원본 전용 조건 포함: " + ", ".join(
                        (evolution_loader__condition_text(c) for c in unsupported)
                    )
                self.route_info_var.set(
                    f"{('ROM 사용자' if path.origin == 'custom' else '원본')} 경로를 읽기 상태로 표시 중입니다. 조건 추가·수정·삭제를 누르면 이 경로를 사용자 편집 경로로 자동 복사합니다."
                    + note
                )
            self.evo_result_var.set(
                f"→ 결과: {self.current_id:03d} {self.project.slots[self.current_id].name} | 기존 경로 {len(self._paths_for_current_result())}개"
            )
            self.refresh_conditions()
        finally:
            self._route_loading = False

    def add_condition(self) -> None:
        self._ensure_editable_route()
        return super().add_condition()

    def commit_current_slot(self) -> None:
        if self._route_loading or self.project is None:
            return
        if self._viewing_rom_path is None:
            return super().commit_current_slot()
        slot = self.project.slots[self.current_id]
        shown_source = self.evo_source_var.get()
        shown_enabled = bool(self.evo_enabled_var.get())
        choices = list(self.evo_source_combo["values"])
        editor_source = min(max(slot.evolution.source_id, 0), len(choices) - 1 if choices else 0)
        try:
            self.evo_source_var.set(choices[editor_source] if choices else f"{editor_source:03d}")
            self.evo_enabled_var.set(slot.evolution.enabled)
            self._viewing_rom_path, saved_path = (None, self._viewing_rom_path)
            try:
                album_layers__GUI.commit_current_slot(self)
            finally:
                self._viewing_rom_path = saved_path
        finally:
            self.evo_source_var.set(shown_source)
            self.evo_enabled_var.set(shown_enabled)

    def copy_viewed_route_to_editor(self, show_message: bool = True) -> bool:
        if self.project is None or self._viewing_rom_path is None:
            return False
        from tkinter import messagebox

        path = self._viewing_rom_path
        converted, omitted = evolution_merge___convert_rom_conditions(path)
        slot = self.project.slots[self.current_id]
        slot.evolution.enabled = True
        slot.evolution.source_id = path.source_id
        slot.evolution.conditions = converted
        self._viewing_rom_path = None
        self.dirty = True
        self._refresh_route_selector(prefer_existing=False)
        if show_message:
            text = f"{path.source_id:03d} → {path.result_id:03d} 경로를 사용자 편집 경로로 복사했습니다."
            if omitted:
                text += "\n\n다음 원본 전용 조건은 표시만 유지되고 사용자 코드에는 복사되지 않습니다:\n- "
                text += "\n- ".join((evolution_loader__condition_text(c) for c in omitted))
            messagebox.showinfo("진화 경로 복사", text, parent=self.root)
        return True

    def delete_condition(self) -> None:
        self._ensure_editable_route()
        return super().delete_condition()

    def edit_condition(self) -> None:
        self._ensure_editable_route()
        return super().edit_condition()


    def move_condition(self, direction: int) -> None:
        self._ensure_editable_route()
        return super().move_condition(direction)


    def refresh_conditions(self) -> None:
        if self.condition_tree is None or self.project is None:
            return
        if self._viewing_rom_path is None:
            return super().refresh_conditions()
        for item in self.condition_tree.get_children():
            self.condition_tree.delete(item)
        conditions = self._viewing_rom_path.conditions
        if not conditions:
            self.condition_tree.insert("", "end", iid="0", values=(1, "항상", "-", "-"))
        else:
            for index, condition in enumerate(conditions):
                self.condition_tree.insert(
                    "",
                    "end",
                    iid=str(index),
                    values=(
                        index + 1,
                        evolution_loader__VARIABLE_LABELS.get(
                            condition.variable, condition.variable
                        ),
                        condition.operator,
                        condition.value,
                    ),
                )
        self.update_capacity()

    def refresh_rom_evolution_tab(self) -> None:
        return

    def set_always_condition(self) -> None:
        self._ensure_editable_route()
        return super().set_always_condition()


import argparse
import copy
import json
import os
import struct
import sys
import traceback
from pathlib import Path
from typing import Any, Optional

evolution_ui__APP_VERSION = "14.0.0"
evolution_ui__PROJECT_FORMAT = "PenCUniversalProject\x5614"
evolution_ui__PROJECT_ROSTER_COUNT = evolution_merge__PROJECT_ROSTER_COUNT
evolution_ui__EXTENDED_ROSTER_COUNT = evolution_merge__EXTENDED_ROSTER_COUNT
evolution_ui__METADATA_OFFSET = evolution_merge__METADATA_OFFSET
evolution_ui__METADATA_SIZE = evolution_merge__METADATA_SIZE
evolution_ui__METADATA_MAGIC = evolution_merge__METADATA_MAGIC


def evolution_ui__read_meta(data: bytes) -> Optional[dict[str, Any]]:
    return evolution_merge__read_meta(data)


def evolution_ui___hundreds_words(continuation: int, transparent_image: int) -> list[int]:

    w: list[int] = []
    w += evolution_ui___load_album_number_words()
    w += [relocation__cmp16_word(4), 100]
    b_lt_100 = len(w)
    w.append(0)
    w += [relocation__cmp16_word(4), 200]
    b_lt_200 = len(w)
    w.append(0)
    w += [relocation__mov16_word(3), 149]
    j_end_2 = len(w)
    w.append(0)
    one_index = len(w)
    w += [relocation__mov16_word(3), 148]
    j_end_1 = len(w)
    w.append(0)
    zero_index = len(w)
    w += [relocation__mov16_word(3), transparent_image]
    end_index = len(w)
    w += list(core__far_goto_words(continuation))
    w[b_lt_100] = relocation__local_branch(0, zero_index - (b_lt_100 + 1))
    w[b_lt_200] = relocation__local_branch(0, one_index - (b_lt_200 + 1))
    w[j_end_2] = relocation__local_branch(14, end_index - (j_end_2 + 1))
    w[j_end_1] = relocation__local_branch(14, end_index - (j_end_1 + 1))
    return w


def evolution_ui___load_album_number_words() -> list[int]:
    return [65024, 39180, 2154, 39140, 2113]


def evolution_ui___next_cave_offset(out: bytearray) -> int:
    start, end = (relocation__PATCH_CAVE_START, relocation__PATCH_CAVE_END)
    last = start - 1
    for index in range(start, end):
        if out[index] != 0:
            last = index
    offset = last + 2 & ~1
    if offset < start:
        offset = start
    return offset


def evolution_ui___rewrite_metadata(out: bytearray, updates: dict[str, Any]) -> dict[str, Any]:
    meta = evolution_ui__read_meta(bytes(out)) or {}
    meta.update(updates)
    meta["format"] = evolution_ui__PROJECT_FORMAT
    meta["app_version"] = evolution_ui__APP_VERSION
    encoded = json.dumps(meta, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
    if len(encoded) + 12 > evolution_ui__METADATA_SIZE:
        raise ValueError("\x5614 메타데이터 공간 초과")
    out[
        evolution_ui__METADATA_OFFSET : evolution_ui__METADATA_OFFSET + evolution_ui__METADATA_SIZE
    ] = (b"\x00" * evolution_ui__METADATA_SIZE)
    out[evolution_ui__METADATA_OFFSET : evolution_ui__METADATA_OFFSET + 8] = (
        evolution_ui__METADATA_MAGIC
    )
    core__write_u32(out, evolution_ui__METADATA_OFFSET + 8, len(encoded))
    out[evolution_ui__METADATA_OFFSET + 12 : evolution_ui__METADATA_OFFSET + 12 + len(encoded)] = (
        encoded
    )
    return meta


def evolution_ui___tens_mod10_words(continuation: int) -> list[int]:

    w: list[int] = [66, 38913, 38474, 54920, 55432]
    w += list(universal___call_words_for_raw(49746))
    w += [66, 1801, 147]
    w += list(core__far_goto_words(continuation))
    return w


def evolution_ui___widen_album_visibility_boundary(
    out: bytearray, meta: dict[str, Any], target: int
) -> dict[str, Any]:
    impl = int(meta["album_visibility_impl"])
    needle = struct.pack("<HH", relocation__cmp16_word(4), target - 1)
    region = bytes(out[impl : impl + 144])
    matches: list[int] = []
    start = 0
    while True:
        found = region.find(needle, start)
        if found < 0:
            break
        matches.append(found)
        start = found + 2
    if len(matches) != 1:
        raise ValueError(f"앨범 표시 상한 비교 위치를 하나로 특정하지 못했습니다: {matches}")
    value_offset = impl + matches[0] + 2
    core__write_u16(out, value_offset, target)
    return {
        "album_visibility_guard_value": target,
        "album_last_valid_id": target - 1,
        "album_boundary_policy": "visibility order guard has one-value margin; cursor/roster remain exact",
        "album_visibility_guard_offset": value_offset,
    }


def evolution_ui__build_rom(
    project: core.Project, source: bytes, layout: RomLayout, target: int, extended: bool
):
    blob, report = evolution_merge__build_rom(project, source, layout, target, extended)
    out = bytearray(blob)
    old_meta = evolution_ui__read_meta(blob) or {}
    boundary = evolution_ui___widen_album_visibility_boundary(out, old_meta, target)
    number = evolution_ui__patch_album_number_minimal(out, layout.profile)
    meta = evolution_ui___rewrite_metadata(
        out,
        {
            "mode": (
                "extended16-\x7614-minimal-3digit"
                if extended
                else "standard8-\x7614-minimal-3digit"
            ),
            "album_number": number,
            "album_number_patch_disabled": False,
            **boundary,
        },
    )
    report = dict(report)
    report.update(
        {
            "format": "PenC Universal Editor \x5614 build report",
            "app_version": evolution_ui__APP_VERSION,
            "album_number": number,
            "album_visibility_boundary": boundary,
            "album_entry_policy": "\x5613 stable stock layer flow retained. Only layer-11 image argument and tens quotient post-processing are hooked; no display layer is created again.",
            "output_sha256": core__sha256(out),
            "metadata": meta,
        }
    )
    report["hardware_test_priority"] = [
        "album enters without reset",
        "098 -> 099 -> 100 -> 101 renders as decimal",
        f"last slot ID {target - 1} appears at number {target:03d}",
        "sleep/wake remains functional",
    ]
    return (bytes(out), report)


def evolution_ui__create_project_from_rom(path: Path):
    return evolution_merge__create_project_from_rom(path)


def evolution_ui__load_project(path: Path):
    obj = json.loads(path.read_text(encoding="utf-8"))
    if obj.get("format") == evolution_ui__PROJECT_FORMAT:
        obj13 = dict(obj)
        obj13["format"] = evolution_merge__PROJECT_FORMAT
        temp = path.with_suffix(path.suffix + ".\x7613load.tmp")
        try:
            temp.write_text(json.dumps(obj13, ensure_ascii=False, indent=2), encoding="utf-8")
            result = evolution_merge__load_project(temp)
            result[0].project_path = path
            return result
        finally:
            try:
                temp.unlink()
            except OSError:
                pass
    return evolution_merge__load_project(path)


def evolution_ui__patch_album_number_minimal(out: bytearray, profile: Any) -> dict[str, Any]:
    tens_hook, _return_raw, _draw_raw = album_layers__ALBUM_NUMBER_SITES[profile.version]
    hundreds_hook = tens_hook - 40
    hundreds_continue = hundreds_hook + 4
    tens_mod_hook = tens_hook + 28
    tens_mod_continue = tens_hook + 34
    if core__read_u16(out, hundreds_hook) != relocation__mov16_word(3):
        raise ValueError(f"백의 자리 훅 원본 패턴 불일치 @{hundreds_hook:#x}")
    transparent_image = core__read_u16(out, hundreds_hook + 2)
    if not 512 <= transparent_image <= 1023:
        raise ValueError(
            f"투명 이미지 원본 값 범위 불일치 @{hundreds_hook + 2:#x}: {transparent_image:#x}"
        )
    if core__read_u16(out, tens_mod_hook) != 66 or core__read_u16(out, tens_mod_hook + 2) != 1801:
        raise ValueError(f"십의 자리 후처리 원본 패턴 불일치 @{tens_mod_hook:#x}")
    cave = relocation__Cave(out)
    cave.cur = evolution_ui___next_cave_offset(out)
    hundreds = evolution_ui___hundreds_words(hundreds_continue, transparent_image)
    hundreds_impl = cave.put(hundreds)
    core__write_far_goto(out, hundreds_hook, hundreds_impl)
    tens = evolution_ui___tens_mod10_words(tens_mod_continue)
    tens_impl = cave.put(tens)
    core__write_far_goto(out, tens_mod_hook, tens_impl)
    return {
        "digits": 3,
        "policy": "minimal in-place argument/result hooks; no layer call added or replaced",
        "hundreds_hook": hundreds_hook,
        "hundreds_impl": hundreds_impl,
        "stock_transparent_image": transparent_image,
        "tens_mod_hook": tens_mod_hook,
        "tens_mod_impl": tens_impl,
        "layer_policy": "stock layer 11/12/13 creation calls remain byte-for-byte in their original flow",
    }


def evolution_ui__project_to_dict(project: core.Project, profile_version: int) -> dict[str, Any]:
    obj = evolution_merge__project_to_dict(project, profile_version)
    obj["format"] = evolution_ui__PROJECT_FORMAT
    obj["app_version"] = evolution_ui__APP_VERSION
    return obj


def evolution_ui__save_project(project: core.Project, profile_version: int, path: Path) -> None:
    obj = evolution_ui__project_to_dict(project, profile_version)
    base = Path(obj["base_rom"])
    if base.is_absolute():
        try:
            obj["base_rom"] = os.path.relpath(base, path.parent).replace("\\", "/")
        except ValueError:
            pass
    path.write_text(json.dumps(obj, ensure_ascii=False, indent=2), encoding="utf-8")
    project.project_path = path


globals()["universal__create_universal_project_from_rom"] = evolution_ui__create_project_from_rom
globals()["universal__save_universal_project"] = evolution_ui__save_project
globals()["universal__load_universal_project"] = evolution_ui__load_project
globals()["universal__build_universal_rom"] = evolution_ui__build_rom


def evolution_ui___supported_path(
    path: hist_af.RomEvolutionPath,
) -> evolution_loader__RomEvolutionPath:
    conditions = tuple(
        (
            cond
            for cond in path.conditions
            if cond.variable in evolution_loader__VARIABLE_TO_KIND
            and cond.operator in evolution_loader__OP_TO_ID
        )
    )
    return evolution_loader__RomEvolutionPath(
        source_id=path.source_id,
        result_id=path.result_id,
        conditions=conditions,
        origin=path.origin,
        handler=path.handler,
    )


class evolution_ui__GUI(evolution_merge__GUI):

    def __init__(self, root: Any, initial_project: Optional[Path] = None) -> None:
        super().__init__(root, initial_project)
        self.evo_source_combo.bind("<<ComboboxSelected>>", self._on_source_changed)
        self.root.title(self.root.title().replace("\x5613", "\x5614"))

    def _first_simple_path(self) -> Optional[evolution_loader__RomEvolutionPath]:
        paths = self._paths_for_current_result()
        if not paths:
            return None
        for path in paths:
            if all(
                (
                    c.variable in evolution_loader__VARIABLE_TO_KIND
                    and c.operator in evolution_loader__OP_TO_ID
                    for c in path.conditions
                )
            ):
                return evolution_ui___supported_path(path)
        return evolution_ui___supported_path(paths[0])

    def _install_route_selector(self) -> None:
        self.route_selector = None
        self.route_selector_var = None
        self.route_info_var = None
        self.evo_enable_check = None
        children = self.evolution_tab.winfo_children()
        if children:
            top = children[0]
            try:
                top.configure(text="진화 경로")
            except Exception:
                pass
            for child in top.winfo_children():
                try:
                    if child.winfo_class() == "TCheckbutton":
                        self.evo_enable_check = child
                        child.configure(command=self._on_enable_changed)
                        break
                except Exception:
                    pass

    def _on_enable_changed(self) -> None:
        desired = bool(self.evo_enabled_var.get())
        if self._viewing_rom_path is not None:
            self.copy_viewed_route_to_editor(show_message=False)
        self.evo_enabled_var.set(desired)
        self.commit_current_slot()


    def _refresh_route_selector(self, prefer_existing: bool = False) -> None:
        if self.project is None:
            return
        slot = self.project.slots[self.current_id]
        self._route_loading = True
        try:
            if slot.evolution.enabled:
                self._viewing_rom_path = None
                choices = list(self.evo_source_combo["values"])
                source = min(max(slot.evolution.source_id, 0), len(choices) - 1 if choices else 0)
                self.evo_source_var.set(choices[source] if choices else f"{source:03d}")
                self.evo_enabled_var.set(True)
            else:
                path = self._first_simple_path()
                if path is None:
                    self._viewing_rom_path = None
                    choices = list(self.evo_source_combo["values"])
                    source = min(
                        max(slot.evolution.source_id, 0), len(choices) - 1 if choices else 0
                    )
                    self.evo_source_var.set(choices[source] if choices else f"{source:03d}")
                    self.evo_enabled_var.set(False)
                else:
                    self._viewing_rom_path = path
                    choices = list(self.evo_source_combo["values"])
                    source = min(max(path.source_id, 0), len(choices) - 1 if choices else 0)
                    self.evo_source_var.set(choices[source] if choices else f"{source:03d}")
                    self.evo_enabled_var.set(True)
            self.evo_result_var.set(
                f"→ 결과: {self.current_id:03d} {self.project.slots[self.current_id].name}"
            )
            self.refresh_conditions()
        finally:
            self._route_loading = False

    def copy_viewed_route_to_editor(self, show_message: bool = False) -> bool:
        return super().copy_viewed_route_to_editor(show_message=False)

    def load_slot(self, slot_id: int) -> None:
        album_layers__GUI.load_slot(self, slot_id)
        self._refresh_route_selector(prefer_existing=True)


import argparse
import copy
import json
import os
import struct
import traceback
from dataclasses import asdict, dataclass
from pathlib import Path
from typing import Any, Optional

jogress__APP_VERSION = "15.0.0"
jogress__PROJECT_FORMAT = "PenCUniversalProject\x5615"
jogress__PROJECT_ROSTER_COUNT = evolution_merge__PROJECT_ROSTER_COUNT
jogress__STANDARD_ROSTER_COUNT = evolution_merge__STANDARD_ROSTER_COUNT
jogress__EXTENDED_ROSTER_COUNT = evolution_merge__EXTENDED_ROSTER_COUNT
jogress__STOCK_ROM_SIZE = evolution_merge__STOCK_ROM_SIZE
jogress__EXTENDED_ROM_SIZE = evolution_merge__EXTENDED_ROM_SIZE
jogress__METADATA_OFFSET = evolution_merge__METADATA_OFFSET
jogress__METADATA_SIZE = evolution_merge__METADATA_SIZE
jogress__METADATA_MAGIC = evolution_merge__METADATA_MAGIC
jogress__PROFILES = evolution_merge__PROFILES
jogress__RomLayout = evolution_merge__RomLayout
jogress__ATTRIBUTE_NAMES = ("프리", "바이러스", "데이터", "백신")
jogress__MAX_SPECIAL_JOGRESS_ROUTES = 30
jogress__SJ18_MAGIC = b"SJ18"
jogress__SJ43_MAGIC = b"SJ43"


@dataclass
class jogress__SpecialJogressRoute:
    enabled: bool = True
    source_id: int = 0
    version: int = 0
    partner_a: int = 0
    partner_b: int = 0
    result_id: int = 0

    def validate(self, roster_count: int = jogress__PROJECT_ROSTER_COUNT) -> None:
        for label, value in (
            ("소스 ID", self.source_id),
            ("파트너 A", self.partner_a),
            ("파트너 B", self.partner_b),
            ("결과 ID", self.result_id),
        ):
            if not 0 <= int(value) < roster_count:
                raise ValueError(f"{label} 범위 오류: {value} (0~{roster_count - 1})")
        if not 0 <= int(self.version) <= 255:
            raise ValueError(f"조그레스 버전 범위 오류: {self.version} (0~255)")

    def to_dict(self) -> dict[str, Any]:
        return asdict(self)

    @classmethod
    def from_dict(cls, obj: dict[str, Any]) -> "SpecialJogressRoute":
        route = cls(
            bool(obj.get("enabled", True)),
            int(obj.get("source_id", 0)),
            int(obj.get("version", 0)),
            int(obj.get("partner_a", 0)),
            int(obj.get("partner_b", 0)),
            int(obj.get("result_id", 0)),
        )
        route.validate()
        return route


def jogress___normalise_attribute_rows(rows: Any) -> list[list[int]]:
    result: list[list[int]] = []
    source = rows if isinstance(rows, list) else []
    for sid in range(jogress__PROJECT_ROSTER_COUNT):
        row = source[sid] if sid < len(source) and isinstance(source[sid], list) else []
        values: list[int] = []
        for index in range(4):
            value = row[index] if index < len(row) else -1
            if value is None:
                value = -1
            value = int(value)
            values.append(value if 0 <= value < jogress__PROJECT_ROSTER_COUNT else -1)
        result.append(values)
    return result


def jogress___attach_jogress(project: core.Project, data: bytes, layout: RomLayout) -> None:
    setattr(project, "attribute_jogress_rows", jogress___read_attribute_rows(data, layout))
    setattr(project, "special_jogress_routes", jogress___read_special_routes(data, layout))


def jogress___branch_target(word: int, pc: int) -> Optional[int]:
    op0 = word >> 12
    a = word >> 9 & 7
    op1 = word >> 6 & 7
    imm = word & 63
    if a == 7 and op1 in (0, 1) and (op0 <= 14):
        return pc + 2 + (imm * 2 if op1 == 0 else -imm * 2)
    return None


def jogress___branch_word(high: int, distance_words: int) -> int:
    if not 0 <= distance_words <= 63:
        raise ValueError(f"특수 조그레스 분기 거리 초과: {distance_words}")
    return (high & 255) << 8 | distance_words


def jogress___build_special_jogress_code(
    profile: Any, routes: list[SpecialJogressRoute], target: int
) -> tuple[bytes, dict[str, Any]]:
    included: list[jogress__SpecialJogressRoute] = []
    omitted: list[dict[str, Any]] = []
    for route in routes:
        if not route.enabled:
            continue
        route.validate()
        fields = (route.source_id, route.partner_a, route.partner_b, route.result_id)
        if any((value >= target for value in fields)):
            omitted.append(
                {**route.to_dict(), "reason": f"현재 저장 모드 ID 상한 {target - 1} 초과"}
            )
            continue
        included.append(route)
    words: list[int] = [55944, 8256 | int(profile.special_jogress_stack), 2824, 1]
    for route in included:
        branch_fixups: list[tuple[int, int]] = []
        words += jogress___load_ram_words(2086)
        words += [relocation__cmp16_word(4), route.source_id]
        branch_fixups.append((len(words), 78))
        words.append(0)
        words += jogress___load_ram_words(3357)
        words += [relocation__cmp16_word(4), route.version]
        branch_fixups.append((len(words), 78))
        words.append(0)
        words += jogress___load_ram_words(3358)
        words += [relocation__cmp16_word(4), route.partner_a]
        partner_a_branch = len(words)
        words.append(0)
        words += jogress___load_ram_words(3358)
        words += [relocation__cmp16_word(4), route.partner_b]
        branch_fixups.append((len(words), 78))
        words.append(0)
        result_index = len(words)
        words += [
            relocation__mov16_word(4),
            route.result_id,
            64 | int(profile.special_jogress_stack),
            39064,
        ]
        next_index = len(words)
        words[partner_a_branch] = jogress___branch_word(94, result_index - (partner_a_branch + 1))
        for index, high in branch_fixups:
            words[index] = jogress___branch_word(high, next_index - (index + 1))
    words += list(core__far_goto_words(profile.special_jogress_fallback))
    blob = struct.pack("<" + "H" * len(words), *words)
    return (
        blob,
        {
            "configured": len(routes),
            "enabled_in_output": len(included),
            "omitted": omitted,
            "bytes_used": len(blob),
            "fallback": profile.special_jogress_fallback,
        },
    )


def jogress___decode_stock_special_routes(
    data: bytes, profile: Any
) -> list[jogress__SpecialJogressRoute]:

    start, fallback = (profile.special_jogress_hook, profile.special_jogress_fallback)
    dispatch: dict[int, int] = {}
    off = start + 8
    for _ in range(64):
        if off + 12 > fallback:
            break
        if [core__read_u16(data, off + i * 2) for i in range(4)] != [65024, 39180, 2086, 39140]:
            break
        cmp_word = core__read_u16(data, off + 8)
        branch_word = core__read_u16(data, off + 10)
        if cmp_word & 65472 != 18496:
            break
        source_id = cmp_word & 63
        high = branch_word >> 8
        if high == 94:
            target = jogress___branch_target(branch_word, off + 10)
            if target is None:
                break
            dispatch[target] = source_id
            off += 12
        elif high == 78:
            target = jogress___far_target(data, off + 12)
            if target is None:
                break
            dispatch[target] = source_id
            off += 16
        else:
            break

    @dataclass(frozen=True)
    class State:
        pc: int
        current_var: str = ""
        cmp_var: str = ""
        cmp_value: int = 0
        version: Optional[int] = None
        partner: Optional[int] = None
        forbidden_version: tuple[int, ...] = ()
        forbidden_partner: tuple[int, ...] = ()
        steps: int = 0

    def apply_condition(state: State, equal: bool) -> Optional[State]:
        variable, value = (state.cmp_var, state.cmp_value)
        if variable not in ("version", "partner"):
            return state
        if variable == "version":
            if equal:
                if state.version is not None and state.version != value:
                    return None
                if value in state.forbidden_version:
                    return None
                return State(
                    state.pc,
                    state.current_var,
                    state.cmp_var,
                    state.cmp_value,
                    value,
                    state.partner,
                    state.forbidden_version,
                    state.forbidden_partner,
                    state.steps,
                )
            if state.version == value:
                return None
            return State(
                state.pc,
                state.current_var,
                state.cmp_var,
                state.cmp_value,
                state.version,
                state.partner,
                tuple(sorted(set(state.forbidden_version + (value,)))),
                state.forbidden_partner,
                state.steps,
            )
        if equal:
            if state.partner is not None and state.partner != value:
                return None
            if value in state.forbidden_partner:
                return None
            return State(
                state.pc,
                state.current_var,
                state.cmp_var,
                state.cmp_value,
                state.version,
                value,
                state.forbidden_version,
                state.forbidden_partner,
                state.steps,
            )
        if state.partner == value:
            return None
        return State(
            state.pc,
            state.current_var,
            state.cmp_var,
            state.cmp_value,
            state.version,
            state.partner,
            state.forbidden_version,
            tuple(sorted(set(state.forbidden_partner + (value,)))),
            state.steps,
        )

    raw_routes: list[tuple[int, int, int, int]] = []
    for handler, source_id in sorted(dispatch.items()):
        queue = [State(handler)]
        seen: set[State] = set()
        while queue:
            state = queue.pop()
            if state in seen or state.steps > 160:
                continue
            seen.add(state)
            pc = state.pc
            if not start <= pc < fallback or pc + 2 > len(data):
                continue
            if (
                pc + 8 <= len(data)
                and [core__read_u16(data, pc + i * 2) for i in range(2)] == [65024, 39180]
                and (core__read_u16(data, pc + 6) == 39140)
            ):
                address = core__read_u16(data, pc + 4)
                variable = "version" if address == 3357 else "partner" if address == 3358 else ""
                queue.append(
                    State(
                        pc + 8,
                        variable,
                        state.cmp_var,
                        state.cmp_value,
                        state.version,
                        state.partner,
                        state.forbidden_version,
                        state.forbidden_partner,
                        state.steps + 1,
                    )
                )
                continue
            word = core__read_u16(data, pc)
            if word & 65472 == 18496:
                queue.append(
                    State(
                        pc + 2,
                        state.current_var,
                        state.current_var,
                        word & 63,                        state.version,
                        state.partner,
                        state.forbidden_version,
                        state.forbidden_partner,
                        state.steps + 1,
                    )
                )
                continue
            if word & 65472 == 37440 and pc + 6 <= len(data):
                pop_word = core__read_u16(data, pc + 2)
                ret_word = core__read_u16(data, pc + 4)
                if pop_word == 64 | int(profile.special_jogress_stack) and ret_word == 39064:
                    if state.version is not None and state.partner is not None:
                        raw_routes.append((source_id, state.version, state.partner, word & 63))
                    continue
            branch_target = jogress___branch_target(word, pc)
            high = word >> 8
            if branch_target is not None and high in (78, 94):
                taken_equal = high == 94
                taken = apply_condition(
                    State(
                        branch_target,
                        state.current_var,
                        state.cmp_var,
                        state.cmp_value,
                        state.version,
                        state.partner,
                        state.forbidden_version,
                        state.forbidden_partner,
                        state.steps + 1,
                    ),
                    taken_equal,
                )
                fall = apply_condition(
                    State(
                        pc + 2,
                        state.current_var,
                        state.cmp_var,
                        state.cmp_value,
                        state.version,
                        state.partner,
                        state.forbidden_version,
                        state.forbidden_partner,
                        state.steps + 1,
                    ),
                    not taken_equal,
                )
                if taken is not None:
                    queue.append(taken)
                if fall is not None:
                    queue.append(fall)
                continue
            if branch_target is not None and high == 238:
                queue.append(
                    State(
                        branch_target,
                        state.current_var,
                        state.cmp_var,
                        state.cmp_value,
                        state.version,
                        state.partner,
                        state.forbidden_version,
                        state.forbidden_partner,
                        state.steps + 1,
                    )
                )
                continue
            far = jogress___far_target(data, pc)
            if far is not None:
                if start <= far < fallback:
                    queue.append(
                        State(
                            far,
                            state.current_var,
                            state.cmp_var,
                            state.cmp_value,
                            state.version,
                            state.partner,
                            state.forbidden_version,
                            state.forbidden_partner,
                            state.steps + 1,
                        )
                    )
                continue
            queue.append(
                State(
                    pc + 2,
                    state.current_var,
                    state.cmp_var,
                    state.cmp_value,
                    state.version,
                    state.partner,
                    state.forbidden_version,
                    state.forbidden_partner,
                    state.steps + 1,
                )
            )
    grouped: dict[tuple[int, int, int], list[int]] = {}
    for source_id, version, partner, result_id in raw_routes:
        key = (source_id, version, result_id)
        if partner not in grouped.setdefault(key, []):
            grouped[key].append(partner)
    routes: list[jogress__SpecialJogressRoute] = []
    for (source_id, version, result_id), partners in grouped.items():
        for index in range(0, len(partners), 2):
            pair = partners[index : index + 2]
            partner_a = pair[0]
            partner_b = pair[1] if len(pair) > 1 else pair[0]
            routes.append(
                jogress__SpecialJogressRoute(
                    True, source_id, version, partner_a, partner_b, result_id
                )
            )
    return routes


def jogress___far_target(data: bytes, pc: int) -> Optional[int]:
    if pc + 4 > len(data):
        return None
    first = core__read_u16(data, pc)
    second = core__read_u16(data, pc + 2)
    if first & 65408 != 65152:
        return None
    word_address = (first & 1) << 16 | second
    return word_address * 2


def jogress___load_ram_words(address: int) -> list[int]:
    return [65024, 39180, address & 65535, 39140]


def jogress___meta_for_any(data: bytes) -> Optional[dict[str, Any]]:
    return evolution_merge__read_meta(data)


def jogress___patch_attribute_jogress(
    out: bytearray, project: core.Project, target: int, table: dict[str, int]
) -> dict[str, Any]:
    rows = jogress___normalise_attribute_rows(getattr(project, "attribute_jogress_rows", []))
    active = 0
    clipped = 0
    for source_id in range(target):
        row_off = table["jog_rows"] + source_id * 8
        core__write_u32(out, table["jog_ptr"] + source_id * 4, 2097152 + row_off // 2)
        for attr in range(4):
            value = rows[source_id][attr]
            if value < 0:
                encoded = target
            elif value >= target:
                encoded = target
                clipped += 1
            else:
                encoded = value
                active += 1
            core__write_u16(out, row_off + attr * 2, encoded)
    return {"active_results": active, "clipped_for_mode": clipped, "sentinel": target}


def jogress___read_attribute_rows(data: bytes, layout: RomLayout) -> list[list[int]]:
    meta = jogress___meta_for_any(data)
    rows: list[list[int]] = []
    if meta and meta.get("jogress_rows") is not None:
        base = int(meta["jogress_rows"])
        count = min(layout.roster_count, jogress__PROJECT_ROSTER_COUNT)
        for sid in range(count):
            vals = [core__read_u16(data, base + sid * 8 + i * 2) for i in range(4)]
            rows.append([-1 if value in (layout.roster_count, 65535) else value for value in vals])
    else:
        pointer_table = core__read_u16(data, layout.profile.jogress_pointer_load_site) * 2
        for sid in range(layout.profile.stock_roster_count):
            pointer = core__read_u32(data, pointer_table + sid * 4)
            raw = (pointer - 2097152) * 2
            if not 0 <= raw <= len(data) - 8:
                raise ValueError(f"속성 조그레스 포인터 오류: ID {sid} -> {pointer:#x}")
            vals = [core__read_u16(data, raw + i * 2) for i in range(4)]
            rows.append(
                [
                    -1 if value in (layout.profile.stock_roster_count, 65535) else value
                    for value in vals
                ]
            )
    return jogress___normalise_attribute_rows(rows)


def jogress___read_special_routes(
    data: bytes, layout: RomLayout
) -> list[jogress__SpecialJogressRoute]:
    meta = jogress___meta_for_any(data)
    if meta and int(meta.get("stat_table", 0)) == int(compact8__TABLE_START):
        return modrom__read_special_routes(data, layout, meta)
    if meta and isinstance(meta.get("special_jogress_routes"), list):
        routes = [jogress__SpecialJogressRoute.from_dict(x) for x in meta["special_jogress_routes"]]
        return routes[:jogress__MAX_SPECIAL_JOGRESS_ROUTES]
    sj43_at = None
    if meta:
        sj43_at = meta.get("special_jogress_table")
        if sj43_at is None and isinstance(meta.get("special_jogress"), dict):
            sj43_at = meta["special_jogress"].get("sj43_offset")
    if sj43_at is not None:
        magic_at = int(sj43_at)
        if data[magic_at : magic_at + 4] == jogress__SJ43_MAGIC and magic_at + 8 <= len(data):
            maximum = core__read_u32(data, magic_at + 4)
            if (
                1 <= maximum <= jogress__MAX_SPECIAL_JOGRESS_ROUTES
                and magic_at + 8 + maximum * 12 <= len(data)
            ):
                routes: list[jogress__SpecialJogressRoute] = []
                for index in range(maximum):
                    row = struct.unpack_from("<6H", data, magic_at + 8 + index * 12)
                    route = jogress__SpecialJogressRoute(
                        bool(row[0]), row[1], row[2], row[3], row[4], row[5]
                    )
                    if route.enabled:
                        route.validate(jogress__PROJECT_ROSTER_COUNT)
                    routes.append(route)
                return routes[:jogress__MAX_SPECIAL_JOGRESS_ROUTES]
    magic_at = data.find(jogress__SJ18_MAGIC, 0, min(len(data), 4194304))
    if magic_at >= 0 and magic_at + 8 <= len(data):
        maximum = core__read_u32(data, magic_at + 4)
        if 1 <= maximum <= 64 and magic_at + 8 + maximum * 6 <= len(data):
            routes: list[jogress__SpecialJogressRoute] = []
            for index in range(maximum):
                row = data[magic_at + 8 + index * 6 : magic_at + 14 + index * 6]
                if len(row) < 6 or row == b"\x00" * 6:
                    continue
                route = jogress__SpecialJogressRoute(
                    bool(row[0]), row[1], row[2], row[3], row[4], row[5]
                )
                if route.enabled:
                    route.validate(jogress__PROJECT_ROSTER_COUNT)
                    routes.append(route)
            if routes:
                return routes[:jogress__MAX_SPECIAL_JOGRESS_ROUTES]
    return jogress___decode_stock_special_routes(data, layout.profile)[
        :jogress__MAX_SPECIAL_JOGRESS_ROUTES
    ]


def jogress___validate_project_jogress(project: core.Project) -> None:
    rows = jogress___normalise_attribute_rows(getattr(project, "attribute_jogress_rows", []))
    setattr(project, "attribute_jogress_rows", rows)
    routes = list(getattr(project, "special_jogress_routes", []))
    if len(routes) > jogress__MAX_SPECIAL_JOGRESS_ROUTES:
        raise ValueError(f"특수 조그레스는 최대 {jogress__MAX_SPECIAL_JOGRESS_ROUTES}경로입니다")
    for route in routes:
        route.validate()
    setattr(project, "special_jogress_routes", routes)


def jogress___write_sj18_compat(
    out: bytearray, offset: int, routes: list[SpecialJogressRoute]
) -> Optional[int]:

    if offset + 8 + jogress__MAX_SPECIAL_JOGRESS_ROUTES * 6 > len(out):
        return None
    payload = bytearray(
        jogress__SJ18_MAGIC + struct.pack("<I", jogress__MAX_SPECIAL_JOGRESS_ROUTES)
    )
    enabled = [
        r
        for r in routes
        if r.enabled and max(r.source_id, r.version, r.partner_a, r.partner_b, r.result_id) <= 255
    ][:jogress__MAX_SPECIAL_JOGRESS_ROUTES]
    for index in range(jogress__MAX_SPECIAL_JOGRESS_ROUTES):
        if index < len(enabled):
            r = enabled[index]
            payload += bytes((1, r.source_id, r.version, r.partner_a, r.partner_b, r.result_id))
        else:
            payload += b"\x00" * 6
    out[offset : offset + len(payload)] = payload
    return offset


def jogress___write_sj43_table(
    out: bytearray, offset: int, routes: list[SpecialJogressRoute]
) -> int:
    size = 8 + jogress__MAX_SPECIAL_JOGRESS_ROUTES * 12
    if offset + size > len(out):
        raise ValueError("\x5643 특수 조그레스 테이블 공간 초과")
    payload = bytearray(
        jogress__SJ43_MAGIC + struct.pack("<I", jogress__MAX_SPECIAL_JOGRESS_ROUTES)
    )
    rows = list(routes)[:jogress__MAX_SPECIAL_JOGRESS_ROUTES]
    for index in range(jogress__MAX_SPECIAL_JOGRESS_ROUTES):
        if index < len(rows):
            r = rows[index]
            payload += struct.pack(
                "<6H",
                int(bool(r.enabled)),
                r.source_id,
                r.version,
                r.partner_a,
                r.partner_b,
                r.result_id,
            )
        else:
            payload += b"\x00" * 12
    out[offset : offset + len(payload)] = payload
    return offset


def jogress__build_rom(
    project: core.Project, source: bytes, layout: RomLayout, target: int, extended: bool
):

    jogress___validate_project_jogress(project)
    base_rom, report = evolution_merge__build_rom(project, source, layout, target, extended)
    out = bytearray(base_rom)
    profile = layout.profile
    table = dict(report["tables"])
    attribute_report = jogress___patch_attribute_jogress(out, project, target, table)
    routes = list(getattr(project, "special_jogress_routes", []))
    special_blob, special_report = jogress___build_special_jogress_code(profile, routes, target)
    special_offset = table["evo"] + int(report["evolution"]["bytes_used"]) + 1 & ~1
    if special_offset + len(special_blob) > table["evo_end"]:
        raise ValueError(
            f"진화+특수 조그레스 코드 공간 초과: {special_offset + len(special_blob) - table['evo']}/{table['evo_end'] - table['evo']} bytes"
        )
    out[special_offset : special_offset + len(special_blob)] = special_blob
    core__write_far_goto(out, profile.special_jogress_hook, special_offset)
    special_report["code_offset"] = special_offset
    sj43_offset = special_offset + len(special_blob) + 3 & ~3
    sj43_size = 8 + jogress__MAX_SPECIAL_JOGRESS_ROUTES * 12
    sj18_offset = sj43_offset + sj43_size + 3 & ~3
    sj18_size = 8 + jogress__MAX_SPECIAL_JOGRESS_ROUTES * 6
    if sj18_offset + sj18_size > table["evo_end"]:
        raise ValueError(
            f"진화+특수 조그레스 테이블 공간 초과: {sj18_offset + sj18_size - table['evo']}/{table['evo_end'] - table['evo']} bytes"
        )
    special_report["sj43_offset"] = jogress___write_sj43_table(out, sj43_offset, routes)
    special_report["sj18_compat_offset"] = jogress___write_sj18_compat(out, sj18_offset, routes)
    extra = {
        **report.get("album_ram", {}),
        "album_cursor": report.get("album_cursor"),
        "album_number": report.get("album_number"),
        "album_number_patch_disabled": True,
        "image_pointer_policy": "nonnegative-relative-only",
        "attribute_jogress": attribute_report,
        "special_jogress": special_report,
        "special_jogress_route_count": len(routes),
        "special_jogress_routes_storage": "SJ18 compatibility table",
    }
    evolution_merge__write_meta(
        out,
        profile,
        target,
        table,
        "extended16-\x7615-stock-album" if extended else "standard8-\x7615-stock-album",
        extra,
    )
    meta = evolution_merge__read_meta(out)
    if meta is None:
        raise AssertionError("\x5615 metadata write failed")
    meta["format"] = jogress__PROJECT_FORMAT
    meta["app_version"] = jogress__APP_VERSION
    encoded = json.dumps(meta, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
    if len(encoded) + 12 > jogress__METADATA_SIZE:
        raise ValueError("\x5615 메타데이터 공간 초과")
    out[jogress__METADATA_OFFSET : jogress__METADATA_OFFSET + jogress__METADATA_SIZE] = (
        b"\x00" * jogress__METADATA_SIZE
    )
    out[jogress__METADATA_OFFSET : jogress__METADATA_OFFSET + 8] = jogress__METADATA_MAGIC
    core__write_u32(out, jogress__METADATA_OFFSET + 8, len(encoded))
    out[jogress__METADATA_OFFSET + 12 : jogress__METADATA_OFFSET + 12 + len(encoded)] = encoded
    report = copy.deepcopy(report)
    report["format"] = "PenC Universal Editor \x5615 build report"
    report["app_version"] = jogress__APP_VERSION
    report["album_entry_policy"] = (
        "\x5613 hardware-tested rollback: stock two-digit number path, no \x5614 album display hook"
    )
    report["attribute_jogress"] = attribute_report
    report["special_jogress"] = special_report
    report["output_sha256"] = core__sha256(out)
    return (bytes(out), report)


def jogress__create_project_from_rom(path: Path):
    project, data, images, layout = evolution_merge__create_project_from_rom(path)
    jogress___attach_jogress(project, data, layout)
    return (project, data, images, layout)


def jogress__identify_layout(data: bytes) -> jogress__RomLayout:
    if len(data) not in (jogress__STOCK_ROM_SIZE, jogress__EXTENDED_ROM_SIZE):
        raise ValueError("8 MiB 또는 16 MiB ROM만 지원합니다")
    meta = jogress___meta_for_any(data)
    if meta and meta.get("format") == jogress__PROJECT_FORMAT:
        profile = jogress__PROFILES[int(meta["profile_version"])]
        return jogress__RomLayout(
            profile,
            int(meta["roster_count"]),
            int(meta["image_count"]),
            int(meta["stat_table"]),
            int(meta["size_table"]),
            str(meta.get("mode", "patched")),
        )
    return evolution_merge__identify_layout(data)


def jogress__load_project(path: Path):
    obj = json.loads(path.read_text(encoding="utf-8"))
    if obj.get("format") == jogress__PROJECT_FORMAT:
        version = int(obj["profile_version"])
        base = Path(obj.get("base_rom", ""))
        if not base.is_absolute():
            base = (path.parent / base).resolve()
        project, data, images, layout = jogress__create_project_from_rom(base)
        if layout.profile.version != version:
            raise ValueError("프로젝트와 기반 ROM 버전이 다릅니다")
        loaded = [core__DigimonSlot.from_dict(x) for x in obj.get("slots", [])]
        for index, slot in enumerate(loaded[:jogress__PROJECT_ROSTER_COUNT]):
            project.slots[index] = slot
        project.project_path = path
        project.rom_files = {"vanilla": str(base), "profile_version": str(version)}
        stored_paths = [
            evolution_loader__RomEvolutionPath.from_dict(x)
            for x in obj.get("rom_evolution_paths", [])
        ]
        if stored_paths:
            setattr(project, "rom_evolution_paths", stored_paths)
            setattr(
                project, "rom_evolution_parse_report", obj.get("rom_evolution_parse_report", {})
            )
        setattr(
            project,
            "attribute_jogress_rows",
            jogress___normalise_attribute_rows(obj.get("attribute_jogress_rows", [])),
        )
        setattr(
            project,
            "special_jogress_routes",
            [
                jogress__SpecialJogressRoute.from_dict(x)
                for x in obj.get("special_jogress_routes", [])
            ][:jogress__MAX_SPECIAL_JOGRESS_ROUTES],
        )
        return (project, data, images, layout)
    project, data, images, layout = evolution_ui__load_project(path)
    if not hasattr(project, "attribute_jogress_rows"):
        jogress___attach_jogress(project, data, layout)
    project.project_path = path
    return (project, data, images, layout)


def jogress__project_to_dict(project: core.Project, profile_version: int) -> dict[str, Any]:
    obj = evolution_merge__project_to_dict(project, profile_version)
    obj["format"] = jogress__PROJECT_FORMAT
    obj["app_version"] = jogress__APP_VERSION
    obj["attribute_jogress_rows"] = jogress___normalise_attribute_rows(
        getattr(project, "attribute_jogress_rows", [])
    )
    obj["special_jogress_routes"] = [
        route.to_dict() for route in getattr(project, "special_jogress_routes", [])
    ]
    return obj


def jogress__save_project(project: core.Project, profile_version: int, path: Path) -> None:
    obj = jogress__project_to_dict(project, profile_version)
    base = Path(obj["base_rom"])
    if base.is_absolute():
        try:
            obj["base_rom"] = os.path.relpath(base, path.parent).replace("\\", "/")
        except ValueError:
            pass
    path.write_text(json.dumps(obj, ensure_ascii=False, indent=2), encoding="utf-8")
    project.project_path = path


