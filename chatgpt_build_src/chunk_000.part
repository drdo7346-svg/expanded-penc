@dataclass
class universal__RomLayout:
    profile: universal__UniversalProfile
    roster_count: int
    image_count: int
    stat_table: int
    size_table: int
    mode: str


def universal__activate(profile: UniversalProfile, target_count: int) -> None:

    if target_count not in (universal__STANDARD_ROSTER_COUNT, universal__EXTENDED_ROSTER_COUNT):
        raise ValueError(f"지원하지 않는 로스터 수: {target_count}")
    globals()["core__ROSTER_COUNT"] = target_count
    globals()["core__MAX_ID"] = target_count - 1
    globals()["core__ORIGINAL_ROSTER_COUNT"] = profile.stock_roster_count
    globals()["core__ADDED_ROSTER_COUNT"] = target_count - profile.stock_roster_count
    globals()["core__VANILLA_IMAGE_COUNT"] = profile.stock_image_count
    globals()["core__FINAL_IMAGE_COUNT"] = (
        profile.stock_image_count + core__ADDED_ROSTER_COUNT * core__FRAMES_PER_DIGIMON
    )
    globals()["core__NO_RESULT_ID"] = target_count
    globals()["core__ORIGINAL_SIZE_TABLE"] = profile.stock_size_table
    globals()["core__RELOCATED_SIZE_TABLE"] = universal__RELOCATED_SIZE_TABLE
    globals()["core__ORIGINAL_STAT_TABLE"] = 131390
    globals()["core__FINAL_STAT_TABLE"] = universal__FINAL_STAT_TABLE
    globals()["core__STAT_LOOKUP_SITE"] = profile.stat_lookup_site
    globals()["core__CUTIN_FLAG"] = universal__CUTIN_FLAG
    globals()["core__METADATA_OFFSET"] = universal__METADATA_OFFSET
    globals()["core__METADATA_SIZE"] = universal__METADATA_SIZE
    globals()["core__ALBUM_HOOK"] = profile.album_cursor_hook
    globals()["core__ALBUM_RETURN"] = profile.album_cursor_return
    globals()["core__ALBUM_CAVE"] = universal__ALBUM_CURSOR_CAVE
    globals()["core__ALBUM_VISIBILITY_FUNCTION"] = profile.album_visibility_function
    globals()["core__ALBUM_VISIBILITY_FUNCTION_END"] = profile.album_visibility_function_end
    globals()["core__ALBUM_VISIBILITY_CAVE"] = universal__ALBUM_VISIBILITY_CAVE
    globals()["core__ALBUM_VISIBILITY_ORIGINAL_COPY"] = universal__ALBUM_VISIBILITY_ORIGINAL_COPY
    globals()["core__ALBUM_VISIBILITY_CAVE_END"] = universal__ALBUM_VISIBILITY_CAVE_END
    globals()["core__EVO_HOOK"] = profile.evolution_hook
    globals()["core__EVO_HOOK_RETURN"] = profile.evolution_return
    globals()["core__EVO_RESULT_RETURN"] = profile.evolution_result_return
    globals()["core__EVO_CAVE"] = universal__EVOLUTION_CAVE
    globals()["core__EVO_CAVE_END"] = universal__EVOLUTION_CAVE_END
    globals()["core__JOGRESS_STAGE_MISMATCH_SITE"] = profile.jogress_stage_mismatch_site
    globals()["core__JOGRESS_POINTER_LOAD_SITE"] = profile.jogress_pointer_load_site
    globals()["core__JOGRESS_POINTER_TABLE"] = universal__JOGRESS_POINTER_TABLE
    globals()["core__JOGRESS_ROWS"] = universal__JOGRESS_ROWS
    globals()["core__JOGRESS_SPECIAL_HOOK"] = profile.special_jogress_hook
    globals()["core__JOGRESS_SPECIAL_DATA"] = universal__JOGRESS_SPECIAL_DATA
    globals()["core__JOGRESS_SPECIAL_END"] = universal__JOGRESS_SPECIAL_END
    globals()["core__ROSTER_MAX_OFFSETS"] = list(profile.roster_max_offsets)
    globals()["core__IMAGE_MAX_OFFSETS"] = list(profile.image_max_offsets)
    globals()["core__SIZE_TABLE_ADDRESS_SITES"] = list(profile.size_table_sites)
    globals()["core__EXPECTED_SHA256"] = profile.stock_sha256
    globals()["core__DEFAULT_NEW_SLOT_TEMPLATE_ID"] = profile.stock_roster_count - 1


def universal___call_words_for_raw(raw_offset: int) -> tuple[int, int]:
    word_address = 2097152 + raw_offset // 2
    return (61536 | word_address >> 16 & 1, word_address & 65535)


def universal___read_metadata(data: bytes) -> Optional[dict[str, Any]]:
    if len(data) < universal__METADATA_OFFSET + len(universal__METADATA_MAGIC) + 4:
        return None
    if (
        data[
            universal__METADATA_OFFSET : universal__METADATA_OFFSET + len(universal__METADATA_MAGIC)
        ]
        != universal__METADATA_MAGIC
    ):
        return None
    size = core__read_u32(data, universal__METADATA_OFFSET + len(universal__METADATA_MAGIC))
    if size <= 0 or size > universal__METADATA_SIZE - len(universal__METADATA_MAGIC) - 4:
        return None
    start = universal__METADATA_OFFSET + len(universal__METADATA_MAGIC) + 4
    try:
        return json.loads(data[start : start + size].decode("utf-8"))
    except Exception:
        return None


def universal__album_visibility_wrapper_words(profile: UniversalProfile) -> list[int]:
    goto_original = core__far_goto_words(universal__ALBUM_VISIBILITY_ORIGINAL_COPY)
    call = universal___call_words_for_raw(profile.stat_lookup_function)
    return [
        55944,
        8258,
        2824,
        1,
        8258,
        38405,
        2312,
        1,
        54980,
        38478,
        2312,
        2,
        54980,
        call[0],
        call[1],
        66,
        16960,
        24066,
        66,
        39064,
        66,
        goto_original[0],
        goto_original[1],
    ]


def universal__build_universal_rom(
    project: core.Project, source: bytes, layout: RomLayout, target_count: int, extended: bool
) -> tuple[bytes, dict[str, Any]]:
    profile = layout.profile
    universal__activate(profile, target_count)
    build_project = core__Project(
        slots=copy.deepcopy(project.slots[:target_count]), rom_files=dict(project.rom_files)
    )
    core__validate_project(build_project)
    source_images = universal__read_images_flexible(source, layout.image_count, layout.size_table)
    if len(source_images) < profile.stock_image_count:
        raise ValueError("기반 ROM의 이미지 수가 원본 이미지 수보다 작습니다")
    if extended:
        output = bytearray(b"\xff" * universal__EXTENDED_ROM_SIZE)
        output[:universal__STOCK_ROM_SIZE] = source[:universal__STOCK_ROM_SIZE]
    else:
        output = bytearray(source[:universal__STOCK_ROM_SIZE])
    save_before = bytes(source[universal__SAVE_TAIL_START:universal__SAVE_TAIL_END])
    output[universal__METADATA_OFFSET:229376] = b"\x00" * (229376 - universal__METADATA_OFFSET)
    output[universal__CUTIN_FLAG] = 0
    final_images = list(source_images[: profile.stock_image_count])
    final_stats: list[list[int]] = []
    for slot in build_project.slots:
        stats = list(slot.stats)
        if slot.digimon_id < profile.stock_roster_count:
            sprite_start = 240 + slot.digimon_id * core__FRAMES_PER_DIGIMON
            stats[0] = sprite_start
            if slot.digimon_id < layout.roster_count:
                stats[core__ALBUM_ORDER_STAT_INDEX] = core__read_stat_words(
                    source, slot.digimon_id, layout.stat_table
                )[core__ALBUM_ORDER_STAT_INDEX]
            for j, ref in enumerate(slot.frames):
                final_images[sprite_start + j] = core__resolve_frame(ref, source_images)
        else:
            sprite_start = (
                profile.stock_image_count
                + (slot.digimon_id - profile.stock_roster_count) * core__FRAMES_PER_DIGIMON
            )
            stats[0] = sprite_start
            stats[core__ALBUM_ORDER_STAT_INDEX] = slot.digimon_id
            for ref in slot.frames:
                final_images.append(core__resolve_frame(ref, source_images))
        final_stats.append(stats)
    expected_images = (
        profile.stock_image_count
        + (target_count - profile.stock_roster_count) * core__FRAMES_PER_DIGIMON
    )
    if len(final_images) != expected_images:
        raise AssertionError(f"최종 이미지 수 오류: {len(final_images)} != {expected_images}")
    image_end, upper_start = universal__write_images_universal(output, final_images, extended)
    for slot, stats in zip(build_project.slots, final_stats):
        core__write_stat_words(output, slot.digimon_id, stats, universal__FINAL_STAT_TABLE)
    core__write_u16(output, profile.stat_lookup_site, universal__FINAL_STAT_TABLE // 2 & 65535)
    for off in profile.roster_max_offsets:
        core__write_immediate6(output, off, target_count - 1)
    for off in profile.image_max_offsets:
        core__write_u16(output, off, expected_images - 1)
    for off in profile.size_table_sites:
        core__write_u16(output, off, 28928)
        core__write_u16(output, off + 2, 39009)
    core__patch_album_cursor(output)
    universal__patch_album_visibility(output, source, profile, target_count - 1)
    evolution_report = core__patch_evolution(output, build_project.slots)
    universal__patch_attribute_jogress_universal(output, source, layout, target_count)
    universal__write_metadata(
        output, profile, target_count, expected_images, "extended16" if extended else "standard8"
    )
    if output[universal__SAVE_TAIL_START:universal__SAVE_TAIL_END] != save_before:
        raise AssertionError("기존 저장영역 0x7F\x44000~0x7FFFFF가 변경되었습니다")
    if core__detect_image_count(output) != expected_images:
        raise AssertionError("이미지 포인터 수 검증 실패")
    if core__read_u16(output, profile.stat_lookup_site) != universal__FINAL_STAT_TABLE // 2 & 65535:
        raise AssertionError("스탯표 주소 패치 실패")
    for off in profile.roster_max_offsets:
        if off == profile.album_visibility_max_site:
            copied_off = universal__ALBUM_VISIBILITY_ORIGINAL_COPY + (
                off - profile.album_visibility_function
            )
            if core__read_u16(output, copied_off) & 63 != target_count - 1:
                raise AssertionError(f"앨범 표시 상한 복사 패치 실패: {off:#x}")
            continue
        if core__read_u16(output, off) & 63 != target_count - 1:
            raise AssertionError(f"로스터 상한 패치 실패: {off:#x}")
    for off in profile.image_max_offsets:
        if core__read_u16(output, off) != expected_images - 1:
            raise AssertionError(f"이미지 상한 패치 실패: {off:#x}")
    report = {
        "format": "PenC Universal Editor \x566 build report",
        "app_version": universal__APP_VERSION,
        "profile": profile.label,
        "profile_version": profile.version,
        "mode": "MX25L12833F 16 MiB extended" if extended else "standard 8 MiB",
        "rom_size": len(output),
        "roster_count": target_count,
        "max_id": target_count - 1,
        "reserved_no_result_id": target_count,
        "stock_roster_count": profile.stock_roster_count,
        "stock_image_count": profile.stock_image_count,
        "total_image_count": expected_images,
        "image_end": image_end,
        "upper_flash_image_start": upper_start,
        "save_tail_preserved": True,
        "album": {
            "visibility": "stat[14] OR original runtime visibility bit",
            "locked_sprite": "original acquired-bit/lock-image path retained",
            "stat14_editable": True,
        },
        "evolution": evolution_report,
        "source_sha256": core__sha256(source),
        "output_sha256": core__sha256(output),
        "hardware_note": "16 MiB output uses image pointer offsets above 0x7FFFFF; real-device MX25L12833F validation is required.",
    }
    return (bytes(output), report)


def universal__create_project_from_rom(
    path: Path,
) -> tuple[core__Project, bytes, list[core__RomImage], universal__RomLayout]:
    data = path.read_bytes()
    layout = universal__identify_layout(data)
    universal__activate(layout.profile, universal__PROJECT_ROSTER_COUNT)
    images = universal__read_images_flexible(data, layout.image_count, layout.size_table)
    slots: list[core__DigimonSlot] = []
    current_count = min(layout.roster_count, universal__PROJECT_ROSTER_COUNT)
    for digimon_id in range(current_count):
        stats = core__read_stat_words(data, digimon_id, layout.stat_table)
        start = stats[0]
        if start + core__FRAMES_PER_DIGIMON > len(images):
            raise ValueError(f"ID {digimon_id:02d}: 스프라이트 시작 번호 오류 {start}")
        frames = [core__FrameRef("base", start + i) for i in range(core__FRAMES_PER_DIGIMON)]
        if layout.profile.version == 1 and digimon_id < len(core__DEFAULT_DISPLAY_NAMES):
            name = core__DEFAULT_DISPLAY_NAMES[digimon_id]
        else:
            name = f"{layout.profile.label.split('/')[0].strip()} ID {digimon_id:02d}"
        slots.append(core__DigimonSlot(digimon_id, name, stats, frames, core__EvolutionRoute()))
    template_id = max(0, current_count - 1)
    template_stats = list(slots[template_id].stats)
    template_frames = copy.deepcopy(slots[template_id].frames)
    for digimon_id in range(current_count, universal__PROJECT_ROSTER_COUNT):
        stats = list(template_stats)
        stats[core__ALBUM_ORDER_STAT_INDEX] = digimon_id
        stats[core__ALBUM_VISIBLE_STAT_INDEX] = 1
        slots.append(
            core__DigimonSlot(
                digimon_id,
                f"추가 슬롯 {digimon_id:02d}",
                stats,
                copy.deepcopy(template_frames),
                core__EvolutionRoute(False, 0, []),
            )
        )
    project = core__Project(
        slots=slots,
        rom_files={"vanilla": str(path.resolve()), "profile_version": str(layout.profile.version)},
    )
    return (project, data, images, layout)


def universal__identify_layout(data: bytes) -> universal__RomLayout:
    if len(data) not in (universal__STOCK_ROM_SIZE, universal__EXTENDED_ROM_SIZE):
        raise ValueError(f"지원 ROM 크기가 아닙니다: {len(data):#x} (8 MiB 또는 16 MiB 필요)")
    meta = universal___read_metadata(data)
    if meta and meta.get("format") == universal__PROJECT_FORMAT:
        version = int(meta["profile_version"])
        profile = universal__PROFILES[version]
        return universal__RomLayout(
            profile=profile,
            roster_count=int(meta["roster_count"]),
            image_count=int(meta["image_count"]),
            stat_table=int(meta.get("stat_table", universal__FINAL_STAT_TABLE)),
            size_table=int(meta.get("size_table", universal__RELOCATED_SIZE_TABLE)),
            mode=str(meta.get("mode", "patched")),
        )
    if len(data) != universal__STOCK_ROM_SIZE:
        raise ValueError("16 MiB ROM에 \x566 메타데이터가 없어 버전을 안전하게 판별할 수 없습니다")
    detected = core__detect_penc_profile(data)
    profile = universal__PROFILES[detected.version]
    return universal__RomLayout(
        profile,
        profile.stock_roster_count,
        profile.stock_image_count,
        131390,
        profile.stock_size_table,
        "stock",
    )


def universal__load_universal_project(
    path: Path,
) -> tuple[core__Project, bytes, list[core__RomImage], universal__RomLayout]:
    obj = json.loads(path.read_text(encoding="utf-8"))
    if obj.get("format") != universal__PROJECT_FORMAT:
        legacy = core__load_project(path)
        version = 1
        base_text = legacy.rom_files.get("vanilla", "PenC1.bin")
        base = Path(base_text)
        if not base.is_absolute():
            base = (path.parent / base).resolve()
        temp_project, data, images, layout = universal__create_project_from_rom(base)
        for i, slot in enumerate(legacy.slots[:universal__PROJECT_ROSTER_COUNT]):
            temp_project.slots[i] = slot
        temp_project.project_path = path
        return (temp_project, data, images, layout)
    version = int(obj["profile_version"])
    base = Path(str(obj.get("base_rom", "")))
    if not base.is_absolute():
        base = (path.parent / base).resolve()
    project, data, images, layout = universal__create_project_from_rom(base)
    if layout.profile.version != version:
        raise ValueError(f"프로젝트 버전 VP{version}과 기반 ROM {layout.profile.label}이 다릅니다")
    loaded = [core__DigimonSlot.from_dict(x) for x in obj.get("slots", [])]
    for i, slot in enumerate(loaded[:universal__PROJECT_ROSTER_COUNT]):
        project.slots[i] = slot
    project.project_path = path
    project.rom_files = {"vanilla": str(base), "profile_version": str(version)}
    return (project, data, images, layout)


def universal__patch_album_visibility(
    output: bytearray, source: bytes, profile: UniversalProfile, max_id: int
) -> None:
    words = universal__album_visibility_wrapper_words(profile)
    wrapper = struct.pack("<" + "H" * len(words), *words)
    output[universal__ALBUM_VISIBILITY_CAVE:universal__ALBUM_VISIBILITY_CAVE_END] = b"\x00" * (
        universal__ALBUM_VISIBILITY_CAVE_END - universal__ALBUM_VISIBILITY_CAVE
    )
    output[universal__ALBUM_VISIBILITY_CAVE : universal__ALBUM_VISIBILITY_CAVE + len(wrapper)] = (
        wrapper
    )
    expected_goto = struct.pack("<2H", *core__far_goto_words(universal__ALBUM_VISIBILITY_CAVE))
    if (
        source[profile.album_visibility_function : profile.album_visibility_function + 4]
        == expected_goto
    ):
        original = bytearray(
            source[
                universal__ALBUM_VISIBILITY_ORIGINAL_COPY : universal__ALBUM_VISIBILITY_ORIGINAL_COPY
                + 82
            ]
        )
    else:
        original = bytearray(
            source[profile.album_visibility_function : profile.album_visibility_function_end]
        )
    core__write_immediate6(
        original, profile.album_visibility_max_site - profile.album_visibility_function, max_id
    )
    output[
        universal__ALBUM_VISIBILITY_ORIGINAL_COPY : universal__ALBUM_VISIBILITY_ORIGINAL_COPY
        + len(original)
    ] = original
    output[profile.album_visibility_function : profile.album_visibility_function_end] = b"\x00" * 82
    core__write_far_goto(
        output, profile.album_visibility_function, universal__ALBUM_VISIBILITY_CAVE
    )


def universal__patch_attribute_jogress_universal(
    output: bytearray, source: bytes, layout: RomLayout, target_count: int
) -> None:
    profile = layout.profile
    if universal___read_metadata(source):
        original_rows = [
            [
                core__read_u16(source, universal__JOGRESS_ROWS + source_id * 8 + i * 2)
                for i in range(4)
            ]
            for source_id in range(profile.stock_roster_count)
        ]
    else:
        original_rows = core__read_original_jogress_rows(source)
    output[universal__JOGRESS_POINTER_TABLE:universal__JOGRESS_SPECIAL_DATA] = b"\x00" * (
        universal__JOGRESS_SPECIAL_DATA - universal__JOGRESS_POINTER_TABLE
    )
    core__write_u16(
        output, profile.jogress_pointer_load_site, universal__JOGRESS_POINTER_TABLE // 2 & 65535
    )
    core__write_immediate6(output, profile.jogress_stage_mismatch_site, target_count)
    for source_id in range(target_count):
        row_off = universal__JOGRESS_ROWS + source_id * 8
        runtime_pointer = 2097152 + row_off // 2
        core__write_u32(output, universal__JOGRESS_POINTER_TABLE + source_id * 4, runtime_pointer)
        if source_id < profile.stock_roster_count:
            values = [
                target_count if x in (profile.stock_roster_count, 65535) else x
                for x in original_rows[source_id]
            ]
        else:
            values = [target_count] * 4
        for i, value in enumerate(values):
            core__write_u16(output, row_off + i * 2, value)


def universal__project_to_dict(project: core.Project, profile_version: int) -> dict[str, Any]:
    return {
        "format": universal__PROJECT_FORMAT,
        "app_version": universal__APP_VERSION,
        "profile_version": profile_version,
        "base_rom": project.rom_files.get("vanilla", ""),
        "slots": [
            {
                "id": s.digimon_id,
                "name": s.name,
                "stats": s.stats,
                "frames": [asdict(f) for f in s.frames],
                "evolution": {
                    "enabled": s.evolution.enabled,
                    "source_id": s.evolution.source_id,
                    "conditions": [asdict(c) for c in s.evolution.conditions],
                },
            }
            for s in project.slots
        ],
    }


def universal__read_images_flexible(
    data: bytes, count: int, size_table: int
) -> list[core__RomImage]:
    if core__detect_image_count(data) != count:
        raise ValueError(f"이미지 수 불일치: ROM={core__detect_image_count(data)}, 기대={count}")
    images: list[core__RomImage] = []
    minimum_start = universal__FLASH_BANK1 + count * 4
    previous = minimum_start
    for i in range(count):
        rel = core__read_u32(data, universal__FLASH_BANK1 + i * 4)
        w = core__read_u16(data, size_table + i * 4)
        h = core__read_u16(data, size_table + i * 4 + 2)
        if not (1 <= w <= 256 and 1 <= h <= 256):
            raise ValueError(f"이미지 {i}: 크기 오류 {w}x{h}")
        start = universal__FLASH_BANK1 + rel
        end = start + w * h * 2
        if start < minimum_start or end > len(data):
            raise ValueError(f"이미지 {i}: 범위 오류 {start:#x}..{end:#x}")
        if start < previous:
            raise ValueError(f"이미지 {i}: 포인터 순서 오류")
        if start < universal__SAVE_TAIL_END and end > universal__SAVE_TAIL_START:
            raise ValueError(f"이미지 {i}: 저장 영역 침범")
        images.append(core__RomImage(w, h, data[start:end]))
        previous = end
    return images


def universal__save_universal_project(
    project: core.Project, profile_version: int, path: Path
) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    obj = universal__project_to_dict(project, profile_version)
    base = Path(obj["base_rom"])
    if base.is_absolute():
        try:
            obj["base_rom"] = os.path.relpath(base, path.parent).replace("\\", "/")
        except ValueError:
            pass
    path.write_text(json.dumps(obj, ensure_ascii=False, indent=2), encoding="utf-8")
    project.project_path = path


def universal__write_images_universal(
    data: bytearray, images: list[core.RomImage], extended: bool
) -> tuple[int, Optional[int]]:
    count = len(images)
    cursor = universal__FLASH_BANK1 + count * 4
    data[universal__FLASH_BANK1:universal__SAVE_TAIL_START] = b"\x00" * (
        universal__SAVE_TAIL_START - universal__FLASH_BANK1
    )
    if extended:
        data[universal__SAVE_TAIL_END:] = b"\xff" * (len(data) - universal__SAVE_TAIL_END)
    data[universal__RELOCATED_SIZE_TABLE : universal__RELOCATED_SIZE_TABLE + count * 4] = (
        b"\x00" * (count * 4)
    )
    upper_start: Optional[int] = None
    for i, image in enumerate(images):
        size = len(image.pixels)
        if cursor < universal__SAVE_TAIL_END and cursor + size > universal__SAVE_TAIL_START:
            if not extended:
                raise ValueError(f"표준 8 MiB 이미지 공간 초과: 이미지 {i}에서 저장영역과 겹칩니다")
            cursor = universal__SAVE_TAIL_END
            upper_start = cursor
        end = cursor + size
        if end > len(data):
            raise ValueError(f"이미지 {i} 기록 중 ROM 용량 초과: {end:#x} > {len(data):#x}")
        core__write_u32(data, universal__FLASH_BANK1 + i * 4, cursor - universal__FLASH_BANK1)
        core__write_u16(data, universal__RELOCATED_SIZE_TABLE + i * 4, image.width)
        core__write_u16(data, universal__RELOCATED_SIZE_TABLE + i * 4 + 2, image.height)
        data[cursor:end] = image.pixels
        cursor = end
    return (cursor, upper_start)


def universal__write_metadata(
    output: bytearray, profile: UniversalProfile, target_count: int, image_count: int, mode: str
) -> None:
    payload = json.dumps(
        {
            "format": universal__PROJECT_FORMAT,
            "app_version": universal__APP_VERSION,
            "profile_version": profile.version,
            "profile_label": profile.label,
            "roster_count": target_count,
            "image_count": image_count,
            "stat_table": universal__FINAL_STAT_TABLE,
            "size_table": universal__RELOCATED_SIZE_TABLE,
            "mode": mode,
        },
        ensure_ascii=False,
        separators=(",", ":"),
    ).encode("utf-8")
    if len(payload) + len(universal__METADATA_MAGIC) + 4 > universal__METADATA_SIZE:
        raise ValueError("ROM 메타데이터 공간 초과")
    output[universal__METADATA_OFFSET : universal__METADATA_OFFSET + universal__METADATA_SIZE] = (
        b"\x00" * universal__METADATA_SIZE
    )
    output[
        universal__METADATA_OFFSET : universal__METADATA_OFFSET + len(universal__METADATA_MAGIC)
    ] = universal__METADATA_MAGIC
    core__write_u32(
        output, universal__METADATA_OFFSET + len(universal__METADATA_MAGIC), len(payload)
    )
    start = universal__METADATA_OFFSET + len(universal__METADATA_MAGIC) + 4
    output[start : start + len(payload)] = payload


class universal__UniversalEditorGUI(core__EditorGUI):

    def __init__(self, root: Any, initial_project: Optional[Path] = None) -> None:
        self.profile: Optional[universal__UniversalProfile] = None
        self.layout: Optional[universal__RomLayout] = None
        universal__activate(universal__PROFILES[1], universal__PROJECT_ROSTER_COUNT)
        super().__init__(root, initial_project=None)
        self.root.title(f"PenC0–PenC5 통합 로스터 편집기 V{universal__APP_VERSION}")
        self._retitle_roster_label()
        if initial_project:
            self.open_project(initial_project)
        else:
            self.update_status("파일 → PenC ROM 열기에서 PenC0~PenC5 ROM을 선택하십시오")


    def _open_rom(self, path: Path) -> None:
        project, data, images, layout = universal__create_project_from_rom(path.resolve())
        self.profile, self.layout = (layout.profile, layout)
        universal__activate(self.profile, universal__PROJECT_ROSTER_COUNT)
        globals()["core__ORIGINAL_STAT_TABLE"] = layout.stat_table
        self.project = project
        self.vanilla = data
        self.base_images = images
        self.rom_paths = {"vanilla": path.resolve()}
        self.dirty = False
        self.refresh_roster()
        self.select_slot(0)
        self.root.title(
            f"{layout.profile.label} 통합 로스터 편집기 V{universal__APP_VERSION} - {path.name}"
        )
        self.update_status(
            f"{layout.profile.label} 직접 편집 | 입력 {layout.roster_count}마리 / 프로젝트 63슬롯"
        )


    def build_rom_action(self) -> None:
        self.build_rom_mode(False)


    def new_project(self, auto: bool = False, rom_path: Optional[Path] = None) -> None:
        if auto:
            return
        if rom_path:
            self._open_rom(Path(rom_path))
        else:
            self.open_rom_dialog()


    def open_project_dialog(self) -> None:
        from tkinter import filedialog

        if self.dirty and (not self.confirm_discard()):
            return
        chosen = filedialog.askopenfilename(
            title="통합 프로젝트 열기",
            filetypes=[("PenC 프로젝트", "*.json"), ("모든 파일", "*.*")],
        )
        if chosen:
            self.open_project(Path(chosen))

    def open_rom_dialog(self) -> None:
        from tkinter import filedialog

        if self.dirty and (not self.confirm_discard()):
            return
        chosen = filedialog.askopenfilename(
            title="PenC0~PenC5 ROM 열기", filetypes=[("PenC ROM", "*.bin"), ("모든 파일", "*.*")]
        )
        if chosen:
            try:
                self._open_rom(Path(chosen))
            except Exception as exc:
                self.show_error("ROM 열기 실패", exc)

    def refresh_roster(self) -> None:
        if self.project is None:
            return
        for item in self.roster_tree.get_children():
            self.roster_tree.delete(item)
        stock = self.profile.stock_roster_count if self.profile else core__ORIGINAL_ROSTER_COUNT
        for slot in self.project.slots:
            if slot.digimon_id < stock:
                kind = "기존"
            elif slot.digimon_id < universal__STANDARD_ROSTER_COUNT:
                kind = "8MB"
            else:
                kind = "16MB"
            self.roster_tree.insert(
                "",
                "end",
                iid=str(slot.digimon_id),
                values=(f"{slot.digimon_id:02d}", slot.name, kind),
            )
        choices = [f"{s.digimon_id:02d}  {s.name}" for s in self.project.slots]
        self.clone_slot_combo["values"] = choices
        self.evo_source_combo["values"] = choices
        if str(self.current_id) in self.roster_tree.get_children():
            self.roster_tree.selection_set(str(self.current_id))

    def reload_references(self) -> None:
        from tkinter import filedialog

        if self.project is None or self.profile is None:
            return
        chosen = filedialog.askopenfilename(
            title="동일 버전 기반 ROM 다시 선택", filetypes=[("PenC ROM", "*.bin")]
        )
        if not chosen:
            return
        try:
            data = Path(chosen).read_bytes()
            layout = universal__identify_layout(data)
            if layout.profile.version != self.profile.version:
                raise ValueError(
                    f"현재 프로젝트는 {self.profile.label}, 선택 ROM은 {layout.profile.label}입니다"
                )
            images = universal__read_images_flexible(data, layout.image_count, layout.size_table)
            self.vanilla, self.base_images, self.layout = (data, images, layout)
            self.project.rom_files["vanilla"] = str(Path(chosen).resolve())
            self.rom_paths = {"vanilla": Path(chosen).resolve()}
            self.refresh_sprite_previews()
            self.dirty = True
            self.update_status(f"기반 ROM 교체: {Path(chosen).name}")
        except Exception as exc:
            self.show_error("기반 ROM 교체 실패", exc)

    def save_project_action(self, save_as: bool = False) -> None:
        from tkinter import filedialog

        if self.project is None or self.profile is None:
            return
        try:
            self.commit_current_slot()
            core__validate_project(self.project)
            path = self.project.project_path
            if save_as or path is None:
                chosen = filedialog.asksaveasfilename(
                    title="통합 프로젝트 저장",
                    defaultextension=".json",
                    filetypes=[("PenC 통합 프로젝트", "*.json")],
                    initialfile=f"PenC{self.profile.version}_63_project.json",
                )
                if not chosen:
                    return
                path = Path(chosen)
            universal__save_universal_project(self.project, self.profile.version, path)
            self.dirty = False
            self.update_status(f"프로젝트 저장: {path.name}")
        except Exception as exc:
            self.show_error("프로젝트 저장 실패", exc)


import argparse, copy, json, os, struct, sys, traceback
from dataclasses import asdict
from pathlib import Path
from typing import Any, Optional

relocation__APP_VERSION = "3.1.0"
relocation__PROJECT_FORMAT = "PenCUniversalProject\x568"
relocation__PROJECT_ROSTER_COUNT = 266
relocation__STANDARD_ROSTER_COUNT = 114
relocation__EXTENDED_ROSTER_COUNT = 266
relocation__STOCK_ROM_SIZE = 8388608
relocation__EXTENDED_ROM_SIZE = 16777216
relocation__FLASH_BANK1 = 4194304
relocation__BANK0_IMAGE_START = 397312
relocation__SAVE_TAIL_START = 8376320
relocation__SAVE_TAIL_END = 8388608
relocation__METADATA_OFFSET = 167424
relocation__METADATA_SIZE = 4096
relocation__METADATA_MAGIC = b"PCU\x568M01"
relocation__PATCH_CAVE_START = 171520
relocation__PATCH_CAVE_END = 176128
relocation__TABLE_AREA_END = 262144
relocation__ACQUIRED_RAM_BASE = 10144
relocation__VISIBLE_RAM_BASE = 10176
relocation__PROFILES = universal__PROFILES
relocation__RomLayout = universal__RomLayout


def relocation__align(v: int, a: int = 32) -> int:
    return v + a - 1 & ~(a - 1)


def relocation__activate(
    profile: UniversalProfile, target_count: int, tl: Optional[dict[str, int]] = None
) -> None:
    if target_count < profile.stock_roster_count or target_count > relocation__PROJECT_ROSTER_COUNT:
        raise ValueError(f"로스터 수 범위 오류: {target_count}")
    tl = tl or relocation__table_layout(profile, target_count)
    globals()["core__ROSTER_COUNT"] = target_count
    globals()["core__MAX_ID"] = target_count - 1
    globals()["core__ORIGINAL_ROSTER_COUNT"] = profile.stock_roster_count
    globals()["core__ADDED_ROSTER_COUNT"] = target_count - profile.stock_roster_count
    globals()["core__VANILLA_IMAGE_COUNT"] = profile.stock_image_count
    globals()["core__FINAL_IMAGE_COUNT"] = tl["image_count"]
    globals()["core__NO_RESULT_ID"] = target_count
    globals()["core__ORIGINAL_SIZE_TABLE"] = profile.stock_size_table
    globals()["core__RELOCATED_SIZE_TABLE"] = tl["size"]
    globals()["core__ORIGINAL_STAT_TABLE"] = 131390
    globals()["core__FINAL_STAT_TABLE"] = tl["stat"]
    globals()["core__STAT_LOOKUP_SITE"] = profile.stat_lookup_site
    globals()["core__CUTIN_FLAG"] = 171504
    globals()["core__METADATA_OFFSET"] = relocation__METADATA_OFFSET
    globals()["core__METADATA_SIZE"] = relocation__METADATA_SIZE
    globals()["core__ALBUM_HOOK"] = profile.album_cursor_hook
    globals()["core__ALBUM_RETURN"] = profile.album_cursor_return
    globals()["core__EVO_HOOK"] = profile.evolution_hook
    globals()["core__EVO_HOOK_RETURN"] = profile.evolution_return
    globals()["core__EVO_RESULT_RETURN"] = profile.evolution_result_return
    globals()["core__EVO_CAVE"] = tl["evo"]
    globals()["core__EVO_CAVE_END"] = tl["evo_end"]
    globals()["core__JOGRESS_STAGE_MISMATCH_SITE"] = profile.jogress_stage_mismatch_site
    globals()["core__JOGRESS_POINTER_LOAD_SITE"] = profile.jogress_pointer_load_site
    globals()["core__JOGRESS_POINTER_TABLE"] = tl["jog_ptr"]
    globals()["core__JOGRESS_ROWS"] = tl["jog_rows"]
    globals()["core__ROSTER_MAX_OFFSETS"] = list(profile.roster_max_offsets)
    globals()["core__IMAGE_MAX_OFFSETS"] = list(profile.image_max_offsets)
    globals()["core__SIZE_TABLE_ADDRESS_SITES"] = list(profile.size_table_sites)
    globals()["core__EXPECTED_SHA256"] = profile.stock_sha256
    globals()["core__DEFAULT_NEW_SLOT_TEMPLATE_ID"] = profile.stock_roster_count - 1


def relocation__create_project_from_rom(path: Path):
    data = path.read_bytes()
    layout = relocation__identify_layout(data)
    relocation__activate(layout.profile, relocation__PROJECT_ROSTER_COUNT)
    images = relocation__read_images_flexible(data, layout.image_count, layout.size_table)
    slots = []
    current = min(layout.roster_count, relocation__PROJECT_ROSTER_COUNT)
    for did in range(current):
        stats = core__read_stat_words(data, did, layout.stat_table)
        start = stats[0]
        frames = [core__FrameRef("base", start + i) for i in range(12)]
        name = (
            core__DEFAULT_DISPLAY_NAMES[did]
            if layout.profile.version == 1 and did < len(core__DEFAULT_DISPLAY_NAMES)            else f"VP{layout.profile.version} ID {did:03d}"
        )
        slots.append(core__DigimonSlot(did, name, stats, frames, core__EvolutionRoute()))
    tid = max(0, current - 1)
    ts = list(slots[tid].stats)
    tf = copy.deepcopy(slots[tid].frames)
    for did in range(current, relocation__PROJECT_ROSTER_COUNT):
        st = list(ts)
        st[core__ALBUM_ORDER_STAT_INDEX] = did
        st[core__ALBUM_VISIBLE_STAT_INDEX] = 1
        slots.append(
            core__DigimonSlot(
                did,
                f"추가 슬롯 {did:03d}",
                st,
                copy.deepcopy(tf),
                core__EvolutionRoute(False, 0, []),
            )
        )
    pr = core__Project(
        slots=slots,
        rom_files={"vanilla": str(path.resolve()), "profile_version": str(layout.profile.version)},
    )
    return (pr, data, images, layout)


def relocation__decode_image_address(rel: int) -> int:
    return relocation__FLASH_BANK1 + rel & 4294967295


def relocation__far_target(data: bytes | bytearray, off: int) -> Optional[int]:
    a = core__read_u16(data, off)
    b = core__read_u16(data, off + 2)
    if a & 65534 != 65184:
        return None
    return ((a & 1) << 16 | b) * 2


def relocation__identify_layout(data: bytes) -> relocation__RomLayout:
    if len(data) not in (relocation__STOCK_ROM_SIZE, relocation__EXTENDED_ROM_SIZE):
        raise ValueError("8 MiB 또는 16 MiB ROM만 지원합니다")
    m = relocation__read_meta(data)
    if m and m.get("format") in (
        relocation__PROJECT_FORMAT,
        "PenCUniversalProject\x567",
        universal__PROJECT_FORMAT,
    ):
        p = relocation__PROFILES[int(m["profile_version"])]
        return relocation__RomLayout(
            p,
            int(m["roster_count"]),
            int(m["image_count"]),
            int(m["stat_table"]),
            int(m["size_table"]),
            str(m.get("mode", "patched")),
        )
    if len(data) != relocation__STOCK_ROM_SIZE:
        raise ValueError("메타데이터 없는 16 MiB ROM은 판별할 수 없습니다")
    d = core__detect_penc_profile(data)
    p = relocation__PROFILES[d.version]
    return relocation__RomLayout(
        p, p.stock_roster_count, p.stock_image_count, 131390, p.stock_size_table, "stock"
    )


def relocation__image_count_for(profile: UniversalProfile, count: int) -> int:
    return (
        profile.stock_image_count + (count - profile.stock_roster_count) * core__FRAMES_PER_DIGIMON
    )


def relocation__load_project(path: Path):
    obj = json.loads(path.read_text(encoding="utf-8"))
    if obj.get("format") != relocation__PROJECT_FORMAT:
        if obj.get("format") in ("PenCUniversalProject\x567", universal__PROJECT_FORMAT):
            version = int(obj["profile_version"])
            base = Path(obj.get("base_rom", ""))
            if not base.is_absolute():
                base = (path.parent / base).resolve()
            pr, data, imgs, layout = relocation__create_project_from_rom(base)
            loaded = [core__DigimonSlot.from_dict(x) for x in obj.get("slots", [])]
            for i, s in enumerate(loaded[:relocation__PROJECT_ROSTER_COUNT]):
                pr.slots[i] = s
            pr.project_path = path
            return (pr, data, imgs, layout)
        legacy = core__load_project(path)
        base = Path(legacy.rom_files.get("vanilla", "PenC1.bin"))
        if not base.is_absolute():
            base = (path.parent / base).resolve()
        pr, data, imgs, layout = relocation__create_project_from_rom(base)
        for i, s in enumerate(legacy.slots[:relocation__PROJECT_ROSTER_COUNT]):
            pr.slots[i] = s
        pr.project_path = path
        return (pr, data, imgs, layout)
    version = int(obj["profile_version"])
    base = Path(obj.get("base_rom", ""))
    if not base.is_absolute():
        base = (path.parent / base).resolve()
    pr, data, imgs, layout = relocation__create_project_from_rom(base)
    if layout.profile.version != version:
        raise ValueError("프로젝트와 기반 ROM 버전이 다릅니다")
    for i, s in enumerate(
        [core__DigimonSlot.from_dict(x) for x in obj.get("slots", [])][
            :relocation__PROJECT_ROSTER_COUNT
        ]
    ):
        pr.slots[i] = s
    pr.project_path = path
    pr.rom_files = {"vanilla": str(base), "profile_version": str(version)}
    return (pr, data, imgs, layout)


def relocation__project_to_dict(project: core.Project, profile_version: int) -> dict[str, Any]:
    return {
        "format": relocation__PROJECT_FORMAT,
        "app_version": relocation__APP_VERSION,
        "profile_version": profile_version,
        "base_rom": project.rom_files.get("vanilla", ""),
        "slots": [
            {
                "id": s.digimon_id,
                "name": s.name,
                "stats": s.stats,
                "frames": [asdict(f) for f in s.frames],
                "evolution": {
                    "enabled": s.evolution.enabled,
                    "source_id": s.evolution.source_id,
                    "conditions": [asdict(c) for c in s.evolution.conditions],
                },
            }
            for s in project.slots
        ],
    }


def relocation__read_images_flexible(
    data: bytes, count: int, size_table: int
) -> list[core__RomImage]:
    if core__detect_image_count(data) != count:
        raise ValueError(f"이미지 수 불일치: {core__detect_image_count(data)} != {count}")
    out = []
    for i in range(count):
        rel = core__read_u32(data, relocation__FLASH_BANK1 + i * 4)
        start = relocation__decode_image_address(rel)
        w = core__read_u16(data, size_table + i * 4)
        h = core__read_u16(data, size_table + i * 4 + 2)
        end = start + w * h * 2
        if not (1 <= w <= 256 and 1 <= h <= 256 and (0 <= start < end <= len(data))):
            raise ValueError(f"이미지 {i} 범위/크기 오류: {start:#x} {w}x{h}")
        if start < relocation__SAVE_TAIL_END and end > relocation__SAVE_TAIL_START:
            raise ValueError(f"이미지 {i}가 저장영역을 침범합니다")
        out.append(core__RomImage(w, h, data[start:end]))
    return out


def relocation__read_meta(data: bytes) -> Optional[dict[str, Any]]:
    for magic in (relocation__METADATA_MAGIC, b"PCU\x567M01", universal__METADATA_MAGIC):
        if data[relocation__METADATA_OFFSET : relocation__METADATA_OFFSET + len(magic)] == magic:
            n = core__read_u32(data, relocation__METADATA_OFFSET + len(magic))
            if 0 < n < relocation__METADATA_SIZE - len(magic) - 4:
                try:
                    return json.loads(
                        data[
                            relocation__METADATA_OFFSET
                            + len(magic)
                            + 4 : relocation__METADATA_OFFSET
                            + len(magic)
                            + 4
                            + n
                        ].decode("utf-8")
                    )
                except Exception:
                    return None
    return None


def relocation__save_project(project: core.Project, profile_version: int, path: Path) -> None:
    obj = relocation__project_to_dict(project, profile_version)
    base = Path(obj["base_rom"])
    if base.is_absolute():
        try:
            obj["base_rom"] = os.path.relpath(base, path.parent).replace("\\", "/")
        except ValueError:
            pass
    path.write_text(json.dumps(obj, ensure_ascii=False, indent=2), encoding="utf-8")
    project.project_path = path


def relocation__table_layout(profile: UniversalProfile, target_count: int) -> dict[str, int]:
    image_count = relocation__image_count_for(profile, target_count)
    stat = 176128
    jog_ptr = relocation__align(stat + target_count * core__STAT_RECORD_SIZE)
    jog_rows = relocation__align(jog_ptr + target_count * 4)
    size = relocation__align(jog_rows + target_count * 8)
    evo = relocation__align(size + image_count * 4)
    if evo >= relocation__TABLE_AREA_END:
        raise ValueError(f"패치 테이블 영역 초과: evolution start {evo:#x}")
    return {
        "stat": stat,
        "jog_ptr": jog_ptr,
        "jog_rows": jog_rows,
        "size": size,
        "evo": evo,
        "evo_end": relocation__TABLE_AREA_END,
        "image_count": image_count,
    }


class relocation__Cave:

    def __init__(self, out: bytearray):
        self.out = out
        self.cur = relocation__PATCH_CAVE_START

    def put(self, words: list[int], align_words: int = 1) -> int:
        self.cur = relocation__align(self.cur, align_words * 2)
        start = self.cur
        blob = struct.pack("<" + "H" * len(words), *words)
        if start + len(blob) > relocation__PATCH_CAVE_END:
            raise ValueError("트램펄린 cave 초과")
        self.out[start : start + len(blob)] = blob
        self.cur += len(blob)
        return start


def relocation__cmp16_word(reg: int) -> int:
    return 4 << 12 | reg << 9 | 4 << 6 | 1 << 3 | reg


def relocation__album_bit_test_target(source: bytes, profile: UniversalProfile) -> int:
    meta = relocation__read_meta(source) or {}
    if meta.get("album_bit_test_target") is not None:
        return int(meta["album_bit_test_target"])
    fn = relocation__original_album_function_bytes(source, profile)
    if len(fn) != 82:
        raise ValueError("원본 앨범 표시 함수 확보 실패")
    w0, w1 = struct.unpack_from("<HH", fn, 68)
    return relocation__call_target_from_words(w0, w1)


def relocation__branch_positive(cond: int, dist: int) -> int:
    return cond << 12 | 7 << 9 | dist & 63


def relocation__branch_target(off: int, w: int) -> int:
    dist = w & 63
    neg = w >> 6 & 7 == 1
    nxt = off + 2
    return nxt - dist * 2 if neg else nxt + dist * 2


def relocation__build_album_visibility_function(
    profile: UniversalProfile, max_id: int, visible_base: int, bit_test_raw: int
) -> list[int]:

    stat_call = universal___call_words_for_raw(profile.stat_lookup_function)
    bit_call = universal___call_words_for_raw(bit_test_raw)
    w: list[int] = []
    w += [55944, 8258, 2824, 1, 38976, 55296]
    w += [8258, 38405, 2312, 1, 54980, 38478, 2312, 2, 54980, stat_call[0], stat_call[1], 66, 16960]
    je_to_order_index = len(w)
    w.append(0)
    w += [38977, 55296]
    jmp_epilogue_index = len(w)
    w.append(0)
    order_lookup_index = len(w)
    w += [
        8258,
        38405,
        2312,
        1,
        54980,
        38477,
        2312,
        2,
        54980,
        stat_call[0],
        stat_call[1],
        66,
        53761,
        38913,
        relocation__cmp16_word(4),
        max_id,
    ]
    ja_epilogue_index = len(w)
    w.append(0)
    w += [
        8259,
        relocation__mov16_word(2),
        visible_base,
        38464,
        2312,
        1,
        54484,
        54980,
        38401,
        2312,
        3,
        54980,
        bit_call[0],
        bit_call[1],
        67,
        53760,
    ]
    epilogue_index = len(w)
    w += [37376, 66, 39064]
    w[je_to_order_index] = relocation__local_branch(5, order_lookup_index - (je_to_order_index + 1))
    w[jmp_epilogue_index] = relocation__local_branch(14, epilogue_index - (jmp_epilogue_index + 1))
    w[ja_epilogue_index] = relocation__local_branch(9, epilogue_index - (ja_epilogue_index + 1))
    return w


def relocation__build_evolution_wide(
    slots: list[core.DigimonSlot], profile: UniversalProfile, tl: dict[str, int]
) -> tuple[bytes, dict[str, Any]]:
    words = []
    reports = []
    for slot in slots:
        r = slot.evolution
        if not r.enabled:
            continue
        start = len(words)
        placeholders = []
        words += [38912, relocation__cmp16_word(4), r.source_id]
        placeholders.append((len(words), 78))
        words.append(0)
        real = [c for c in r.conditions if c.kind != 0]
        for c in real:
            c.validate()
            words += [
                65024,
                39180,
                core__CONDITION_STAT_ADDRESS[c.kind],
                39140,
                relocation__cmp16_word(4),
                c.value,
            ]
            placeholders.append((len(words), core__OPERATOR_INVERSE_BRANCH_HIGH[c.operator]))
            words.append(0)
        words += [relocation__mov16_word(4), slot.digimon_id, 55296]
        words += list(core__far_goto_words(profile.evolution_result_return))
        end = len(words)
        for idx, hi in placeholders:
            dist = end - (idx + 1)
            if dist > 255:
                raise ValueError(f"ID {slot.digimon_id} 진화 경로가 너무 깁니다")
            words[idx] = hi << 8 | dist
        reports.append(
            {"result_id": slot.digimon_id, "source_id": r.source_id, "conditions": len(real)}
        )
    words += [65024, 39180, 2086]
    words += list(core__far_goto_words(profile.evolution_return))
    blob = struct.pack("<" + "H" * len(words), *words)
    cap = tl["evo_end"] - tl["evo"]
    if len(blob) > cap:
        raise ValueError(f"진화 코드 공간 초과 {len(blob)}/{cap}")
    return (
        blob,
        {
            "enabled_routes": len(reports),
            "bytes_used": len(blob),
            "bytes_capacity": cap,
            "bytes_free": cap - len(blob),
        },
    )


def relocation__build_rom(
    project: core.Project, source: bytes, layout: RomLayout, target: int, extended: bool
):
    p = layout.profile
    tl = relocation__table_layout(p, target)
    relocation__activate(p, target, tl)
    bp = core__Project(
        slots=copy.deepcopy(project.slots[:target]), rom_files=dict(project.rom_files)
    )
    core__validate_project(bp)
    srcimgs = relocation__read_images_flexible(source, layout.image_count, layout.size_table)
    out = bytearray(
        b"\xff" * (relocation__EXTENDED_ROM_SIZE if extended else relocation__STOCK_ROM_SIZE)
    )
    out[:relocation__STOCK_ROM_SIZE] = source[:relocation__STOCK_ROM_SIZE]
    save = bytes(source[relocation__SAVE_TAIL_START:relocation__SAVE_TAIL_END])
    out[relocation__METADATA_OFFSET:relocation__TABLE_AREA_END] = b"\x00" * (
        relocation__TABLE_AREA_END - relocation__METADATA_OFFSET
    )
    final = list(srcimgs[: p.stock_image_count])
    statslist = []
    for s in bp.slots:
        st = list(s.stats)
        if s.digimon_id < p.stock_roster_count:
            start = 240 + s.digimon_id * 12
            st[0] = start
            if s.digimon_id < layout.roster_count:
                st[core__ALBUM_ORDER_STAT_INDEX] = core__read_stat_words(
                    source, s.digimon_id, layout.stat_table
                )[core__ALBUM_ORDER_STAT_INDEX]
            for j, r in enumerate(s.frames):
                final[start + j] = core__resolve_frame(r, srcimgs)
        else:
            start = p.stock_image_count + (s.digimon_id - p.stock_roster_count) * 12
            st[0] = start
            st[core__ALBUM_ORDER_STAT_INDEX] = s.digimon_id
            final.extend((core__resolve_frame(r, srcimgs) for r in s.frames))
        statslist.append(st)
    if len(final) != tl["image_count"]:
        raise AssertionError("image count")
    img_report = relocation__write_images_relocated(out, final, extended)
    for i, img in enumerate(final):
        core__write_u16(out, tl["size"] + i * 4, img.width)
        core__write_u16(out, tl["size"] + i * 4 + 2, img.height)
    for s, st in zip(bp.slots, statslist):
        core__write_stat_words(out, s.digimon_id, st, tl["stat"])
    core__write_u16(out, p.stat_lookup_site, tl["stat"] // 2 & 65535)
    relocation__patch_size_table_sites(out, p, tl["size"])
    for off in p.image_max_offsets:
        core__write_u16(out, off, tl["image_count"] - 1)
    cave = relocation__Cave(out)
    ram_report = relocation__patch_album_ram(out, source, target, cave)
    for off in p.roster_max_offsets:
        relocation__patch_wide_compare(out, off, target - 1, cave, source)
    album_info = relocation__patch_album_visibility(out, source, p, target - 1, cave)
    album_cursor = relocation__patch_album_cursor(out, p, target, cave)
    evo, evo_report = relocation__build_evolution_wide(bp.slots, p, tl)
    out[tl["evo"] : tl["evo_end"]] = b"\x00" * (tl["evo_end"] - tl["evo"])
    out[tl["evo"] : tl["evo"] + len(evo)] = evo
    core__write_far_goto(out, p.evolution_hook, tl["evo"])
    relocation__patch_jogress(out, source, layout, target, tl, cave)
    extra = {**ram_report, **album_info, "album_cursor": album_cursor}
    relocation__write_meta(
        out, p, target, tl, "extended16-relocated" if extended else "standard8-relocated", extra
    )
    if out[relocation__SAVE_TAIL_START:relocation__SAVE_TAIL_END] != save:
        raise AssertionError("save tail changed")
    report = {
        "format": "PenC Universal Editor \x568 build report",
        "app_version": relocation__APP_VERSION,
        "profile": p.label,
        "mode": "16MiB/266" if extended else "8MiB/114",
        "rom_size": len(out),
        "roster_count": target,
        "max_id": target - 1,
        "no_result_id": target,
        "total_image_count": tl["image_count"],
        "tables": tl,
        "images": img_report,
        "wide_limit_sites": len(p.roster_max_offsets),
        "album_ram": ram_report,
        "evolution": evo_report,
        "save_tail_preserved": True,
        "source_sha256": core__sha256(source),
        "output_sha256": core__sha256(out),
        "warning": "\x568 replaces the unstable wrapper/copy album path with one balanced function. ID>63 persistence and wrapped bank0 image pointers still require real-device validation.",
    }
    return (bytes(out), report)


def relocation__call_target_from_words(w0: int, w1: int) -> int:
    if w0 & 65472 not in (61504, 61536):
        raise ValueError(f"far call opcode가 아닙니다: {w0:04X} {w1:04X}")
    word_address = (w0 & 63) << 16 | w1
    raw = (word_address - 2097152) * 2
    if raw < 0:
        raise ValueError(f"call target 범위 오류: {word_address:#x}")
    return raw


def relocation__clear_words_code(base: int, count: int, resume: int) -> list[int]:
    words = [38464]
    for a in range(base, base + count):
        words += [65024, 39180, a, 55012]
    words += list(core__far_goto_words(resume))
    return words


def relocation__find_clear(data: bytes, base: int) -> tuple[int, int]:
    # Four native word stores occupy 11 words (22 bytes). A 24-byte resume
    # skips the following instruction: the loop-counter reset for visibility,
    # or SP -= 3 for acquisition. The latter corrupts a fresh-save call frame.
    pat = struct.pack(
        "<11H", 0x9440, 0x9640, 0xFE00, 0x990C, base, 0x9240, 0xD2F4, 0x9240, 0xD2F4, 0xD4F4, 0xD6E4
    )
    i = data.find(pat)
    if i < 0:
        raise ValueError(f"RAM {base:#x} clear sequence not found")
    return (i, i + len(pat))


def relocation__local_branch(cond: int, distance_words: int) -> int:
    if not 0 <= distance_words <= 63:
        raise ValueError(f"local branch 거리 초과: {distance_words}")
    return cond << 12 | 7 << 9 | distance_words


def relocation__mov16_word(reg: int) -> int:
    return 9 << 12 | reg << 9 | 4 << 6 | 1 << 3 | reg


def relocation__original_album_function_bytes(source: bytes, profile: UniversalProfile) -> bytes:
    meta = relocation__read_meta(source) or {}
    if meta.get("album_bit_test_target") is not None:
        return b""
    oldcopy = meta.get("album_original_copy")
    if oldcopy is not None:
        a = int(oldcopy)
        return bytes(source[a : a + 82])
    return bytes(source[profile.album_visibility_function : profile.album_visibility_function_end])


def relocation__original_jog_rows(source: bytes, layout: RomLayout) -> list[list[int]]:
    m = relocation__read_meta(source)
    if m and m.get("jogress_rows") is not None:
        base = int(m["jogress_rows"])
        return [
            [core__read_u16(source, base + i * 8 + j * 2) for j in range(4)]
            for i in range(layout.profile.stock_roster_count)
        ]
    return core__read_original_jogress_rows(source)


def relocation__patch_album_cursor(
    out: bytearray, profile: UniversalProfile, count: int, cave: Cave
) -> int:
    g = core__far_goto_words(profile.album_cursor_return)
    addr = cave.put([2113, relocation__cmp16_word(4), count, 19969, 38976, g[0], g[1]])
    core__write_far_goto(out, profile.album_cursor_hook, addr)
    return addr


def relocation__patch_album_ram(
    out: bytearray, source: bytes, target_count: int, cave: Cave
) -> dict[str, Any]:
    words = (target_count + 15) // 16
    meta = relocation__read_meta(source) or {}
    old_a = int(meta.get("acquired_ram_base", 2127))
    old_v = int(meta.get("visible_ram_base", 2131))
    repl_a = repl_v = 0
    for off in range(0, 139264, 2):
        w = core__read_u16(out, off)
        if w == old_a:
            core__write_u16(out, off, relocation__ACQUIRED_RAM_BASE)
            repl_a += 1
        elif w == old_v:
            core__write_u16(out, off, relocation__VISIBLE_RAM_BASE)
            repl_v += 1
    if meta.get("acquired_clear_start") is not None:
        acs = int(meta["acquired_clear_start"])
        ac_resume = int(meta["acquired_clear_resume"])
        vcs = int(meta["visible_clear_start"])
        vc_resume = int(meta["visible_clear_resume"])
    else:
        acs, ac_resume = relocation__find_clear(source, 2127)
        vcs, vc_resume = relocation__find_clear(source, 2131)
    ac_tr = cave.put(relocation__clear_words_code(relocation__ACQUIRED_RAM_BASE, words, ac_resume))
    core__write_far_goto(out, acs, ac_tr)
    vc_tr = cave.put(relocation__clear_words_code(relocation__VISIBLE_RAM_BASE, words, vc_resume))
    core__write_far_goto(out, vcs, vc_tr)
    return {
        "word_count": words,
        "acquired_clear_start": acs,
        "acquired_clear_resume": ac_resume,
        "visible_clear_start": vcs,
        "visible_clear_resume": vc_resume,
        "refs_acquired": repl_a,
        "refs_visible": repl_v,
    }


def relocation__patch_album_visibility(
    out: bytearray, source: bytes, profile: UniversalProfile, max_id: int, cave: Cave
) -> dict[str, int]:
    bit_target = relocation__album_bit_test_target(source, profile)
    words = relocation__build_album_visibility_function(
        profile, max_id, relocation__VISIBLE_RAM_BASE, bit_target
    )
    impl = cave.put(words)
    core__write_far_goto(out, profile.album_visibility_function, impl)
    return {
        "album_visibility_impl": impl,
        "album_bit_test_target": bit_target,
        "album_visibility_words": len(words),
    }


def relocation__patch_jogress(
    out: bytearray, source: bytes, layout: RomLayout, count: int, tl: dict[str, int], cave: Cave
) -> None:
    rows = relocation__original_jog_rows(source, layout)
    core__write_u16(out, layout.profile.jogress_pointer_load_site, tl["jog_ptr"] // 2 & 65535)
    relocation__patch_wide_sentinel_load(
        out, layout.profile.jogress_stage_mismatch_site, count, cave, source
    )
    for sid in range(count):
        ro = tl["jog_rows"] + sid * 8
        core__write_u32(out, tl["jog_ptr"] + sid * 4, 2097152 + ro // 2)
        vals = (
            [count if x in (layout.profile.stock_roster_count, 65535) else x for x in rows[sid]]
            if sid < layout.profile.stock_roster_count
            else [count] * 4
        )
        for j, v in enumerate(vals):
            core__write_u16(out, ro + j * 2, v)


def relocation__patch_size_table_sites(
    out: bytearray, profile: UniversalProfile, address: int
) -> None:
    wa = address // 2
    low = wa & 65535
    high = wa >> 16 & 1
    for off in profile.size_table_sites:
        core__write_u16(out, off, low)
        core__write_u16(out, off + 2, 39008 | high)


def relocation__patch_wide_compare(
    out: bytearray, off: int, value: int, cave: Cave, reference: Optional[bytes] = None
) -> None:
    ref = reference if reference is not None else out
    existing = relocation__far_target(ref, off)
    if (
        existing is not None
        and relocation__PATCH_CAVE_START <= existing < relocation__PATCH_CAVE_END
    ):
        words = list(struct.unpack_from("<7H", ref, existing))
        words[1] = value
        tramp = cave.put(words)
        core__write_far_goto(out, off, tramp)
        return
    cmpw = core__read_u16(ref, off)
    br = core__read_u16(ref, off + 2)
    if cmpw >> 12 != 4 or cmpw >> 6 & 7 != 1 or br >> 9 & 7 != 7:
        raise ValueError(f"상한 비교 패턴 불일치 @{off:#x}: {cmpw:04X} {br:04X}")
    reg = cmpw >> 9 & 7
    cond = br >> 12 & 15
    target = relocation__branch_target(off + 2, br)
    fall = off + 4
    gf = core__far_goto_words(fall)
    gt = core__far_goto_words(target)
    tramp = cave.put(
        [
            relocation__cmp16_word(reg),
            value,
            relocation__branch_positive(cond, 2),
            gf[0],
            gf[1],
            gt[0],
            gt[1],
        ]
    )
    core__write_far_goto(out, off, tramp)


def relocation__patch_wide_sentinel_load(
    out: bytearray, site: int, value: int, cave: Cave, reference: Optional[bytes] = None
) -> None:
    ref = reference if reference is not None else out
    existing = relocation__far_target(ref, site)
    if (
        existing is not None
        and relocation__PATCH_CAVE_START <= existing < relocation__PATCH_CAVE_END
    ):
        words = list(struct.unpack_from("<5H", ref, existing))
        words[1] = value
        tramp = cave.put(words)
        core__write_far_goto(out, site, tramp)
        return
    w = core__read_u16(ref, site)
    reg = w >> 9 & 7
    cleanup = core__read_u16(ref, site + 2)
    ret = site + 4
    g = core__far_goto_words(ret)
    tramp = cave.put([relocation__mov16_word(reg), value, cleanup, g[0], g[1]])
    core__write_far_goto(out, site, tramp)


def relocation__write_images_relocated(
    data: bytearray, images: list[core.RomImage], extended: bool
) -> dict[str, Any]:
    count = len(images)
    regions = [
        ["bank1", relocation__FLASH_BANK1 + count * 4, relocation__SAVE_TAIL_START],
        ["bank0", relocation__BANK0_IMAGE_START, relocation__FLASH_BANK1],
    ]
    if extended:
        regions.append(["uppe\x7216", relocation__SAVE_TAIL_END, len(data)])
    data[relocation__FLASH_BANK1:relocation__SAVE_TAIL_START] = b"\x00" * (
        relocation__SAVE_TAIL_START - relocation__FLASH_BANK1
    )
    data[relocation__BANK0_IMAGE_START:relocation__FLASH_BANK1] = b"\x00" * (
        relocation__FLASH_BANK1 - relocation__BANK0_IMAGE_START
    )
    if extended:
        data[relocation__SAVE_TAIL_END:] = b"\xff" * (len(data) - relocation__SAVE_TAIL_END)
    ri = 0
    cur = regions[0][1]
    used = {r[0]: 0 for r in regions}
    first = {}
    for i, img in enumerate(images):
        sz = len(img.pixels)
        if cur + sz > regions[ri][2]:
            ri += 1
            if ri >= len(regions):
                raise ValueError(f"이미지 공간 초과: image {i}")
            cur = regions[ri][1]
        end = cur + sz
        addr = cur
        rel = addr - relocation__FLASH_BANK1 & 4294967295
        core__write_u32(data, relocation__FLASH_BANK1 + i * 4, rel)
        data[addr:end] = img.pixels
        used[regions[ri][0]] += sz
        first.setdefault(regions[ri][0], addr)
        cur = end
    return {"last_end": cur, "region_used": used, "region_first": first}


def relocation__write_meta(
    out: bytearray,
    profile: UniversalProfile,
    count: int,
    tl: dict[str, int],
    mode: str,
    extra: dict[str, Any],
) -> None:
    payload = {
        "format": relocation__PROJECT_FORMAT,
        "app_version": relocation__APP_VERSION,
        "profile_version": profile.version,
        "roster_count": count,
        "image_count": tl["image_count"],
        "stat_table": tl["stat"],
        "size_table": tl["size"],
        "jogress_pointer_table": tl["jog_ptr"],
        "jogress_rows": tl["jog_rows"],
        "evolution_cave": tl["evo"],
        "mode": mode,
        "acquired_ram_base": relocation__ACQUIRED_RAM_BASE,
        "visible_ram_base": relocation__VISIBLE_RAM_BASE,
        **extra,
    }
    b = json.dumps(payload, ensure_ascii=False, separators=(",", ":")).encode()
    if len(b) + 12 > relocation__METADATA_SIZE:
        raise ValueError("메타데이터 공간 초과")
    out[relocation__METADATA_OFFSET : relocation__METADATA_OFFSET + relocation__METADATA_SIZE] = (
        b"\x00" * relocation__METADATA_SIZE
    )
    out[relocation__METADATA_OFFSET : relocation__METADATA_OFFSET + 8] = relocation__METADATA_MAGIC
    core__write_u32(out, relocation__METADATA_OFFSET + 8, len(b))
    out[relocation__METADATA_OFFSET + 12 : relocation__METADATA_OFFSET + 12 + len(b)] = b


globals()["universal__APP_VERSION"] = relocation__APP_VERSION
globals()["universal__PROJECT_FORMAT"] = relocation__PROJECT_FORMAT
globals()["universal__PROJECT_ROSTER_COUNT"] = relocation__PROJECT_ROSTER_COUNT
globals()["universal__STANDARD_ROSTER_COUNT"] = relocation__STANDARD_ROSTER_COUNT
globals()["universal__EXTENDED_ROSTER_COUNT"] = relocation__EXTENDED_ROSTER_COUNT
globals()["universal__activate"] = relocation__activate
globals()["universal__identify_layout"] = relocation__identify_layout
globals()["universal__read_images_flexible"] = relocation__read_images_flexible
globals()["universal__create_project_from_rom"] = relocation__create_project_from_rom
globals()["universal__save_universal_project"] = relocation__save_project
globals()["universal__load_universal_project"] = relocation__load_project
globals()["universal__build_universal_rom"] = relocation__build_rom


class relocation__GUI(universal__UniversalEditorGUI):

    def _retitle_roster_label(self):

        def walk(w):
            for c in w.winfo_children():
                try:
                    t = c.cget("text")
                    if str(t).startswith("로스터 ID"):
                        c.configure(text="로스터 ID 000–265 (000–113: 8MB, 114–265: 16MB)")
                except Exception:
                    pass
                walk(c)

        walk(self.root)

    def _build_menu(self):
        from tkinter import Menu

        m = Menu(self.root)
        f = Menu(m, tearoff=False)
        f.add_command(label="PenC0~PenC5 ROM 열기...", command=self.open_rom_dialog)
        f.add_command(label="프로젝트 열기...", command=self.open_project_dialog)
        f.add_command(label="프로젝트 저장", command=self.save_project_action)
        f.add_command(
            label="프로젝트 다른 이름으로 저장...", command=lambda: self.save_project_action(True)
        )
        f.add_separator()
        f.add_command(
            label="최대 표준 ROM 저장 (8 MiB / 114마리)...",
            command=lambda: self.build_rom_mode(False),
        )
        f.add_command(
            label="최대 확장 ROM 저장 (16 MiB / 266마리)...",
            command=lambda: self.build_rom_mode(True),
        )
        f.add_separator()
        f.add_command(label="종료", command=self.root.destroy)
        m.add_cascade(label="파일", menu=f)
        t = Menu(m, tearoff=False)
        t.add_command(label="기반 ROM 다시 선택...", command=self.reload_references)
        t.add_command(label="프로젝트 검증", command=self.validate_action)
        m.add_cascade(label="도구", menu=t)
        self.root.config(menu=m)

    def update_capacity(self):
        if self.project is None or self.profile is None:
            return
        try:
            a = relocation__table_layout(self.profile, relocation__STANDARD_ROSTER_COUNT)
            b = relocation__table_layout(self.profile, relocation__EXTENDED_ROSTER_COUNT)
            self.capacity_var.set(
                f"8MB 최대 {relocation__STANDARD_ROSTER_COUNT}마리/{a['image_count']} images | 16MB 최대 {relocation__EXTENDED_ROSTER_COUNT}마리/{b['image_count']} images"
            )
        except Exception as e:
            self.capacity_var.set(str(e))


import argparse
import copy
import json
import os
import struct
import sys
import traceback
from dataclasses import asdict
from pathlib import Path
from typing import Any, Optional

album_base__APP_VERSION = "4.1.0"
album_base__PROJECT_FORMAT = "PenCUniversalProject\x5610"
album_base__PROJECT_ROSTER_COUNT = 266
album_base__STANDARD_ROSTER_COUNT = 114
album_base__EXTENDED_ROSTER_COUNT = 266
album_base__STOCK_ROM_SIZE = relocation__STOCK_ROM_SIZE
album_base__EXTENDED_ROM_SIZE = relocation__EXTENDED_ROM_SIZE
album_base__FLASH_BANK1 = relocation__FLASH_BANK1
album_base__SAVE_TAIL_START = relocation__SAVE_TAIL_START
album_base__SAVE_TAIL_END = relocation__SAVE_TAIL_END
album_base__METADATA_OFFSET = relocation__METADATA_OFFSET
album_base__METADATA_SIZE = relocation__METADATA_SIZE
album_base__METADATA_MAGIC = b"PCU\x5610M1"
album_base__ACQUIRED_RAM_BASE = relocation__ACQUIRED_RAM_BASE
album_base__VISIBLE_RAM_BASE = relocation__VISIBLE_RAM_BASE
album_base__ALBUM_NUMBER_SITES = {
    0: (22718, 22858, 104572),
    1: (22352, 22492, 102624),
    2: (22268, 22408, 102558),
    3: (22292, 22432, 102564),
    4: (22602, 22742, 104126),
    5: (22620, 22760, 104138),
}
album_base__PROFILES = relocation__PROFILES
album_base__RomLayout = relocation__RomLayout


def album_base__activate(
    profile: UniversalProfile, target_count: int, tl: Optional[dict[str, int]] = None
) -> None:
    relocation__activate(profile, target_count, tl)


def album_base__read_meta(data: bytes) -> Optional[dict[str, Any]]:
    for magic in (
        album_base__METADATA_MAGIC,
        b"PCU\x569M01",
        relocation__METADATA_MAGIC,
        b"PCU\x567M01",
        universal__METADATA_MAGIC,
    ):
        if data[album_base__METADATA_OFFSET : album_base__METADATA_OFFSET + len(magic)] == magic:
            n = core__read_u32(data, album_base__METADATA_OFFSET + len(magic))
            if 0 < n < album_base__METADATA_SIZE - len(magic) - 4:
                try:
                    return json.loads(
                        data[
                            album_base__METADATA_OFFSET
                            + len(magic)
                            + 4 : album_base__METADATA_OFFSET
                            + len(magic)
                            + 4
                            + n
                        ].decode("utf-8")
                    )
                except Exception:
                    return None
    return None


def album_base__table_layout(profile: UniversalProfile, target_count: int) -> dict[str, int]:
    return relocation__table_layout(profile, target_count)


globals()["relocation__read_meta"] = album_base__read_meta


def album_base__identify_layout(data: bytes) -> album_base__RomLayout:
    if len(data) not in (album_base__STOCK_ROM_SIZE, album_base__EXTENDED_ROM_SIZE):
        raise ValueError("8 MiB 또는 16 MiB ROM만 지원합니다")
    m = album_base__read_meta(data)
    if m and m.get("format") in (
        album_base__PROJECT_FORMAT,
        "PenCUniversalProject\x569",
        relocation__PROJECT_FORMAT,
        "PenCUniversalProject\x567",
        universal__PROJECT_FORMAT,
    ):
        p = album_base__PROFILES[int(m["profile_version"])]
        return album_base__RomLayout(
            p,
            int(m["roster_count"]),
            int(m["image_count"]),
            int(m["stat_table"]),
            int(m["size_table"]),
            str(m.get("mode", "patched")),
        )
    return relocation__identify_layout(data)


def album_base___divide_current_r4(divisor: int, quotient: bool) -> list[int]:
    if divisor <= 63:
        w = [38464 | divisor]
    else:
        w = [38667, divisor]
    w += [54920, 55432]
    w += list(universal___call_words_for_raw(49932 if quotient else 49746))
    w += [66]
    return w


def album_base___load_album_number() -> list[int]:
    return [65024, 39180, 2154, 39140, 2113]


def album_base___set_draw_args(
    layer: int, image_reg_is_r1: bool, x: int, draw_raw: int
) -> list[int]:

    w: list[int] = [38667, layer, 2312, 1, 54980]
    if image_reg_is_r1:
        w += [1801, 147]
    else:
        raise ValueError("현재 구현은 r1 digit만 지원합니다")
    w += [2312, 2, 54980, 38667, x, 2312, 3, 54980, 38512, 2312, 4, 54980, 38465, 2312, 5, 54980]
    w += list(universal___call_words_for_raw(draw_raw))
    return w


def album_base__build_album_number_3digit(draw_raw: int, return_raw: int) -> list[int]:

    w: list[int] = []
    w += album_base___load_album_number()
    w += album_base___divide_current_r4(100, True)
    w += album_base___set_draw_args(11, True, 52, draw_raw)
    w += album_base___load_album_number()
    w += album_base___divide_current_r4(10, True)
    w += [53760]
    w += [38912]
    w += album_base___divide_current_r4(10, False)
    w += album_base___set_draw_args(12, True, 68, draw_raw)
    w += album_base___load_album_number()
    w += album_base___divide_current_r4(10, False)
    w += album_base___set_draw_args(13, True, 84, draw_raw)
    w += list(core__far_goto_words(return_raw))
    return w


def album_base__build_rom(
    project: core.Project, source: bytes, layout: RomLayout, target: int, extended: bool
):
    expected = album_base__EXTENDED_ROSTER_COUNT if extended else album_base__STANDARD_ROSTER_COUNT
    if target != expected:
        raise ValueError(f"\x5610 {('16MB' if extended else '8MB')} 저장 수는 {expected}마리입니다")
    p = layout.profile
    tl = album_base__table_layout(p, target)
    album_base__activate(p, target, tl)
    bp = core__Project(
        slots=copy.deepcopy(project.slots[:target]), rom_files=dict(project.rom_files)
    )
    core__validate_project(bp)
    srcimgs = album_base__read_images_flexible(source, layout.image_count, layout.size_table)
    out = bytearray(
        b"\xff" * (album_base__EXTENDED_ROM_SIZE if extended else album_base__STOCK_ROM_SIZE)
    )
    out[:album_base__STOCK_ROM_SIZE] = source[:album_base__STOCK_ROM_SIZE]
    save = bytes(source[album_base__SAVE_TAIL_START:album_base__SAVE_TAIL_END])
    out[album_base__METADATA_OFFSET:relocation__TABLE_AREA_END] = b"\x00" * (
        relocation__TABLE_AREA_END - album_base__METADATA_OFFSET
    )
    final = list(srcimgs[: p.stock_image_count])
    statslist: list[list[int]] = []
    for s in bp.slots:
        st = list(s.stats)
        if s.digimon_id < p.stock_roster_count:
            start = 240 + s.digimon_id * 12            st[0] = start
            if s.digimon_id < layout.roster_count:
                st[core__ALBUM_ORDER_STAT_INDEX] = core__read_stat_words(
                    source, s.digimon_id, layout.stat_table
                )[core__ALBUM_ORDER_STAT_INDEX]
            for j, ref in enumerate(s.frames):
                final[start + j] = core__resolve_frame(ref, srcimgs)
        else:
            start = p.stock_image_count + (s.digimon_id - p.stock_roster_count) * 12
            st[0] = start
            st[core__ALBUM_ORDER_STAT_INDEX] = s.digimon_id
            final.extend((core__resolve_frame(ref, srcimgs) for ref in s.frames))
        statslist.append(st)
    if len(final) != tl["image_count"]:
        raise AssertionError("image count")
    img_report = album_base__write_images_safe(out, final, extended)
    for i, img in enumerate(final):
        core__write_u16(out, tl["size"] + i * 4, img.width)
        core__write_u16(out, tl["size"] + i * 4 + 2, img.height)
    for s, st in zip(bp.slots, statslist):
        core__write_stat_words(out, s.digimon_id, st, tl["stat"])
    core__write_u16(out, p.stat_lookup_site, tl["stat"] // 2 & 65535)
    relocation__patch_size_table_sites(out, p, tl["size"])
    for off in p.image_max_offsets:
        core__write_u16(out, off, tl["image_count"] - 1)
    cave = relocation__Cave(out)
    ram_report = album_base__patch_album_ram_safe(out, source, target, cave)
    for off in p.roster_max_offsets:
        relocation__patch_wide_compare(out, off, target - 1, cave, source)
    album_info = relocation__patch_album_visibility(out, source, p, target - 1, cave)
    album_cursor = relocation__patch_album_cursor(out, p, target, cave)
    number_info = album_base__patch_album_number(out, p, cave)
    evo, evo_report = relocation__build_evolution_wide(bp.slots, p, tl)
    out[tl["evo"] : tl["evo_end"]] = b"\x00" * (tl["evo_end"] - tl["evo"])
    out[tl["evo"] : tl["evo"] + len(evo)] = evo
    core__write_far_goto(out, p.evolution_hook, tl["evo"])
    relocation__patch_jogress(out, source, layout, target, tl, cave)
    extra = {
        **ram_report,
        **album_info,
        **number_info,
        "album_cursor": album_cursor,
        "image_pointer_policy": "nonnegative-relative-only",
    }
    album_base__write_meta(
        out,
        p,
        target,
        tl,
        "extended16-safe-positive" if extended else "standard8-safe-bank1",
        extra,
    )
    if out[album_base__SAVE_TAIL_START:album_base__SAVE_TAIL_END] != save:
        raise AssertionError("save tail changed")
    decoded = []
    for i in range(tl["image_count"]):
        rel = core__read_u32(out, album_base__FLASH_BANK1 + i * 4)
        addr = album_base__FLASH_BANK1 + rel
        decoded.append(addr)
        if addr < album_base__FLASH_BANK1:
            raise AssertionError(f"negative/wrapped image pointer at {i}: {addr:#x}")
        if album_base__SAVE_TAIL_START <= addr < album_base__SAVE_TAIL_END:
            raise AssertionError(f"save-tail image pointer at {i}: {addr:#x}")
        if addr >= len(out):
            raise AssertionError(f"out-of-ROM image pointer at {i}: {addr:#x}")
    report = {
        "format": "PenC Universal Editor \x5610 build report",
        "app_version": album_base__APP_VERSION,
        "profile": p.label,
        "mode": f"{('16MiB' if extended else '8MiB')}/{target}",
        "rom_size": len(out),
        "roster_count": target,
        "max_id": target - 1,
        "no_result_id": target,
        "total_image_count": tl["image_count"],
        "tables": tl,
        "images": img_report,
        "album_number": number_info,
        "album_number_format": "fixed 3-digit decimal on layers 11-13",
        "wide_limit_sites": len(p.roster_max_offsets),
        "album_ram": ram_report,
        "evolution": evo_report,
        "save_tail_preserved": True,
        "minimum_image_address": min(decoded),
        "maximum_image_address": max(decoded),
        "source_sha256": core__sha256(source),
        "output_sha256": core__sha256(out),
        "hist_dc_hardware_findings": {
            "F0_F9": "100-109 rendered through non-digit glyphs by the stock two-digit routine",
            "o0_o4": "110-114 rendered through non-digit glyphs by the stock two-digit routine",
            "corrupted_last_sprite": "wrapped bank0 relative image pointer rejected by hardware",
            "album_entry_reset": "\x569 used invalid display layer 14; \x5610 reuses transparent stock layer 11",
            "sleep_no_wake": "\x567-\x569 blindly rewrote two r4 += 15 operands; \x5610 repairs and semantically filters RAM references",
        },
        "warning": "8MiB \x5610 intentionally returns to the proven bank1-only sprite layout. 16MiB positive offsets above 0x800000 still require MX25L12833F real-hardware testing.",
    }
    return (bytes(out), report)


def album_base__create_project_from_rom(path: Path):
    data = path.read_bytes()
    layout = album_base__identify_layout(data)
    album_base__activate(layout.profile, album_base__PROJECT_ROSTER_COUNT)
    images = album_base__read_images_flexible(data, layout.image_count, layout.size_table)
    slots: list[core__DigimonSlot] = []
    current = min(layout.roster_count, album_base__PROJECT_ROSTER_COUNT)
    for did in range(current):
        stats = core__read_stat_words(data, did, layout.stat_table)
        start = stats[0]
        frames = [core__FrameRef("base", start + i) for i in range(12)]
        name = (
            core__DEFAULT_DISPLAY_NAMES[did]
            if layout.profile.version == 1 and did < len(core__DEFAULT_DISPLAY_NAMES)
            else f"VP{layout.profile.version} ID {did:03d}"
        )
        slots.append(core__DigimonSlot(did, name, stats, frames, core__EvolutionRoute()))
    tid = max(0, current - 1)
    ts = list(slots[tid].stats)
    tf = copy.deepcopy(slots[tid].frames)
    for did in range(current, album_base__PROJECT_ROSTER_COUNT):
        st = list(ts)
        st[core__ALBUM_ORDER_STAT_INDEX] = did
        st[core__ALBUM_VISIBLE_STAT_INDEX] = 1
        slots.append(
            core__DigimonSlot(
                did,
                f"추가 슬롯 {did:03d}",
                st,
                copy.deepcopy(tf),
                core__EvolutionRoute(False, 0, []),
            )
        )
    pr = core__Project(
        slots=slots,
        rom_files={"vanilla": str(path.resolve()), "profile_version": str(layout.profile.version)},
    )
    return (pr, data, images, layout)


def album_base__load_project(path: Path):
    obj = json.loads(path.read_text(encoding="utf-8"))
    if obj.get("format") == album_base__PROJECT_FORMAT:
        version = int(obj["profile_version"])
        base = Path(obj.get("base_rom", ""))
        if not base.is_absolute():
            base = (path.parent / base).resolve()
        pr, data, imgs, layout = album_base__create_project_from_rom(base)
        if layout.profile.version != version:
            raise ValueError("프로젝트와 기반 ROM 버전이 다릅니다")
        loaded = [core__DigimonSlot.from_dict(x) for x in obj.get("slots", [])]
        for i, slot in enumerate(loaded[:album_base__PROJECT_ROSTER_COUNT]):
            pr.slots[i] = slot
        pr.project_path = path
        pr.rom_files = {"vanilla": str(base), "profile_version": str(version)}
        return (pr, data, imgs, layout)
    if obj.get("format") in (
        "PenCUniversalProject\x569",
        relocation__PROJECT_FORMAT,
        "PenCUniversalProject\x567",
        universal__PROJECT_FORMAT,
    ):
        version = int(obj["profile_version"])
        base = Path(obj.get("base_rom", ""))
        if not base.is_absolute():
            base = (path.parent / base).resolve()
        pr, data, imgs, layout = album_base__create_project_from_rom(base)
        loaded = [core__DigimonSlot.from_dict(x) for x in obj.get("slots", [])]
        for i, slot in enumerate(loaded[:album_base__PROJECT_ROSTER_COUNT]):
            pr.slots[i] = slot
        pr.project_path = path
        return (pr, data, imgs, layout)
    legacy = core__load_project(path)
    base = Path(legacy.rom_files.get("vanilla", "PenC1.bin"))
    if not base.is_absolute():
        base = (path.parent / base).resolve()
    pr, data, imgs, layout = album_base__create_project_from_rom(base)
    for i, slot in enumerate(legacy.slots[:album_base__PROJECT_ROSTER_COUNT]):
        pr.slots[i] = slot
    pr.project_path = path
    return (pr, data, imgs, layout)


def album_base__patch_album_number(
    out: bytearray, profile: UniversalProfile, cave: hist_dc.Cave
) -> dict[str, int]:
    hook_raw, return_raw, draw_raw = album_base__ALBUM_NUMBER_SITES[profile.version]
    words = album_base__build_album_number_3digit(draw_raw, return_raw)
    impl = cave.put(words)
    core__write_far_goto(out, hook_raw, impl)
    return {
        "album_number_impl": impl,
        "album_number_words": len(words),
        "digits": 3,
        "hook": hook_raw,
        "return": return_raw,
        "draw_function": draw_raw,
    }


def album_base__project_to_dict(project: core.Project, profile_version: int) -> dict[str, Any]:
    return {
        "format": album_base__PROJECT_FORMAT,
        "app_version": album_base__APP_VERSION,
        "profile_version": profile_version,
        "base_rom": project.rom_files.get("vanilla", ""),
        "slots": [
            {
                "id": s.digimon_id,
                "name": s.name,
                "stats": s.stats,
                "frames": [asdict(f) for f in s.frames],
                "evolution": {
                    "enabled": s.evolution.enabled,
                    "source_id": s.evolution.source_id,
                    "conditions": [asdict(c) for c in s.evolution.conditions],
                },
            }
            for s in project.slots
        ],
    }


def album_base__read_images_flexible(
    data: bytes, count: int, size_table: int
) -> list[core__RomImage]:
    return relocation__read_images_flexible(data, count, size_table)


def album_base__save_project(project: core.Project, profile_version: int, path: Path) -> None:
    obj = album_base__project_to_dict(project, profile_version)
    base = Path(obj["base_rom"])
    if base.is_absolute():
        try:
            obj["base_rom"] = os.path.relpath(base, path.parent).replace("\\", "/")
        except ValueError:
            pass
    path.write_text(json.dumps(obj, ensure_ascii=False, indent=2), encoding="utf-8")
    project.project_path = path


def album_base__write_images_safe(
    data: bytearray, images: list[core.RomImage], extended: bool
) -> dict[str, Any]:

    count = len(images)
    regions: list[list[Any]] = [
        ["bank1", album_base__FLASH_BANK1 + count * 4, album_base__SAVE_TAIL_START]
    ]
    if extended:
        regions.append(["uppe\x7216", album_base__SAVE_TAIL_END, len(data)])
    data[album_base__FLASH_BANK1:album_base__SAVE_TAIL_START] = b"\x00" * (
        album_base__SAVE_TAIL_START - album_base__FLASH_BANK1
    )
    if extended:
        data[album_base__SAVE_TAIL_END:] = b"\xff" * (len(data) - album_base__SAVE_TAIL_END)
    ri = 0
    cur = regions[0][1]
    used = {r[0]: 0 for r in regions}
    first: dict[str, int] = {}
    seen: dict[tuple[int, int, bytes], int] = {}
    duplicate_images = 0
    duplicate_bytes_saved = 0
    unique_images = 0
    for i, img in enumerate(images):
        size = len(img.pixels)
        key = (img.width, img.height, img.pixels)
        addr = seen.get(key)
        if addr is not None:
            duplicate_images += 1
            duplicate_bytes_saved += size
            core__write_u32(data, album_base__FLASH_BANK1 + i * 4, addr - album_base__FLASH_BANK1)
            continue
        if cur + size > regions[ri][2]:
            ri += 1
            if ri >= len(regions):
                available = sum((int(r[2]) - int(r[1]) for r in regions))
                used_total = sum(used.values())
                raise ValueError(
                    f"고유 이미지 공간 초과: image {i}, 사용 {used_total:,} / {available:,} bytes. 동일 프레임은 자동 공유되지만 현재 프로젝트의 서로 다른 픽셀이 칩 용량을 넘었습니다."
                )
            cur = regions[ri][1]
        addr = cur
        end = addr + size
        rel = addr - album_base__FLASH_BANK1
        if rel < 0:
            raise AssertionError("\x5610은 음수 이미지 포인터를 만들지 않습니다")
        core__write_u32(data, album_base__FLASH_BANK1 + i * 4, rel)
        data[addr:end] = img.pixels
        seen[key] = addr
        unique_images += 1
        used[regions[ri][0]] += size
        first.setdefault(regions[ri][0], addr)
        cur = end
    return {
        "last_end": cur,
        "region_used": used,
        "region_first": first,
        "wrapped_bank0_pointers": False,
        "unique_images": unique_images,
        "duplicate_images": duplicate_images,
        "duplicate_bytes_saved": duplicate_bytes_saved,
    }


def album_base__write_meta(
    out: bytearray,
    profile: UniversalProfile,
    count: int,
    tl: dict[str, int],
    mode: str,
    extra: dict[str, Any],
) -> None:
    payload = {
        "format": album_base__PROJECT_FORMAT,
        "app_version": album_base__APP_VERSION,
        "profile_version": profile.version,
        "roster_count": count,
        "image_count": tl["image_count"],
        "stat_table": tl["stat"],
        "size_table": tl["size"],
        "jogress_pointer_table": tl["jog_ptr"],
        "jogress_rows": tl["jog_rows"],
        "evolution_cave": tl["evo"],
        "mode": mode,
        "acquired_ram_base": album_base__ACQUIRED_RAM_BASE,
        "visible_ram_base": album_base__VISIBLE_RAM_BASE,
        **extra,
    }
    b = json.dumps(payload, ensure_ascii=False, separators=(",", ":")).encode()
    if len(b) + 12 > album_base__METADATA_SIZE:
        raise ValueError("메타데이터 공간 초과")
    out[album_base__METADATA_OFFSET : album_base__METADATA_OFFSET + album_base__METADATA_SIZE] = (
        b"\x00" * album_base__METADATA_SIZE
    )
    out[album_base__METADATA_OFFSET : album_base__METADATA_OFFSET + 8] = album_base__METADATA_MAGIC
    core__write_u32(out, album_base__METADATA_OFFSET + 8, len(b))
    out[album_base__METADATA_OFFSET + 12 : album_base__METADATA_OFFSET + 12 + len(b)] = b


globals()["universal__APP_VERSION"] = album_base__APP_VERSION
globals()["universal__PROJECT_FORMAT"] = album_base__PROJECT_FORMAT
globals()["universal__PROJECT_ROSTER_COUNT"] = album_base__PROJECT_ROSTER_COUNT
globals()["universal__STANDARD_ROSTER_COUNT"] = album_base__STANDARD_ROSTER_COUNT
globals()["universal__EXTENDED_ROSTER_COUNT"] = album_base__EXTENDED_ROSTER_COUNT
globals()["universal__activate"] = album_base__activate
globals()["universal__identify_layout"] = album_base__identify_layout
globals()["universal__read_images_flexible"] = album_base__read_images_flexible
globals()["universal__create_project_from_rom"] = album_base__create_project_from_rom
globals()["universal__save_universal_project"] = album_base__save_project
globals()["universal__load_universal_project"] = album_base__load_project
globals()["universal__build_universal_rom"] = album_base__build_rom


class album_base__GUI(universal__UniversalEditorGUI):

    def _retitle_roster_label(self):

        def walk(w):
            for c in w.winfo_children():
                try:
                    t = c.cget("text")
                    if str(t).startswith("로스터 ID"):
                        c.configure(
                            text="로스터 ID 000–265 (000–113: 8MB 슬롯, 114–265: 16MB 슬롯)"
                        )
                except Exception:
                    pass
                walk(c)

        walk(self.root)

    def _build_menu(self):
        from tkinter import Menu

        m = Menu(self.root)
        f = Menu(m, tearoff=False)
        f.add_command(label="PenC0~PenC5 ROM 열기...", command=self.open_rom_dialog)
        f.add_command(label="프로젝트 열기...", command=self.open_project_dialog)
        f.add_command(label="프로젝트 저장", command=self.save_project_action)
        f.add_command(
            label="프로젝트 다른 이름으로 저장...", command=lambda: self.save_project_action(True)
        )
        f.add_separator()
        f.add_command(
            label="표준 ROM 저장 (8 MiB / 최대 114슬롯)...",
            command=lambda: self.build_rom_mode(False),
        )
        f.add_command(
            label="확장 ROM 저장 (16 MiB / 최대 266슬롯)...",
            command=lambda: self.build_rom_mode(True),
        )
        f.add_separator()
        f.add_command(label="종료", command=self.root.destroy)
        m.add_cascade(label="파일", menu=f)
        t = Menu(m, tearoff=False)
        t.add_command(label="기반 ROM 다시 선택...", command=self.reload_references)
        t.add_command(label="프로젝트 검증", command=self.validate_action)
        m.add_cascade(label="도구", menu=t)
        self.root.config(menu=m)

    def update_capacity(self):
        if self.project is None or self.profile is None:
            return
        try:
            a = album_base__table_layout(self.profile, album_base__STANDARD_ROSTER_COUNT)
            b = album_base__table_layout(self.profile, album_base__EXTENDED_ROSTER_COUNT)
            self.capacity_var.set(
                f"8MB 최대 {album_base__STANDARD_ROSTER_COUNT}슬롯(완전 고유 45마리 기준) | 16MB 최대 {album_base__EXTENDED_ROSTER_COUNT}슬롯(완전 고유 197마리 기준) | 동일 프레임 자동 공유 | 도감 번호 001–266"
            )
        except Exception as exc:
            self.capacity_var.set(str(exc))


import argparse
import copy
import json
import os
import struct
import sys
import traceback
from dataclasses import asdict
from pathlib import Path
from typing import Any, Optional

album_layers__APP_VERSION = "4.2.0"
album_layers__PROJECT_FORMAT = "PenCUniversalProject\x5611"
album_layers__PROJECT_ROSTER_COUNT = 266
album_layers__STANDARD_ROSTER_COUNT = 114
album_layers__EXTENDED_ROSTER_COUNT = 266
album_layers__STOCK_ROM_SIZE = relocation__STOCK_ROM_SIZE
album_layers__EXTENDED_ROM_SIZE = relocation__EXTENDED_ROM_SIZE
album_layers__FLASH_BANK1 = relocation__FLASH_BANK1
album_layers__SAVE_TAIL_START = relocation__SAVE_TAIL_START
album_layers__SAVE_TAIL_END = relocation__SAVE_TAIL_END
album_layers__METADATA_OFFSET = relocation__METADATA_OFFSET
album_layers__METADATA_SIZE = relocation__METADATA_SIZE
album_layers__METADATA_MAGIC = b"PCU\x5611M1"
album_layers__ACQUIRED_RAM_BASE = relocation__ACQUIRED_RAM_BASE
album_layers__VISIBLE_RAM_BASE = relocation__VISIBLE_RAM_BASE
album_layers__ALBUM_NUMBER_SITES = {
    0: (22718, 22858, 104572),
    1: (22352, 22492, 102624),
    2: (22268, 22408, 102558),
    3: (22292, 22432, 102564),
    4: (22602, 22742, 104126),
    5: (22620, 22760, 104138),
}
album_layers__PROFILES = relocation__PROFILES
album_layers__RomLayout = relocation__RomLayout


def album_layers__activate(
    profile: UniversalProfile, target_count: int, tl: Optional[dict[str, int]] = None
) -> None:
    relocation__activate(profile, target_count, tl)


def album_layers__read_meta(data: bytes) -> Optional[dict[str, Any]]:
    for magic in (
        album_layers__METADATA_MAGIC,
        b"PCU\x5610M1",
        b"PCU\x569M01",
        relocation__METADATA_MAGIC,
        b"PCU\x567M01",
        universal__METADATA_MAGIC,
    ):
        if (
            data[album_layers__METADATA_OFFSET : album_layers__METADATA_OFFSET + len(magic)]
            == magic
        ):
            n = core__read_u32(data, album_layers__METADATA_OFFSET + len(magic))
            if 0 < n < album_layers__METADATA_SIZE - len(magic) - 4:
                try:
                    return json.loads(
                        data[
                            album_layers__METADATA_OFFSET
                            + len(magic)
                            + 4 : album_layers__METADATA_OFFSET
                            + len(magic)
                            + 4
                            + n
                        ].decode("utf-8")
                    )
                except Exception:
                    return None
    return None


def album_layers__table_layout(profile: UniversalProfile, target_count: int) -> dict[str, int]:
    return relocation__table_layout(profile, target_count)


globals()["relocation__read_meta"] = album_layers__read_meta


def album_layers__identify_layout(data: bytes) -> album_layers__RomLayout:
    if len(data) not in (album_layers__STOCK_ROM_SIZE, album_layers__EXTENDED_ROM_SIZE):
        raise ValueError("8 MiB 또는 16 MiB ROM만 지원합니다")
    m = album_layers__read_meta(data)
    if m and m.get("format") in (
        album_layers__PROJECT_FORMAT,
        "PenCUniversalProject\x5610",
        "PenCUniversalProject\x569",
        relocation__PROJECT_FORMAT,
        "PenCUniversalProject\x567",
        universal__PROJECT_FORMAT,
    ):
        p = album_layers__PROFILES[int(m["profile_version"])]
        return album_layers__RomLayout(
            p,
            int(m["roster_count"]),
            int(m["image_count"]),
            int(m["stat_table"]),
            int(m["size_table"]),
            str(m.get("mode", "patched")),
        )
    return relocation__identify_layout(data)


def album_layers___divide_current_r4(divisor: int, quotient: bool) -> list[int]:
    if divisor <= 63:
        w = [38464 | divisor]
    else:
        w = [38667, divisor]
    w += [54920, 55432]
    w += list(universal___call_words_for_raw(49932 if quotient else 49746))
    w += [66]
    return w


def album_layers___load_album_number() -> list[int]:
    return [65024, 39180, 2154, 39140, 2113]


def album_layers___set_draw_args(
    layer: int, image_reg_is_r1: bool, x: int, draw_raw: int
) -> list[int]:

    w: list[int] = [38667, layer, 2312, 1, 54980]
    if image_reg_is_r1:
        w += [1801, 147]
    else:
        raise ValueError("현재 구현은 r1 digit만 지원합니다")
    w += [2312, 2, 54980, 38667, x, 2312, 3, 54980, 38512, 2312, 4, 54980, 38465, 2312, 5, 54980]
    w += list(universal___call_words_for_raw(draw_raw))
    return w


def album_layers__build_album_hundreds_setup(placeholder_call_raw: int) -> list[int]:

    w: list[int] = []
    w += [38667, 11, 2312, 1, 54980]
    w += album_layers___load_album_number()
    w += album_layers___divide_current_r4(100, True)
    w += [1801, 147, 2312, 2, 54980]
    w += [38667, 52, 2312, 3, 54980]
    w += [38512, 2312, 4, 54980]
    w += [38465, 2312, 5, 54980]
    w += list(core__far_goto_words(placeholder_call_raw))
    return w


def album_layers__build_album_tens_ones(draw_raw: int, return_raw: int) -> list[int]:

    w: list[int] = []
    w += album_layers___load_album_number()
    w += album_layers___divide_current_r4(10, True)
    w += [53760, 38912]
    w += album_layers___divide_current_r4(10, False)
    w += album_layers___set_draw_args(12, True, 68, draw_raw)
    w += album_layers___load_album_number()
    w += album_layers___divide_current_r4(10, False)
    w += album_layers___set_draw_args(13, True, 84, draw_raw)
    w += list(core__far_goto_words(return_raw))
    return w


def album_layers__build_rom(
    project: core.Project, source: bytes, layout: RomLayout, target: int, extended: bool
):
    expected = (
        album_layers__EXTENDED_ROSTER_COUNT if extended else album_layers__STANDARD_ROSTER_COUNT
    )
    if target != expected:
        raise ValueError(f"\x5611 {('16MB' if extended else '8MB')} 저장 수는 {expected}마리입니다")
    p = layout.profile
    tl = album_layers__table_layout(p, target)
    album_layers__activate(p, target, tl)
    bp = core__Project(
        slots=copy.deepcopy(project.slots[:target]), rom_files=dict(project.rom_files)
    )
    core__validate_project(bp)
    srcimgs = album_layers__read_images_flexible(source, layout.image_count, layout.size_table)
    out = bytearray(
        b"\xff" * (album_layers__EXTENDED_ROM_SIZE if extended else album_layers__STOCK_ROM_SIZE)
    )
    out[:album_layers__STOCK_ROM_SIZE] = source[:album_layers__STOCK_ROM_SIZE]
    save = bytes(source[album_layers__SAVE_TAIL_START:album_layers__SAVE_TAIL_END])
    out[album_layers__METADATA_OFFSET:relocation__TABLE_AREA_END] = b"\x00" * (
        relocation__TABLE_AREA_END - album_layers__METADATA_OFFSET
    )
    final = list(srcimgs[: p.stock_image_count])
    statslist: list[list[int]] = []
    for s in bp.slots:
        st = list(s.stats)
        if s.digimon_id < p.stock_roster_count:
            start = 240 + s.digimon_id * 12
            st[0] = start
            if s.digimon_id < layout.roster_count:
                st[core__ALBUM_ORDER_STAT_INDEX] = core__read_stat_words(
                    source, s.digimon_id, layout.stat_table
                )[core__ALBUM_ORDER_STAT_INDEX]
            for j, ref in enumerate(s.frames):
                final[start + j] = core__resolve_frame(ref, srcimgs)
        else:
            start = p.stock_image_count + (s.digimon_id - p.stock_roster_count) * 12
            st[0] = start
            st[core__ALBUM_ORDER_STAT_INDEX] = s.digimon_id
            final.extend((core__resolve_frame(ref, srcimgs) for ref in s.frames))
        statslist.append(st)
    if len(final) != tl["image_count"]:
        raise AssertionError("image count")
    img_report = album_layers__write_images_safe(out, final, extended)
    for i, img in enumerate(final):
        core__write_u16(out, tl["size"] + i * 4, img.width)
        core__write_u16(out, tl["size"] + i * 4 + 2, img.height)
    for s, st in zip(bp.slots, statslist):
        core__write_stat_words(out, s.digimon_id, st, tl["stat"])
    core__write_u16(out, p.stat_lookup_site, tl["stat"] // 2 & 65535)
    relocation__patch_size_table_sites(out, p, tl["size"])
    for off in p.image_max_offsets:
        core__write_u16(out, off, tl["image_count"] - 1)
    cave = relocation__Cave(out)
    ram_report = album_layers__patch_album_ram_safe(out, source, target, cave)
    for off in p.roster_max_offsets:
        relocation__patch_wide_compare(out, off, target - 1, cave, source)
    album_info = relocation__patch_album_visibility(out, source, p, target - 1, cave)
    album_cursor = relocation__patch_album_cursor(out, p, target, cave)
    number_info = album_layers__patch_album_number(out, p, cave)
    evo, evo_report = relocation__build_evolution_wide(bp.slots, p, tl)
    out[tl["evo"] : tl["evo_end"]] = b"\x00" * (tl["evo_end"] - tl["evo"])
    out[tl["evo"] : tl["evo"] + len(evo)] = evo
    core__write_far_goto(out, p.evolution_hook, tl["evo"])
    relocation__patch_jogress(out, source, layout, target, tl, cave)
    extra = {
        **ram_report,
        **album_info,
        **number_info,
        "album_cursor": album_cursor,
        "image_pointer_policy": "nonnegative-relative-only",
    }
    album_layers__write_meta(
        out,
        p,
        target,
        tl,
        "extended16-safe-positive" if extended else "standard8-safe-bank1",
        extra,
    )
    if out[album_layers__SAVE_TAIL_START:album_layers__SAVE_TAIL_END] != save:
        raise AssertionError("save tail changed")
    decoded = []
    for i in range(tl["image_count"]):
        rel = core__read_u32(out, album_layers__FLASH_BANK1 + i * 4)
        addr = album_layers__FLASH_BANK1 + rel
        decoded.append(addr)
        if addr < album_layers__FLASH_BANK1:
            raise AssertionError(f"negative/wrapped image pointer at {i}: {addr:#x}")
        if album_layers__SAVE_TAIL_START <= addr < album_layers__SAVE_TAIL_END:
            raise AssertionError(f"save-tail image pointer at {i}: {addr:#x}")
        if addr >= len(out):
            raise AssertionError(f"out-of-ROM image pointer at {i}: {addr:#x}")
    report = {
        "format": "PenC Universal Editor \x5611 build report",
        "app_version": album_layers__APP_VERSION,
        "profile": p.label,
        "mode": f"{('16MiB' if extended else '8MiB')}/{target}",
        "rom_size": len(out),
        "roster_count": target,
        "max_id": target - 1,
        "no_result_id": target,
        "total_image_count": tl["image_count"],
        "tables": tl,
        "images": img_report,
        "album_number": number_info,
        "album_number_format": "fixed 3-digit decimal; stock layer 11 setup replaced in-place, layers 12/13 retained",
        "wide_limit_sites": len(p.roster_max_offsets),
        "album_ram": ram_report,
        "evolution": evo_report,
        "save_tail_preserved": True,
        "minimum_image_address": min(decoded),
        "maximum_image_address": max(decoded),
        "source_sha256": core__sha256(source),
        "output_sha256": core__sha256(out),
        "hist_dc_hardware_findings": {
            "F0_F9": "100-109 rendered through non-digit glyphs by the stock two-digit routine",
            "o0_o4": "110-114 rendered through non-digit glyphs by the stock two-digit routine",
            "corrupted_last_sprite": "wrapped bank0 relative image pointer rejected by hardware",
            "album_entry_reset": "\x569 used invalid display layer 14; \x5610 recreated stock layer 11; \x5611 injects the digit into its original creation",
            "sleep_no_wake": "\x567-\x569 blindly rewrote two r4 += 15 operands; \x5610 repairs and semantically filters RAM references",
        },
        "warning": "8MiB \x5611 intentionally returns to the proven bank1-only sprite layout. 16MiB positive offsets above 0x800000 still require MX25L12833F real-hardware testing.",
    }
    return (bytes(out), report)


def album_layers__create_project_from_rom(path: Path):
    data = path.read_bytes()
    layout = album_layers__identify_layout(data)
    album_layers__activate(layout.profile, album_layers__PROJECT_ROSTER_COUNT)
    images = album_layers__read_images_flexible(data, layout.image_count, layout.size_table)
    slots: list[core__DigimonSlot] = []
    current = min(layout.roster_count, album_layers__PROJECT_ROSTER_COUNT)
    for did in range(current):
        stats = core__read_stat_words(data, did, layout.stat_table)
        start = stats[0]
        frames = [core__FrameRef("base", start + i) for i in range(12)]
        name = (
            core__DEFAULT_DISPLAY_NAMES[did]
            if layout.profile.version == 1 and did < len(core__DEFAULT_DISPLAY_NAMES)
            else f"VP{layout.profile.version} ID {did:03d}"
        )
        slots.append(core__DigimonSlot(did, name, stats, frames, core__EvolutionRoute()))
    tid = max(0, current - 1)
    ts = list(slots[tid].stats)
    tf = copy.deepcopy(slots[tid].frames)
    for did in range(current, album_layers__PROJECT_ROSTER_COUNT):
        st = list(ts)
        st[core__ALBUM_ORDER_STAT_INDEX] = did
        st[core__ALBUM_VISIBLE_STAT_INDEX] = 1
        slots.append(
            core__DigimonSlot(
                did,
                f"추가 슬롯 {did:03d}",
                st,
                copy.deepcopy(tf),
                core__EvolutionRoute(False, 0, []),
            )
        )
    pr = core__Project(
        slots=slots,
        rom_files={"vanilla": str(path.resolve()), "profile_version": str(layout.profile.version)},
    )
    return (pr, data, images, layout)


def album_layers__load_project(path: Path):
    obj = json.loads(path.read_text(encoding="utf-8"))
    if obj.get("format") == album_layers__PROJECT_FORMAT:
        version = int(obj["profile_version"])
        base = Path(obj.get("base_rom", ""))
        if not base.is_absolute():
            base = (path.parent / base).resolve()
        pr, data, imgs, layout = album_layers__create_project_from_rom(base)
        if layout.profile.version != version:
            raise ValueError("프로젝트와 기반 ROM 버전이 다릅니다")
        loaded = [core__DigimonSlot.from_dict(x) for x in obj.get("slots", [])]
        for i, slot in enumerate(loaded[:album_layers__PROJECT_ROSTER_COUNT]):
            pr.slots[i] = slot
        pr.project_path = path
        pr.rom_files = {"vanilla": str(base), "profile_version": str(version)}
        return (pr, data, imgs, layout)
    if obj.get("format") in (
        "PenCUniversalProject\x5610",
        "PenCUniversalProject\x569",
        relocation__PROJECT_FORMAT,
        "PenCUniversalProject\x567",
        universal__PROJECT_FORMAT,
    ):
        version = int(obj["profile_version"])
        base = Path(obj.get("base_rom", ""))
        if not base.is_absolute():
            base = (path.parent / base).resolve()
        pr, data, imgs, layout = album_layers__create_project_from_rom(base)
        loaded = [core__DigimonSlot.from_dict(x) for x in obj.get("slots", [])]
        for i, slot in enumerate(loaded[:album_layers__PROJECT_ROSTER_COUNT]):
            pr.slots[i] = slot
        pr.project_path = path
        return (pr, data, imgs, layout)
    legacy = core__load_project(path)
    base = Path(legacy.rom_files.get("vanilla", "PenC1.bin"))
    if not base.is_absolute():
        base = (path.parent / base).resolve()
    pr, data, imgs, layout = album_layers__create_project_from_rom(base)
    for i, slot in enumerate(legacy.slots[:album_layers__PROJECT_ROSTER_COUNT]):
        pr.slots[i] = slot
    pr.project_path = path
    return (pr, data, imgs, layout)


def album_layers__patch_album_number(
    out: bytearray, profile: UniversalProfile, cave: hist_dc.Cave
) -> dict[str, int]:
    tens_hook, return_raw, draw_raw = album_layers__ALBUM_NUMBER_SITES[profile.version]
    placeholder_hook = tens_hook - 48
    placeholder_call = tens_hook - 4
    hundreds_words = album_layers__build_album_hundreds_setup(placeholder_call)
    hundreds_impl = cave.put(hundreds_words)
    core__write_far_goto(out, placeholder_hook, hundreds_impl)
    tens_words = album_layers__build_album_tens_ones(draw_raw, return_raw)
    tens_impl = cave.put(tens_words)
    core__write_far_goto(out, tens_hook, tens_impl)
    return {
        "album_hundreds_impl": hundreds_impl,
        "album_hundreds_words": len(hundreds_words),
        "album_tens_ones_impl": tens_impl,
        "album_tens_ones_words": len(tens_words),
        "digits": 3,
        "placeholder_hook": placeholder_hook,
        "placeholder_call": placeholder_call,
        "tens_hook": tens_hook,
        "return": return_raw,
        "draw_function": draw_raw,
        "layer_policy": "stock layers 11/12/13 created exactly once",
    }


def album_layers__patch_album_ram_safe(
    out: bytearray, source: bytes, target_count: int, cave: hist_dc.Cave
) -> dict[str, Any]:

    word_count = (target_count + 15) // 16
    meta = album_layers__read_meta(source) or {}
    old_a = int(meta.get("acquired_ram_base", 2127))
    old_v = int(meta.get("visible_ram_base", 2131))
    load_prefixes = {38667, 38154, 39180}
    acquired_values = {old_a, 2127, album_layers__ACQUIRED_RAM_BASE}
    visible_values = {old_v, 2131, album_layers__VISIBLE_RAM_BASE}
    repl_a = repl_v = repaired_add15 = 0
    for off in range(2, 139264, 2):
        prev = core__read_u16(out, off - 2)
        cur = core__read_u16(out, off)
        nxt = core__read_u16(out, off + 2) if off + 2 < len(out) else 0
        if prev == 47169 and nxt == 1800 and (cur in acquired_values):
            if cur != 2127:
                core__write_u16(out, off, 2127)
                repaired_add15 += 1
            continue
        if prev not in load_prefixes:
            continue
        if cur in acquired_values:
            core__write_u16(out, off, album_layers__ACQUIRED_RAM_BASE)
            repl_a += 1
        elif cur in visible_values:
            core__write_u16(out, off, album_layers__VISIBLE_RAM_BASE)
            repl_v += 1
    if repl_a < 9 or repl_v < 3:
        raise ValueError(
            f"앨범 RAM 주소 참조 수가 예상보다 적습니다: acquired={repl_a}, visible={repl_v}"
        )
    if meta.get("acquired_clear_start") is not None:
        acs = int(meta["acquired_clear_start"])
        ac_resume = int(meta["acquired_clear_resume"])
        vcs = int(meta["visible_clear_start"])
        vc_resume = int(meta["visible_clear_resume"])
    else:
        acs, ac_resume = relocation__find_clear(source, 2127)
        vcs, vc_resume = relocation__find_clear(source, 2131)
    ac_tr = cave.put(
        relocation__clear_words_code(album_layers__ACQUIRED_RAM_BASE, word_count, ac_resume)
    )
    core__write_far_goto(out, acs, ac_tr)
    vc_tr = cave.put(
        relocation__clear_words_code(album_layers__VISIBLE_RAM_BASE, word_count, vc_resume)
    )
    core__write_far_goto(out, vcs, vc_tr)
    return {
        "word_count": word_count,
        "acquired_clear_start": acs,
        "acquired_clear_resume": ac_resume,
        "visible_clear_start": vcs,
        "visible_clear_resume": vc_resume,
        "refs_acquired": repl_a,
        "refs_visible": repl_v,
        "false_add15_operands_repaired": repaired_add15,
        "relocation_policy": "verified-immediate-load-operands-only",
    }


def album_layers__project_to_dict(project: core.Project, profile_version: int) -> dict[str, Any]:
    return {
        "format": album_layers__PROJECT_FORMAT,
        "app_version": album_layers__APP_VERSION,
        "profile_version": profile_version,
        "base_rom": project.rom_files.get("vanilla", ""),
        "slots": [
            {
                "id": s.digimon_id,
                "name": s.name,
                "stats": s.stats,
                "frames": [asdict(f) for f in s.frames],
                "evolution": {
                    "enabled": s.evolution.enabled,
                    "source_id": s.evolution.source_id,
                    "conditions": [asdict(c) for c in s.evolution.conditions],
                },
            }
            for s in project.slots
        ],
    }


def album_layers__read_images_flexible(
    data: bytes, count: int, size_table: int
) -> list[core__RomImage]:
    return relocation__read_images_flexible(data, count, size_table)


def album_layers__save_project(project: core.Project, profile_version: int, path: Path) -> None:
    obj = album_layers__project_to_dict(project, profile_version)
    base = Path(obj["base_rom"])
    if base.is_absolute():
        try:
            obj["base_rom"] = os.path.relpath(base, path.parent).replace("\\", "/")
        except ValueError:
            pass
    path.write_text(json.dumps(obj, ensure_ascii=False, indent=2), encoding="utf-8")
    project.project_path = path


def album_layers__write_images_safe(
    data: bytearray, images: list[core.RomImage], extended: bool
) -> dict[str, Any]:

    count = len(images)
    regions: list[list[Any]] = [
        ["bank1", album_layers__FLASH_BANK1 + count * 4, album_layers__SAVE_TAIL_START]
    ]
    if extended:
        regions.append(["uppe\x7216", album_layers__SAVE_TAIL_END, len(data)])
    data[album_layers__FLASH_BANK1:album_layers__SAVE_TAIL_START] = b"\x00" * (
        album_layers__SAVE_TAIL_START - album_layers__FLASH_BANK1
    )
    if extended:
        data[album_layers__SAVE_TAIL_END:] = b"\xff" * (len(data) - album_layers__SAVE_TAIL_END)
    ri = 0
    cur = regions[0][1]
    used = {r[0]: 0 for r in regions}
    first: dict[str, int] = {}
    seen: dict[tuple[int, int, bytes], int] = {}
    duplicate_images = 0
    duplicate_bytes_saved = 0
    unique_images = 0
    for i, img in enumerate(images):
        size = len(img.pixels)
        key = (img.width, img.height, img.pixels)
        addr = seen.get(key)
        if addr is not None:
            duplicate_images += 1
            duplicate_bytes_saved += size
            core__write_u32(
                data, album_layers__FLASH_BANK1 + i * 4, addr - album_layers__FLASH_BANK1
            )
            continue
        if cur + size > regions[ri][2]:
            ri += 1
            if ri >= len(regions):
                available = sum((int(r[2]) - int(r[1]) for r in regions))
                used_total = sum(used.values())
                raise ValueError(
                    f"고유 이미지 공간 초과: image {i}, 사용 {used_total:,} / {available:,} bytes. 동일 프레임은 자동 공유되지만 현재 프로젝트의 서로 다른 픽셀이 칩 용량을 넘었습니다."
                )
            cur = regions[ri][1]
        addr = cur
        end = addr + size
        rel = addr - album_layers__FLASH_BANK1
        if rel < 0:
            raise AssertionError("\x5611은 음수 이미지 포인터를 만들지 않습니다")
        core__write_u32(data, album_layers__FLASH_BANK1 + i * 4, rel)
        data[addr:end] = img.pixels
        seen[key] = addr
        unique_images += 1
        used[regions[ri][0]] += size
        first.setdefault(regions[ri][0], addr)
        cur = end
    return {
        "last_end": cur,
        "region_used": used,
        "region_first": first,
        "wrapped_bank0_pointers": False,
        "unique_images": unique_images,
        "duplicate_images": duplicate_images,
        "duplicate_bytes_saved": duplicate_bytes_saved,
    }


def album_layers__write_meta(
    out: bytearray,
    profile: UniversalProfile,
    count: int,
    tl: dict[str, int],
    mode: str,
    extra: dict[str, Any],
) -> None:
    payload = {
        "format": album_layers__PROJECT_FORMAT,
        "app_version": album_layers__APP_VERSION,
        "profile_version": profile.version,
        "roster_count": count,
        "image_count": tl["image_count"],