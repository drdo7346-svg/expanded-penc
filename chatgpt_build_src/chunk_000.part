def runtime__show_error(title, message, parent=None, *, gui=True):
    """Show an error even when the desktop runtime cannot start."""
    temporary_root = None
    if gui:
        try:
            import tkinter as tk
            from tkinter import messagebox

            if parent is None:
                temporary_root = tk.Tk()
                temporary_root.withdraw()
                parent = temporary_root
            # This message already has an explicit Korean/English branch.
            # Bypass legacy global translators so details and paths stay intact.
            original = globals().get("engine___DIALOG_ORIGINALS", {}).get(
                (messagebox.__name__, "showerror"), messagebox.showerror
            )
            original(title, message, parent=parent)
            return
        except Exception:
            # Missing Tcl/Tk, no display, or an already destroyed window.
            pass
        finally:
            if temporary_root is not None:
                try:
                    temporary_root.destroy()
                except Exception:
                    pass
        if sys.platform == "win32":
            try:
                import ctypes

                ctypes.windll.user32.MessageBoxW(None, str(message), str(title), 0x10)
                return
            except Exception:
                pass
    stream = sys.stderr or sys.__stderr__ or sys.stdout or sys.__stdout__
    if stream is not None:
        try:
            print(f"{title}: {message}", file=stream)
        except Exception:
            # Some Windows console encodings cannot represent the Korean text.
            try:
                encoded = f"{title}: {message}\n".encode(
                    getattr(stream, "encoding", None) or "utf-8", errors="backslashreplace"
                )
                stream.buffer.write(encoded)
                stream.buffer.flush()
            except Exception:
                pass


runtime__PIL_IMPORT_ERROR = None
try:
    from PIL import Image, UnidentifiedImageError
except (ImportError, OSError) as exc:
    # Static CLI checks do not decode images. Delay the GUI requirement until
    # main() so --help/--layout/--validate-release remain available.
    Image = None
    UnidentifiedImageError = None
    runtime__PIL_IMPORT_ERROR = exc
