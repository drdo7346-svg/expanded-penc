@dataclass
class core__LoadedSourceRom:
    path: Path
    profile: core__RomProfileInfo
    data: bytes
    images: list[core__RomImage]


@dataclass
class core__FrameRef:

    kind: str
    value: int | str

    @classmethod
    def from_dict(cls, obj: dict[str, Any]) -> "FrameRef":
        kind = str(obj.get("kind", ""))
        value = obj.get("value")
        if kind == "base":
            value = int(value)
        elif kind in ("file", "embedded"):
            value = str(value)
        else:
            raise ValueError(f"알 수 없는 frame kind: {kind!r}")
        return cls(kind, value)


@dataclass
class core__EvolutionCondition:
    kind: int = 0
    operator: int = 5
    value: int = 0

    def validate(self) -> None:
        if self.kind not in core__SUPPORTED_CONDITION_KINDS:
            raise ValueError(f"PenC1에서 지원하지 않는 진화 조건 종류: {self.kind}")
        if self.operator not in core__OPERATOR_SYMBOL:
            raise ValueError(f"지원하지 않는 비교 연산자: {self.operator}")
        max_value = 1 if self.kind in (11, 12) else 63
        if not 0 <= self.value <= max_value:
            raise ValueError(
                f"{core__CONDITION_NAMES_KO[self.kind]} 값은 0~{max_value} 범위여야 합니다: {self.value}"
            )

    @classmethod
    def from_dict(cls, obj: dict[str, Any]) -> "EvolutionCondition":
        result = cls(int(obj.get("kind", 0)), int(obj.get("operator", 5)), int(obj.get("value", 0)))
        result.validate()
        return result


@dataclass
class core__EvolutionRoute:
    enabled: bool = False
    source_id: int = 0
    conditions: list[core__EvolutionCondition] = field(default_factory=list)

    @classmethod
    def from_dict(cls, obj: dict[str, Any]) -> "EvolutionRoute":
        route = cls(
            bool(obj.get("enabled", False)),
            int(obj.get("source_id", 0)),
            [core__EvolutionCondition.from_dict(x) for x in obj.get("conditions", [])],
        )
        return route


@dataclass
class core__DigimonSlot:
    digimon_id: int
    name: str
    stats: list[int]
    frames: list[core__FrameRef]
    evolution: core__EvolutionRoute = field(default_factory=core__EvolutionRoute)

    @classmethod
    def from_dict(cls, obj: dict[str, Any]) -> "DigimonSlot":
        slot = cls(
            digimon_id=int(obj["id"]),
            name=str(obj.get("name", "")),
            stats=[int(x) for x in obj.get("stats", [])],
            frames=[core__FrameRef.from_dict(x) for x in obj.get("frames", [])],
            evolution=core__EvolutionRoute.from_dict(obj.get("evolution", {})),
        )
        return slot


@dataclass
class core__Project:
    slots: list[core__DigimonSlot]
    rom_files: dict[str, str] = field(default_factory=dict)
    project_path: Optional[Path] = None

    def to_dict(self, path_for_files: Optional[Path] = None) -> dict[str, Any]:
        return {
            "format": core__PROJECT_FORMAT,
            "app_version": core__APP_VERSION,
            "rom_files": {"vanilla": self.rom_files.get("vanilla", "PenC1.bin")},
            "slots": [
                {
                    "id": slot.digimon_id,
                    "name": slot.name,
                    "stats": slot.stats,
                    "frames": [asdict(x) for x in slot.frames],
                    "evolution": {
                        "enabled": slot.evolution.enabled,
                        "source_id": slot.evolution.source_id,
                        "conditions": [asdict(x) for x in slot.evolution.conditions],
                    },
                }
                for slot in self.slots
            ],
        }


def core__sha256(data: bytes | bytearray) -> str:
    return hashlib.sha256(data).hexdigest()


def core__far_goto_words(byte_address: int) -> tuple[int, int]:
    if byte_address & 1:
        raise ValueError(f"far goto 대상 주소는 짝수여야 합니다: {byte_address:#x}")
    word_address = byte_address // 2
    return (65184 | word_address >> 16 & 1, word_address & 65535)


def core__read_stat_words(data: bytes, slot_id: int, table: int) -> list[int]:
    return list(struct.unpack_from("<18H", data, table + slot_id * core__STAT_RECORD_SIZE))


def core__read_u16(data: bytes | bytearray, off: int) -> int:
    return struct.unpack_from("<H", data, off)[0]


def core__read_u32(data: bytes | bytearray, off: int) -> int:
    return struct.unpack_from("<I", data, off)[0]


def core__validate_display_name(name: str) -> str:
    name = name.strip()
    if not name:
        raise ValueError("편집기 표시명이 비어 있습니다")
    if len(name) > core__MAX_DISPLAY_NAME_LENGTH:
        raise ValueError(f"편집기 표시명은 최대 {core__MAX_DISPLAY_NAME_LENGTH}자입니다: {name!r}")
    return name


def core__write_far_goto(data: bytearray, off: int, target: int) -> None:
    a, b = core__far_goto_words(target)
    core__write_u16(data, off, a)
    core__write_u16(data, off + 2, b)


def core__write_immediate6(data: bytearray, off: int, value: int) -> None:
    if not 0 <= value <= 63:
        raise ValueError(f"6비트 즉시값 범위 초과: {value}")
    old = core__read_u16(data, off)
    core__write_u16(data, off, old & 65472 | value)


def core__write_u16(data: bytearray, off: int, value: int) -> None:
    struct.pack_into("<H", data, off, value & 65535)


def core__write_u32(data: bytearray, off: int, value: int) -> None:
    struct.pack_into("<I", data, off, value & 4294967295)


def core__write_stat_words(
    data: bytearray, slot_id: int, words: list[int], table: int = core__FINAL_STAT_TABLE
) -> None:
    if len(words) != core__STAT_WORD_COUNT:
        raise ValueError(f"스탯은 {core__STAT_WORD_COUNT}개 word여야 합니다")
    for value in words:
        if not 0 <= int(value) <= 65535:
            raise ValueError(f"스탯 값 범위 초과: {value}")
    struct.pack_into(
        "<18H", data, table + slot_id * core__STAT_RECORD_SIZE, *[int(x) for x in words]
    )


def core__detect_image_count(data: bytes) -> int:
    first_pointer = core__read_u32(data, core__BANK1)
    if first_pointer % 4:
        raise ValueError("이미지 포인터표 첫 값이 4의 배수가 아닙니다")
    return first_pointer // 4


def core___profile_structure_matches(
    data: bytes, profile: RomProfileInfo, sample_count: int = 32
) -> bool:

    try:
        if len(data) != core__ROM_SIZE or core__detect_image_count(data) != profile.image_count:
            return False
        count = min(sample_count, profile.image_count - 1)
        minimum_start = core__BANK1 + profile.image_count * 4
        previous_end = minimum_start
        for i in range(count):
            rel = core__read_u32(data, core__BANK1 + i * 4)
            next_rel = core__read_u32(data, core__BANK1 + (i + 1) * 4)
            width = core__read_u16(data, profile.size_table + i * 4)
            height = core__read_u16(data, profile.size_table + i * 4 + 2)
            if not (1 <= width <= 256 and 1 <= height <= 256):
                return False
            if width * height * 2 != next_rel - rel:
                return False
            start = core__BANK1 + rel
            end = start + width * height * 2
            if start < previous_end or end > core__SAVE_TAIL:
                return False
            previous_end = end
        starts = [
            # Native table location; the GUI's current table may be relocated.
            core__read_stat_words(data, i, 0x02013E)[0]
            for i in range(profile.roster_count)
        ]
        if starts != list(range(240, 240 + profile.roster_count * 12, 12)):
            return False
        return True
    except (IndexError, struct.error, ValueError):
        return False


def core__build_evolution_code(slots: list[DigimonSlot]) -> tuple[bytes, dict[str, Any]]:
    words: list[int] = []
    route_reports: list[dict[str, Any]] = []
    for slot in slots:
        route = slot.evolution
        if not route.enabled:
            continue
        route_start = len(words)
        branch_placeholders: list[tuple[int, int]] = []
        words.append(38912)
        words.append(18496 + route.source_id)
        branch_placeholders.append((len(words), 78))
        words.append(0)
        real_conditions = [c for c in route.conditions if c.kind != 0]
        for condition in real_conditions:
            condition.validate()
            words.extend(
                [
                    65024,
                    39180,
                    core__CONDITION_STAT_ADDRESS[condition.kind],
                    39140,
                    18496 + condition.value,
                ]
            )
            branch_placeholders.append(
                (len(words), core__OPERATOR_INVERSE_BRANCH_HIGH[condition.operator])
            )
            words.append(0)
        words.extend([38976 + slot.digimon_id, 55296])
        words.extend(core__far_goto_words(core__EVO_RESULT_RETURN))
        route_end = len(words)
        for placeholder_index, high_byte in branch_placeholders:
            distance = route_end - (placeholder_index + 1)
            if not 0 <= distance <= 255:
                raise ValueError(
                    f"ID {slot.digimon_id:02d} 진화 경로 분기가 너무 깁니다: {distance} words"
                )
            words[placeholder_index] = high_byte << 8 | distance
        route_reports.append(
            {
                "result_id": slot.digimon_id,
                "source_id": route.source_id,
                "conditions": len(real_conditions),
                "word_start": route_start,
                "word_end": route_end,
            }
        )
    words.extend([65024, 39180, 2086])
    words.extend(core__far_goto_words(core__EVO_HOOK_RETURN))
    code = struct.pack("<" + "H" * len(words), *words)
    capacity = core__EVO_CAVE_END - core__EVO_CAVE
    if len(code) > capacity:
        raise ValueError(
            f"진화 코드 공간 초과: {len(code)} / {capacity} bytes. 조건 수를 줄이거나 일부 사용자 진화 경로를 비활성화하십시오."
        )
    return (
        code,
        {
            "enabled_routes": len(route_reports),
            "routes": route_reports,
            "bytes_used": len(code),
            "bytes_capacity": capacity,
            "bytes_free": capacity - len(code),
        },
    )


def rominput__generated_profile(data: bytes):
    """Recognize editor output independently of its exported hardware target.

    A profile number alone is insufficient: require the expanded table layout
    and both copies of the compact renderer. These signatures survive Wave 3
    and Godzilla export, unlike the native RAM instruction fingerprints.
    """
    if len(data) != 0x800000:
        return None
    try:
        meta = engine__read_meta(data) or {}
        version = int(meta.get("profile_version", -1))
        if version not in range(6):
            return None
        profile = engine__PROFILES[version]
        count = int(meta.get("roster_count", -1))
        if not int(profile.stock_roster_count) <= count <= 516:
            return None
        table = album_layers__table_layout(profile, count)
        if (
            int(meta.get("stat_table", -1)) != int(table["stat"])
            or int(meta.get("size_table", -1)) != int(table["size"])
            or int(meta.get("image_count", -1)) != compact8__image_count(profile, count)
            or core__detect_image_count(data) != int(meta["image_count"])
            or not spriteio__has_compact_renderer(data, meta)
        ):
            return None
        return core__ROM_PROFILE_BY_VERSION[version]
    except (KeyError, TypeError, ValueError, IndexError, struct.error):
        return None


def rominput__detect_profile(data: bytes) -> core__RomProfileInfo:
    """Allow editor output and native Wave 1/2, independently of save data.

    The existing hardware-conversion contract covers 178 instruction contexts
    per version. Both the embedded native code and supported expanded builds
    retain these bytes; Wave 3 and Godzilla relocate their RAM operands.
    All sampled bytes are below 0x06060E, outside the acquisition bitmap and
    the entire 0x7FD000..0x800000 save/checksum tail. Metadata is not proof of
    hardware identity: exported hardware variants retain the base profile.
    Verified editor output is accepted before applying this native-only gate.
    """
    if len(data) != 0x800000:
        raise ValueError(
            f"ROM 파일은 정확히 8 MiB(8,388,608바이트)여야 합니다. 현재 크기: {len(data):,}바이트.\n"
            "순정 PenC0·1·2·3·4·5와 정상적인 에디터 생성 ROM을 지원합니다."
        )
    generated = rominput__generated_profile(data)
    if generated is not None:
        return generated
    matches = []
    for version in range(6):
        refs = penc67__OPERANDS[version]
        context = b"".join(data[pos - 4 : pos + 10] for pos, _ in refs)
        if hashlib.sha256(context).hexdigest() == penc67__CONTEXT_SHA256[version]:
            matches.append(core__ROM_PROFILE_BY_VERSION[version])
    if len(matches) != 1:
        try:
            meta = engine__read_meta(data)
        except (KeyError, TypeError, ValueError, IndexError, struct.error):
            meta = None
        if meta:
            raise ValueError(
                "에디터 생성 정보는 있지만 ROM의 데이터 표·이미지 개수·렌더러 구성이 일치하지 않습니다.\n"
                "파일이 손상되었거나 현재 읽을 수 없는 생성 형식일 수 있습니다. "
                "정상 저장본 또는 해당 ROM을 만든 프로젝트를 사용해 주세요.\n"
                "기기 종류·파일명·세이브 상태 때문에 차단한 것은 아닙니다."
            )
        raise ValueError(
            "지원되는 PenC0·1·2·3·4·5의 실행 코드를 확인하지 못했습니다.\n"
            "순정 PenC6·7(Wave 3) 및 Godzilla ROM은 열 수 없습니다.\n"
            "에디터 생성 정보와 데이터 구조가 정상인 모딩 ROM은 기기 종류와 관계없이 열 수 있습니다.\n"
            "파일명과 세이브 데이터는 판별 기준에 포함하지 않습니다."
        )
    return matches[0]


def rominput__check_profile_version(version, profile) -> None:
    if int(version) != int(profile.version):
        raise ValueError(
            "ROM 내부 실행 코드와 저장된 버전 정보가 일치하지 않습니다.\n"
            "해당 ROM의 원래 프로젝트와 PenC0·1·2·3·4·5 기반 ROM을 사용해 주세요."
        )


def rominput__verify_generated_output(data):
    """Reopen the actual export through the editor before reporting success."""
    import tempfile

    if rominput__generated_profile(data) is None:
        raise ValueError("생성된 ROM의 모딩 데이터 구조를 확인하지 못했습니다.")
    with tempfile.TemporaryDirectory(prefix="penc_reopen_") as folder:
        path = Path(folder) / "output.bin"
        path.write_bytes(data)
        project, opened, images, layout = compact8__create_project_from_rom(path)
        restored = modrom__restore_project_from_rom(project, opened, images, layout)
        if not restored.get("modified_rom") or opened != data:
            raise ValueError("생성된 ROM을 에디터에서 다시 읽는 검사를 통과하지 못했습니다.")
        if int(restored.get("stats_restored", 0)) != int(layout.roster_count):
            raise ValueError("생성된 ROM의 디지몬 데이터를 모두 복원하지 못했습니다.")
        return {
            "valid": True,
            "reopened_from_file": True,
            "profile_version": int(layout.profile.version),
            "roster_count": int(layout.roster_count),
            "image_count": len(images),
            "input_save_validated": False,
        }


def core__detect_penc_profile(data: bytes) -> core__RomProfileInfo:
    profile = rominput__detect_profile(data)
    if core___profile_structure_matches(data, profile):
        return profile
    raise ValueError(f"PenC{profile.version}의 원본 이미지·스탯 구조를 확인하지 못했습니다.")


def core__load_project(path: Path) -> core__Project:
    obj = json.loads(path.read_text(encoding="utf-8"))
    project_format = obj.get("format")
    if (
        project_format != core__PROJECT_FORMAT
        and project_format not in core__LEGACY_PROJECT_FORMATS
    ):
        raise ValueError(f"지원하지 않는 프로젝트 형식: {project_format!r}")
    slots = [core__DigimonSlot.from_dict(x) for x in obj.get("slots", [])]
    for slot in slots:
        if (
            len(slot.stats) == core__STAT_WORD_COUNT
            and slot.digimon_id >= core__ORIGINAL_ROSTER_COUNT
        ):
            slot.stats[core__ALBUM_ORDER_STAT_INDEX] = slot.digimon_id
    slots.sort(key=lambda x: x.digimon_id)
    project = core__Project(
        slots=slots, rom_files=dict(obj.get("rom_files", {})), project_path=path.resolve()
    )
    for slot in project.slots:
        for frame in slot.frames:
            if frame.kind == "file":
                p = Path(str(frame.value))
                if not p.is_absolute():
                    frame.value = str((path.parent / p).resolve())
    core__validate_project(project)
    return project


def core__patch_album_cursor(output: bytearray) -> None:
    output[core__ALBUM_CAVE : core__ALBUM_CAVE + 64] = b"\x00" * 64
    words = [2113, 18496 + core__ROSTER_COUNT, 19969, 38976, 0, 0]
    words[4], words[5] = core__far_goto_words(core__ALBUM_RETURN)
    struct.pack_into("<6H", output, core__ALBUM_CAVE, *words)
    core__write_far_goto(output, core__ALBUM_HOOK, core__ALBUM_CAVE)


def core__patch_evolution(output: bytearray, slots: list[DigimonSlot]) -> dict[str, Any]:
    code, report = core__build_evolution_code(slots)
    output[core__EVO_CAVE:core__EVO_CAVE_END] = b"\x00" * (core__EVO_CAVE_END - core__EVO_CAVE)
    output[core__EVO_CAVE : core__EVO_CAVE + len(code)] = code
    core__write_far_goto(output, core__EVO_HOOK, core__EVO_CAVE)
    return report


def core__pil_to_rgb565(pil_image: Image.Image) -> core__RomImage:
    rgba = pil_image.convert("RGBA")
    if rgba.size != (48, 48):
        raise ValueError(f"스프라이트 PNG는 48x48이어야 합니다: {rgba.size[0]}x{rgba.size[1]}")
    out = bytearray(48 * 48 * 2)
    pos = 0
    raw_rgba = rgba.tobytes()
    for pixel_offset in range(0, len(raw_rgba), 4):
        r, g, b, a = raw_rgba[pixel_offset : pixel_offset + 4]
        if a == 0:
            word = 2016
        else:
            hist_o = (r * 31 + 127) // 255
            g6 = (g * 63 + 127) // 255
            b5 = (b * 31 + 127) // 255
            if hist_o == 0 and g6 == 63 and (b5 == 0):
                g6 = 62
            word = hist_o << 11 | g6 << 5 | b5
        struct.pack_into("<H", out, pos, word)
        pos += 2
    return core__RomImage(48, 48, bytes(out))


def core__read_images(data: bytes, count: int, size_table: int) -> list[core__RomImage]:
    declared = core__detect_image_count(data)
    if declared != count:
        raise ValueError(f"이미지 수 불일치: 기대 {count}, ROM {declared}")
    images: list[core__RomImage] = []
    minimum_start = core__BANK1 + count * 4
    previous_end = minimum_start
    for i in range(count):
        rel = core__read_u32(data, core__BANK1 + i * 4)
        width = core__read_u16(data, size_table + i * 4)
        height = core__read_u16(data, size_table + i * 4 + 2)
        if not (1 <= width <= 256 and 1 <= height <= 256):
            raise ValueError(f"이미지 {i}: 잘못된 크기 {width}x{height}")
        start = core__BANK1 + rel
        end = start + width * height * 2
        if start < minimum_start or end > core__SAVE_TAIL:
            raise ValueError(f"이미지 {i}: 범위 오류 {start:#x}..{end:#x}")
        if start < previous_end:
            raise ValueError(f"이미지 {i}: 데이터가 순서대로 배치되지 않았습니다")
        images.append(core__RomImage(width, height, data[start:end]))
        previous_end = end
    return images


def core__read_original_jogress_rows(vanilla: bytes) -> list[list[int]]:

    pointer_table = core__read_u16(vanilla, core__JOGRESS_POINTER_LOAD_SITE) * 2
    rows: list[list[int]] = []
    for source_id in range(core__ORIGINAL_ROSTER_COUNT):
        pointer = core__read_u32(vanilla, pointer_table + source_id * 4)
        if pointer < 2097152:
            raise ValueError(f"원본 조그레스 포인터 오류: ID {source_id:02d} = {pointer:#x}")
        row_off = (pointer - 2097152) * 2
        if row_off < 0 or row_off + 8 > len(vanilla):
            raise ValueError(f"원본 조그레스 행 범위 오류: ID {source_id:02d}")
        rows.append([core__read_u16(vanilla, row_off + i * 2) for i in range(4)])
    return rows


def core__resolve_frame(ref: FrameRef, base_images: list[RomImage]) -> core__RomImage:
    if ref.kind == "base":
        idx = int(ref.value)
        if not 0 <= idx < len(base_images):
            raise ValueError(f"기반 ROM 이미지 번호 범위 오류: {idx} (0~{len(base_images)-1})")
        image = base_images[idx]
    elif ref.kind == "file":
        path = Path(str(ref.value))
        if not path.exists():
            raise FileNotFoundError(f"PNG 파일 없음: {path}")
        with Image.open(path) as pil:
            image = core__pil_to_rgb565(pil)
    elif ref.kind == "embedded":
        try:
            pixels = base64.b64decode(str(ref.value), validate=True)
        except Exception as exc:
            raise ValueError("내장 스프라이트 base64 데이터가 손상되었습니다") from exc
        expected = 48 * 48 * 2
        if len(pixels) != expected:
            raise ValueError(f"내장 스프라이트 크기 오류: {len(pixels)} bytes (기대 {expected})")
        image = core__RomImage(48, 48, pixels)
    else:
        raise ValueError(f"지원하지 않는 frame kind: {ref.kind}")
    if (image.width, image.height) != (48, 48):
        raise ValueError(f"스프라이트는 48x48이어야 합니다: {image.width}x{image.height}")
    return image


def core__resolve_rom_paths(project: Project, rom_dir: Optional[Path] = None) -> dict[str, Path]:
    search_dirs: list[Path] = []
    if rom_dir:
        search_dirs.append(rom_dir.resolve())
    if project.project_path:
        search_dirs.append(project.project_path.parent.resolve())
    search_dirs.extend([Path.cwd().resolve(), Path(__file__).resolve().parent])
    configured = project.rom_files.get("vanilla", "PenC1.bin")
    p = Path(configured)
    candidates: list[Path] = []
    if p.is_absolute():
        candidates.append(p)
    else:
        candidates.extend((d / p for d in search_dirs))
        candidates.extend((d / "PenC1.bin" for d in search_dirs))
    found = next((x for x in candidates if x.exists()), None)
    if found is None:
        raise FileNotFoundError("PenC1.bin을 찾을 수 없습니다")
    return {"vanilla": found.resolve()}


def core__rgb565_to_pil(image: RomImage) -> Image.Image:
    rgba = bytearray(image.width * image.height * 4)
    out_i = 0
    for (word,) in struct.iter_unpack("<H", image.pixels):
        if word == 2016:
            r = g = b = 0
            a = 0
        else:
            hist_o = word >> 11 & 31
            g6 = word >> 5 & 63
            b5 = word & 31
            r = (hist_o * 255 + 15) // 31
            g = (g6 * 255 + 31) // 63
            b = (b5 * 255 + 15) // 31
            a = 255
        rgba[out_i : out_i + 4] = bytes((r, g, b, a))
        out_i += 4
    return Image.frombytes("RGBA", (image.width, image.height), bytes(rgba))


def core__validate_project(project: Project) -> None:
    if len(project.slots) != core__ROSTER_COUNT:
        raise ValueError(f"프로젝트 슬롯은 정확히 {core__ROSTER_COUNT}개여야 합니다")
    seen: set[int] = set()
    for expected_id, slot in enumerate(project.slots):
        if slot.digimon_id != expected_id:
            raise ValueError(
                f"슬롯 ID는 000부터 순서대로 이어져야 합니다: 위치 {expected_id:03d}에 ID {slot.digimon_id:03d}"
            )
        if slot.digimon_id in seen:
            raise ValueError(f"중복 ID: {slot.digimon_id}")
        seen.add(slot.digimon_id)
        if not 0 <= slot.digimon_id <= core__MAX_ID:
            raise ValueError(f"ID 범위 오류: {slot.digimon_id}")
        core__validate_display_name(slot.name)
        if len(slot.stats) != core__STAT_WORD_COUNT:
            raise ValueError(
                f"ID {slot.digimon_id:02d}: 스탯 word 수가 {core__STAT_WORD_COUNT}개가 아닙니다"
            )
        for stat_index, stat_value in enumerate(slot.stats):
            if stat_index in (0, 13):
                continue
            minimum = core__STAT_MINIMUMS[stat_index]
            maximum = core__STAT_MAXIMUMS[stat_index]
            if not minimum <= int(stat_value) <= maximum:
                raise ValueError(
                    f"ID {slot.digimon_id:02d}: {core__STAT_LABELS[stat_index]} 값은 {minimum}~{maximum} 범위여야 합니다: {stat_value}"
                )
        if len(slot.frames) != core__FRAMES_PER_DIGIMON:
            raise ValueError(f"ID {slot.digimon_id:02d}: 스프라이트가 12장이 아닙니다")
        if slot.evolution.enabled:
            if not 0 <= slot.evolution.source_id <= core__MAX_ID:
                raise ValueError(f"ID {slot.digimon_id:02d}: 진화 전 ID 범위 오류")            always_count = sum((c.kind == 0 for c in slot.evolution.conditions))
            if always_count and len(slot.evolution.conditions) != 1:
                raise ValueError(
                    f"ID {slot.digimon_id:02d}: '항상'은 다른 조건과 함께 쓸 수 없습니다"
                )
            for condition in slot.evolution.conditions:
                condition.validate()
    if seen != set(range(core__ROSTER_COUNT)):
        missing = sorted(set(range(core__ROSTER_COUNT)) - seen)
        raise ValueError(f"누락된 ID: {missing}")


def core__parse_editor_integer(value: str) -> int:
    """Read decimal UI values, including leading zeroes, and explicit base prefixes."""
    text = str(value).strip()
    prefix = text.lstrip("+-").lower()
    return int(text, 0 if prefix.startswith(("0x", "0o", "0b")) else 10)


class core__EditorGUI:

    def __init__(self, root: Any, initial_project: Optional[Path] = None) -> None:
        import tkinter as tk
        from tkinter import ttk

        self.tk = tk
        self.ttk = ttk
        self.root = root
        self.root.title(f"PenC1 45마리 편집기 / PenC0–PenC5 ROM 인식 v{core__APP_VERSION}")
        self.root.geometry("1240x820")
        self.root.minsize(1060, 700)
        self.project: Optional[core__Project] = None
        self.rom_paths: dict[str, Path] = {}
        self.vanilla: Optional[bytes] = None
        self.base_images: list[core__RomImage] = []
        self.current_id = 0
        self.preview_cache: list[Any] = []
        self.stat_vars: list[Any] = []
        self.condition_selected_index: Optional[int] = None
        self.dirty = False
        self._loading_slot = False
        self._build_menu()
        self._build_layout()
        try:
            if initial_project:
                self.open_project(initial_project)
            else:
                self.new_project(auto=True)
        except Exception as exc:
            self.show_error("초기화 실패", exc)

    def _auto_rom_dir(self) -> Path:
        return Path(__file__).resolve().parent

    def _build_basic_tab(self) -> None:
        tk, ttk = (self.tk, self.ttk)
        top = ttk.LabelFrame(polish__tab_content(self, self.basic_tab), text="슬롯 정보")
        top.pack(fill=tk.X, padx=10, pady=10)
        ttk.Label(top, text="ID").grid(row=0, column=0, padx=6, pady=6, sticky="e")
        self.id_var = tk.StringVar()
        ttk.Entry(top, textvariable=self.id_var, width=8, state="readonly").grid(
            row=0, column=1, padx=6, pady=6, sticky="w"
        )
        ttk.Label(
            top,
            text=f"편집기 표시명 (게임에는 출력되지 않음, 최대 {core__MAX_DISPLAY_NAME_LENGTH}자)",
        ).grid(row=0, column=2, padx=6, pady=6, sticky="e")
        self.name_var = tk.StringVar()
        name_entry = ttk.Entry(top, textvariable=self.name_var, width=32)
        name_entry.grid(row=0, column=3, padx=6, pady=6, sticky="w")
        name_entry.bind("<FocusOut>", lambda _e: self.commit_current_slot())
        name_entry.bind("<Return>", lambda _e: self.commit_current_slot())
        clone_frame = ttk.Frame(top)
        clone_frame.grid(row=1, column=0, columnspan=4, sticky="w", padx=6, pady=6)
        ttk.Label(clone_frame, text="다른 슬롯의 표시명·스탯을 복사:").pack(side=tk.LEFT)
        self.clone_slot_var = tk.StringVar()
        self.clone_slot_combo = ttk.Combobox(
            clone_frame, textvariable=self.clone_slot_var, state="readonly", width=30
        )
        self.clone_slot_combo.pack(side=tk.LEFT, padx=6)
        ttk.Button(clone_frame, text="복사", command=self.clone_basic_from_slot).pack(side=tk.LEFT)
        stats_box = ttk.LabelFrame(
            polish__tab_content(self, self.basic_tab),
            text="스탯 레코드 (기존 에디터 VP1 정의, 16-bit word 18개)",
        )
        stats_box.pack(fill=tk.X, padx=10, pady=(0, 10))
        info = "00 스프라이트 시작 번호와 13 도감 순서는 ROM 생성 시 자동 계산됩니다. 표시명은 편집기 식별용이며 PenC 화면에는 출력되지 않습니다."
        ttk.Label(stats_box, text=info, wraplength=830).pack(anchor="w", padx=8, pady=6)
        grid = ttk.Frame(stats_box)
        grid.pack(anchor="nw", padx=8, pady=6)
        self.stat_vars = []
        self.stat_entries: list[Any] = []
        for i, label in enumerate(core__STAT_LABELS):
            row = i % 9
            col_group = i // 9
            base_col = col_group * 3
            range_text = (
                "자동" if i in (0, 13) else f"{core__STAT_MINIMUMS[i]}~{core__STAT_MAXIMUMS[i]}"
            )
            ttk.Label(grid, text=f"{i:02d} {label} [{range_text}]").grid(
                row=row, column=base_col, padx=(4, 6), pady=4, sticky="e"
            )
            var = tk.StringVar()
            self.stat_vars.append(var)
            entry = ttk.Entry(grid, textvariable=var, width=10)
            self.stat_entries.append(entry)
            entry.grid(row=row, column=base_col + 1, padx=(0, 18), pady=4, sticky="w")
            if i in (0, core__ALBUM_ORDER_STAT_INDEX):
                entry.configure(state="readonly")
            else:
                entry.bind("<FocusOut>", lambda _e: self.commit_current_slot())
                entry.bind("<Return>", lambda _e: self.commit_current_slot())

    def _build_evolution_tab(self) -> None:
        tk, ttk = (self.tk, self.ttk)
        top = ttk.LabelFrame(self.evolution_tab, text="사용자 진화 경로")
        top.pack(fill=tk.X, padx=10, pady=10)
        self.evo_enabled_var = tk.BooleanVar()
        ttk.Checkbutton(
            top,
            text="이 디지몬으로 진화하는 사용자 경로 사용",
            variable=self.evo_enabled_var,
            command=self.commit_current_slot,
        ).grid(row=0, column=0, columnspan=3, padx=6, pady=6, sticky="w")
        ttk.Label(top, text="진화 전 디지몬").grid(row=1, column=0, padx=6, pady=6, sticky="e")
        self.evo_source_var = tk.StringVar()
        self.evo_source_combo = ttk.Combobox(
            top, textvariable=self.evo_source_var, state="readonly", width=35
        )
        self.evo_source_combo.grid(row=1, column=1, padx=6, pady=6, sticky="w")
        self.evo_source_combo.bind("<<ComboboxSelected>>", lambda _e: self.commit_current_slot())
        self.evo_result_var = tk.StringVar()
        ttk.Label(top, textvariable=self.evo_result_var).grid(
            row=1, column=2, padx=12, pady=6, sticky="w"
        )
        cond_box = ttk.LabelFrame(self.evolution_tab, text="조건 (모든 행을 동시에 만족해야 진화)")
        cond_box.pack(fill=tk.BOTH, expand=True, padx=10, pady=(0, 10))
        self.condition_tree = ttk.Treeview(
            cond_box, columns=("num", "kind", "op", "value"), show="headings", height=14
        )
        for col, title, width in [
            ("num", "#", 45),
            ("kind", "조건", 240),
            ("op", "비교", 80),
            ("value", "값", 100),
        ]:
            self.condition_tree.heading(col, text=title)
            self.condition_tree.column(col, width=width, anchor="center" if col != "kind" else "w")
        self.condition_tree.pack(fill=tk.BOTH, expand=True, padx=8, pady=8)
        self.condition_tree.bind("<Double-1>", lambda _e: self.edit_condition())
        buttons = ttk.Frame(cond_box)
        buttons.pack(fill=tk.X, padx=8, pady=(0, 8))
        ttk.Button(buttons, text="조건 추가", command=self.add_condition).pack(side=tk.LEFT, padx=3)
        ttk.Button(buttons, text="조건 수정", command=self.edit_condition).pack(
            side=tk.LEFT, padx=3
        )
        ttk.Button(buttons, text="조건 삭제", command=self.delete_condition).pack(
            side=tk.LEFT, padx=3
        )
        ttk.Button(buttons, text="위로", command=lambda: self.move_condition(-1)).pack(
            side=tk.LEFT, padx=3
        )
        ttk.Button(buttons, text="아래로", command=lambda: self.move_condition(1)).pack(
            side=tk.LEFT, padx=3
        )
        ttk.Button(buttons, text="항상 진화", command=self.set_always_condition).pack(
            side=tk.LEFT, padx=12
        )
        ttk.Label(
            cond_box,
            text="비교는 왼쪽의 실제 게임 값 기준입니다. 예: 총 배틀 >= 10은 실제 총 배틀 수가 10 이상일 때 통과. 여러 조건은 모두 참이어야 합니다. 조건이 없거나 '항상'이면 진화 전 ID만 검사합니다.",
            wraplength=850,
        ).pack(anchor="w", padx=10, pady=(0, 8))

    def _build_layout(self) -> None:
        tk, ttk = (self.tk, self.ttk)
        outer = ttk.Panedwindow(self.root, orient=tk.HORIZONTAL)
        outer.pack(fill=tk.BOTH, expand=True, padx=8, pady=8)
        left = ttk.Frame(outer, width=280)
        right = ttk.Frame(outer)
        outer.add(left, weight=0)
        outer.add(right, weight=1)
        ttk.Label(left, text="로스터 ID 00–44", font=("TkDefaultFont", 11, "bold")).pack(
            anchor="w", pady=(0, 6)
        )
        self.roster_tree = ttk.Treeview(
            left, columns=("id", "name", "type"), show="headings", height=30
        )
        self.roster_tree.heading("id", text="ID")
        self.roster_tree.heading("name", text="편집기 표시명")
        self.roster_tree.heading("type", text="구분")
        self.roster_tree.column("id", width=45, anchor="center", stretch=False)
        self.roster_tree.column("name", width=145, anchor="w")
        self.roster_tree.column("type", width=55, anchor="center", stretch=False)
        scroll = ttk.Scrollbar(left, orient="vertical", command=self.roster_tree.yview)
        self.roster_tree.configure(yscrollcommand=scroll.set)
        self.roster_tree.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        scroll.pack(side=tk.RIGHT, fill=tk.Y)
        self.roster_tree.bind("<<TreeviewSelect>>", self.on_roster_select)
        self.notebook = ttk.Notebook(right)
        self.notebook.pack(fill=tk.BOTH, expand=True)
        self.basic_tab = ttk.Frame(self.notebook)
        self.sprite_tab = ttk.Frame(self.notebook)
        self.evolution_tab = ttk.Frame(self.notebook)
        self.notebook.add(self.basic_tab, text="기본/스탯")
        self.notebook.add(self.sprite_tab, text="스프라이트 00–11")
        self.notebook.add(self.evolution_tab, text="진화 조건")
        self._build_basic_tab()
        self._build_sprite_tab()
        self._build_evolution_tab()
        status_frame = ttk.Frame(self.root)
        status_frame.pack(side=tk.BOTTOM, fill=tk.X, padx=8, pady=(0, 8), before=outer)
        self.status_var = tk.StringVar(value="준비")
        ttk.Label(status_frame, textvariable=self.status_var).pack(side=tk.LEFT)
        self.capacity_var = tk.StringVar(value="")
        ttk.Label(status_frame, textvariable=self.capacity_var).pack(side=tk.RIGHT)


    def _build_sprite_tab(self) -> None:
        tk, ttk = (self.tk, self.ttk)
        toolbar = ttk.Frame(polish__tab_content(self, self.sprite_tab))
        toolbar.pack(fill=tk.X, padx=10, pady=10)
        ttk.Button(
            toolbar, text="폴더에서 00–11 일괄 가져오기", command=self.import_sprite_folder
        ).pack(side=tk.LEFT, padx=(0, 6))
        ttk.Button(toolbar, text="다른 슬롯 12장 복사", command=self.copy_sprite_from_slot).pack(
            side=tk.LEFT, padx=6
        )
        ttk.Button(toolbar, text="12장 내보내기", command=self.export_sprite_folder).pack(
            side=tk.LEFT, padx=6
        )
        ttk.Button(toolbar, text="이 슬롯 기본값 복원", command=self.reset_slot_frames).pack(
            side=tk.LEFT, padx=6
        )
        ttk.Label(
            polish__tab_content(self, self.sprite_tab),
            text="프레임은 항상 번호 00→11 순서로 표시·기록됩니다. 각 그림을 클릭하면 해당 번호만 교체합니다.",
        ).pack(anchor="w", padx=12, pady=(0, 6))
        grid = ttk.Frame(polish__tab_content(self, self.sprite_tab))
        grid.pack(fill=tk.BOTH, expand=True, padx=10, pady=6)
        self.sprite_buttons: list[Any] = []
        self.sprite_image_labels: list[Any] = []
        self.sprite_source_vars: list[Any] = []
        for i in range(core__FRAMES_PER_DIGIMON):
            row, col = divmod(i, 4)
            cell = ttk.LabelFrame(grid, text=f"프레임 {i:02d}")
            cell.grid(row=row, column=col, padx=8, pady=8, sticky="nsew")
            grid.columnconfigure(col, weight=1)
            grid.rowconfigure(row, weight=1)
            label = ttk.Label(cell, text="", anchor="center")
            label.pack(fill=tk.BOTH, expand=True, padx=8, pady=6)
            label.bind("<Button-1>", lambda _e, idx=i: self.replace_single_frame(idx))
            source_var = tk.StringVar()
            ttk.Label(cell, textvariable=source_var, justify="center").pack(pady=(0, 4))
            btn = ttk.Button(
                cell, text=f"{i:02d} 교체", command=lambda idx=i: self.replace_single_frame(idx)
            )
            btn.pack(pady=(0, 6))
            self.sprite_image_labels.append(label)
            self.sprite_source_vars.append(source_var)
            self.sprite_buttons.append(btn)

    def _find_auto_penc1_path(self) -> Optional[Path]:
        directories = [Path.cwd().resolve(), Path(__file__).resolve().parent]
        preferred_names = ("PenC1.bin", "PenC1(1).bin", "penc1.bin", "Penc1.bin")
        checked: set[Path] = set()
        for directory in directories:
            candidates = [directory / name for name in preferred_names]
            try:
                candidates.extend(sorted(directory.glob("*.bin")))
            except OSError:
                pass
            for candidate in candidates:
                try:
                    candidate = candidate.resolve()
                except OSError:
                    continue
                if candidate in checked or not candidate.is_file():
                    continue
                checked.add(candidate)
                try:
                    if core__detect_penc_profile(candidate.read_bytes()).version == 1:
                        return candidate
                except Exception:
                    continue
        return None

    def _resolve_pil(self, ref: FrameRef) -> Image.Image:
        image = core__resolve_frame(ref, self.base_images)
        return core__rgb565_to_pil(image)

    def clone_basic_from_slot(self) -> None:
        if self.project is None:
            return
        text = self.clone_slot_var.get()
        if not text:
            return
        source_id = int(text.split()[0])
        source = self.project.slots[source_id]
        target = self.project.slots[self.current_id]
        target.name = source.name
        target.stats = list(source.stats)
        if target.digimon_id >= core__ORIGINAL_ROSTER_COUNT:
            target.stats[core__ALBUM_ORDER_STAT_INDEX] = target.digimon_id
        self.dirty = True
        self.load_slot(self.current_id)
        self.refresh_roster()
        self.update_status(
            f"ID {source_id:02d}의 표시명·스탯을 ID {self.current_id:02d}에 복사했습니다"
        )

    def commit_current_slot(self) -> None:
        if self._loading_slot or self.project is None:
            return
        slot = self.project.slots[self.current_id]
        name = self.name_var.get().strip()
        name = core__validate_display_name(name)
        stats = list(slot.stats)
        for i, var in enumerate(self.stat_vars):
            if i in (0, core__ALBUM_ORDER_STAT_INDEX):
                continue
            text = var.get().strip()
            value = core__parse_editor_integer(text) if text else 0
            minimum = core__STAT_MINIMUMS[i]
            maximum = core__STAT_MAXIMUMS[i]
            if not minimum <= value <= maximum:
                raise ValueError(
                    f"{core__STAT_LABELS[i]} 값 범위는 {minimum}~{maximum}입니다: {value}"
                )
            stats[i] = value
        if slot.digimon_id >= core__ORIGINAL_ROSTER_COUNT:
            stats[core__ALBUM_ORDER_STAT_INDEX] = slot.digimon_id
        enabled = bool(self.evo_enabled_var.get())
        source_text = self.evo_source_var.get().strip()
        source_id = int(source_text.split()[0]) if source_text else slot.evolution.source_id
        changed = (
            name != slot.name or stats != slot.stats
            or enabled != slot.evolution.enabled or source_id != slot.evolution.source_id
        )
        # Validate every input before updating the selected slot.
        slot.name = name
        slot.stats = stats
        slot.evolution.enabled = enabled
        slot.evolution.source_id = source_id
        self.roster_tree.item(
            str(slot.digimon_id),
            values=(
                f"{slot.digimon_id:02d}",
                slot.name,
                "기존" if slot.digimon_id < core__ORIGINAL_ROSTER_COUNT else "추가",
            ),
        )
        self.evo_result_var.set(f"→ 결과: {slot.digimon_id:02d} {slot.name}")
        self.dirty = self.dirty or changed
        self.update_capacity()

    def load_reference_roms(self, rom_dir: Optional[Path] = None) -> None:
        if self.project is None:
            raise RuntimeError("프로젝트가 없습니다")
        paths = core__resolve_rom_paths(self.project, rom_dir or self._auto_rom_dir())
        vanilla = paths["vanilla"].read_bytes()
        profile = core__detect_penc_profile(vanilla)
        if profile.version != 1:
            raise ValueError(
                f"이 프로젝트의 기반 ROM은 PenC1이어야 합니다. 선택된 파일: {profile.label}"
            )
        self.rom_paths = paths
        self.vanilla = vanilla
        self.base_images = core__read_images(vanilla, profile.image_count, profile.size_table)

    def load_slot(self, slot_id: int) -> None:
        if self.project is None:
            return
        self._loading_slot = True
        try:
            self.current_id = slot_id
            slot = self.project.slots[slot_id]
            self.id_var.set(f"{slot_id:02d}")
            self.name_var.set(slot.name)
            for i, var in enumerate(self.stat_vars):
                value = slot.stats[i]
                if i == 0:
                    value = (
                        core__read_stat_words(self.vanilla, slot_id, core__ORIGINAL_STAT_TABLE)[0]
                        if slot_id < core__ORIGINAL_ROSTER_COUNT and self.vanilla
                        else core__VANILLA_IMAGE_COUNT
                        + (slot_id - core__ORIGINAL_ROSTER_COUNT) * core__FRAMES_PER_DIGIMON
                    )
                elif i == core__ALBUM_ORDER_STAT_INDEX:
                    value = (
                        core__read_stat_words(self.vanilla, slot_id, core__ORIGINAL_STAT_TABLE)[
                            core__ALBUM_ORDER_STAT_INDEX
                        ]
                        if slot_id < core__ORIGINAL_ROSTER_COUNT and self.vanilla
                        else slot_id
                    )
                var.set(str(value))
                if i == core__ALBUM_VISIBLE_STAT_INDEX:
                    self.stat_entries[i].configure(state="normal")
            choices = list(self.evo_source_combo["values"])
            source_index = min(max(slot.evolution.source_id, 0), core__MAX_ID)
            self.evo_source_var.set(choices[source_index] if choices else f"{source_index:02d}")
            self.evo_enabled_var.set(slot.evolution.enabled)
            self.evo_result_var.set(f"→ 결과: {slot_id:02d} {slot.name}")
            self.refresh_conditions()
            self.refresh_sprite_previews()
            self.clone_slot_var.set(choices[0] if choices else "")
        finally:
            self._loading_slot = False


    def on_roster_select(self, _event: Any = None) -> None:
        selection = self.roster_tree.selection()
        if not selection:
            return
        new_id = int(selection[0])
        if new_id == self.current_id and (not self._loading_slot):
            return
        try:
            self.commit_current_slot()
        except Exception as exc:
            self.show_error("현재 슬롯 저장 실패", exc)
            self.roster_tree.selection_set(str(self.current_id))
            return
        self.load_slot(new_id)


    def open_source_rom_browser(self, source: LoadedSourceRom) -> None:

        from tkinter import filedialog, messagebox
        from PIL import ImageTk

        tk, ttk = (self.tk, self.ttk)
        window = tk.Toplevel(self.root)
        window.title(f"{source.profile.label} 스프라이트 소스 - {source.path.name}")
        window.geometry("900x650")
        window.minsize(760, 560)
        window.transient(self.root)
        top = ttk.Frame(window)
        top.pack(fill=tk.X, padx=10, pady=10)
        ttk.Label(
            top,
            text=f"인식: {source.profile.label} | 로스터 {source.profile.roster_count}마리 | 이미지 {source.profile.image_count}장 | 크기표 0x{source.profile.size_table:06X}",
            font=("TkDefaultFont", 10, "bold"),
        ).pack(anchor="w")
        ttk.Label(
            top,
            text="왼쪽에서 원본 ID를 고른 뒤 12장 스프라이트를 현재 PenC1 슬롯으로 복사할 수 있습니다.",
        ).pack(anchor="w", pady=(4, 0))
        body = ttk.Panedwindow(window, orient=tk.HORIZONTAL)
        body.pack(fill=tk.BOTH, expand=True, padx=10, pady=(0, 10))
        left = ttk.Frame(body, width=180)
        right = ttk.Frame(body)
        body.add(left, weight=0)
        body.add(right, weight=1)
        tree = ttk.Treeview(left, columns=("id", "start"), show="headings", height=25)
        tree.heading("id", text="원본 ID")
        tree.heading("start", text="이미지 시작")
        tree.column("id", width=80, anchor="center")
        tree.column("start", width=85, anchor="center")
        scrollbar = ttk.Scrollbar(left, orient="vertical", command=tree.yview)
        tree.configure(yscrollcommand=scrollbar.set)
        tree.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        scrollbar.pack(side=tk.RIGHT, fill=tk.Y)
        starts: list[int] = []
        for source_id in range(source.profile.roster_count):
            start = core__read_stat_words(source.data, source_id, core__ORIGINAL_STAT_TABLE)[0]
            if start + core__FRAMES_PER_DIGIMON > len(source.images):
                raise ValueError(
                    f"{source.profile.label} ID {source_id:02d} 스프라이트 범위 오류: {start}"
                )
            starts.append(start)
            tree.insert("", "end", iid=str(source_id), values=(f"{source_id:02d}", start))
        preview_frame = ttk.Frame(right)
        preview_frame.pack(fill=tk.BOTH, expand=True)
        preview_labels: list[Any] = []
        preview_cache: list[Any] = []
        for frame_index in range(core__FRAMES_PER_DIGIMON):
            box = ttk.LabelFrame(preview_frame, text=f"{frame_index:02d}")
            box.grid(row=frame_index // 4, column=frame_index % 4, padx=5, pady=5, sticky="nsew")
            label = ttk.Label(box, text="-")
            label.pack(padx=5, pady=5)
            preview_labels.append(label)
        for col in range(4):
            preview_frame.columnconfigure(col, weight=1)
        for row in range(3):
            preview_frame.rowconfigure(row, weight=1)
        selected_id = {"value": 0}

        def source_frames(source_id: int) -> list[core__RomImage]:
            start = starts[source_id]
            frames = source.images[start : start + core__FRAMES_PER_DIGIMON]
            for frame_index, image in enumerate(frames):
                if (image.width, image.height) != (48, 48):
                    raise ValueError(
                        f"{source.profile.label} ID {source_id:02d} frame {frame_index:02d}는 48x48이 아닙니다: {image.width}x{image.height}"
                    )
            return frames

        def refresh_preview(_event: Any = None) -> None:
            selection = tree.selection()
            if not selection:
                return
            source_id = int(selection[0])
            selected_id["value"] = source_id
            frames = source_frames(source_id)
            preview_cache.clear()
            for frame_index, (label, image) in enumerate(zip(preview_labels, frames)):
                pil = core__rgb565_to_pil(image).resize((96, 96), Image.Resampling.NEAREST)
                photo = ImageTk.PhotoImage(pil)
                preview_cache.append(photo)
                label.configure(image=photo, text="")
            window.title(f"{source.profile.label} ID {source_id:02d} - {source.path.name}")

        def copy_to_current_slot() -> None:
            if self.project is None:
                messagebox.showwarning(
                    "PenC1 프로젝트 필요",
                    "먼저 PenC1 ROM을 열어 45마리 프로젝트를 만든 뒤 복사하십시오.",
                    parent=window,
                )
                return
            source_id = selected_id["value"]
            frames = source_frames(source_id)
            target = self.project.slots[self.current_id]
            target.frames = [
                core__FrameRef("embedded", base64.b64encode(image.pixels).decode("ascii"))
                for image in frames
            ]
            self.dirty = True
            self.refresh_sprite_previews()
            self.update_status(
                f"{source.profile.label} ID {source_id:02d} → PenC1 ID {self.current_id:02d} 스프라이트 복사"
            )
            messagebox.showinfo(
                "복사 완료",
                f"{source.profile.label} ID {source_id:02d}의 12장을 현재 PenC1 슬롯 ID {self.current_id:02d}에 복사했습니다.\n스프라이트는 프로젝트 JSON에 내장되므로 원본 소스 ROM이 없어도 다시 열 수 있습니다.",
                parent=window,
            )

        def export_pngs() -> None:
            source_id = selected_id["value"]
            directory = filedialog.askdirectory(
                title=f"{source.profile.label} ID {source_id:02d} PNG 저장 폴더", parent=window
            )
            if not directory:
                return
            out_dir = Path(directory)
            for frame_index, image in enumerate(source_frames(source_id)):
                core__rgb565_to_pil(image).save(out_dir / f"{frame_index:02d}.png")
            self.update_status(f"{source.profile.label} ID {source_id:02d} PNG 12장 내보내기 완료")

        tree.bind("<<TreeviewSelect>>", refresh_preview)
        buttons = ttk.Frame(window)
        buttons.pack(fill=tk.X, padx=10, pady=(0, 10))
        ttk.Button(buttons, text="현재 PenC1 슬롯에 12장 복사", command=copy_to_current_slot).pack(
            side=tk.LEFT, padx=(0, 6)
        )
        ttk.Button(buttons, text="선택 ID 12장 PNG 내보내기", command=export_pngs).pack(
            side=tk.LEFT, padx=6
        )
        ttk.Button(buttons, text="닫기", command=window.destroy).pack(side=tk.RIGHT)
        tree.selection_set("0")
        tree.focus("0")
        refresh_preview()
        self.update_status(f"소스 ROM 인식: {source.profile.label} / {source.path.name}")


    def refresh_sprite_previews(self) -> None:
        if self.project is None or not self.base_images:
            return
        from PIL import ImageTk

        slot = self.project.slots[self.current_id]
        self.preview_cache = []
        for i, ref in enumerate(slot.frames):
            try:
                pil = self._resolve_pil(ref)
                preview = pil.resize((96, 96), Image.Resampling.NEAREST)
                photo = ImageTk.PhotoImage(preview)
                self.preview_cache.append(photo)
                self.sprite_image_labels[i].configure(image=photo, text="")
                if ref.kind == "file":
                    source = Path(str(ref.value)).name
                elif ref.kind == "embedded":
                    source = "embedded"
                else:
                    source = f"{ref.kind}:{int(ref.value)}"
                self.sprite_source_vars[i].set(source)
            except Exception as exc:
                self.preview_cache.append(None)
                self.sprite_image_labels[i].configure(image="", text=f"오류\n{exc}")
                self.sprite_source_vars[i].set("읽기 실패")


    def replace_single_frame(self, frame_index: int) -> None:
        from tkinter import filedialog

        if self.project is None:
            return
        path = filedialog.askopenfilename(
            title=f"ID {self.current_id:02d} 프레임 {frame_index:02d} 교체",
            filetypes=[("PNG 이미지", "*.png"), ("모든 파일", "*.*")],
        )
        if not path:
            return
        try:
            with Image.open(path) as im:
                core__pil_to_rgb565(im)
            self.project.slots[self.current_id].frames[frame_index] = core__FrameRef(
                "file", str(Path(path).resolve())
            )
            self.dirty = True
            self.refresh_sprite_previews()
            self.update_status(f"ID {self.current_id:02d} 프레임 {frame_index:02d} 교체")
        except Exception as exc:
            self.show_error("스프라이트 교체 실패", exc)


    def select_slot(self, slot_id: int) -> None:
        iid = str(slot_id)
        if self.roster_tree.exists(iid):
            self.roster_tree.selection_set(iid)
            self.roster_tree.focus(iid)
            self.roster_tree.see(iid)
            self.load_slot(slot_id)

    @staticmethod
    def numbered_pngs(directory: Path) -> list[Path]:
        candidates: list[tuple[int, str, Path]] = []
        for p in directory.iterdir():
            if not p.is_file() or p.suffix.lower() != ".png":
                continue
            stem = p.stem
            match = re.search("(\\d+)$", stem)
            if match:
                number = int(match.group(1))
                candidates.append((number, p.name.lower(), p))
        candidates.sort(key=lambda x: (x[0], x[1]))
        by_number: dict[int, Path] = {}
        for number, _name, p in candidates:
            if 0 <= number < core__FRAMES_PER_DIGIMON and number not in by_number:
                by_number[number] = p
        missing = [i for i in range(core__FRAMES_PER_DIGIMON) if i not in by_number]
        if missing:
            raise ValueError(
                "폴더에 번호가 붙은 PNG 12장이 필요합니다. 누락: "
                + ", ".join((f"{x:02d}" for x in missing))
            )
        return [by_number[i] for i in range(core__FRAMES_PER_DIGIMON)]

    def import_sprite_folder(self) -> None:
        from tkinter import filedialog

        if self.project is None:
            return
        directory = filedialog.askdirectory(title="00~11 PNG가 있는 폴더 선택")
        if not directory:
            return
        try:
            files = self.numbered_pngs(Path(directory))
            for p in files:
                with Image.open(p) as im:
                    core__pil_to_rgb565(im)
            self.project.slots[self.current_id].frames = [
                core__FrameRef("file", str(p.resolve())) for p in files
            ]
            self.dirty = True
            self.refresh_sprite_previews()
            self.update_status(f"ID {self.current_id:02d}: 번호순 00–11 PNG를 가져왔습니다")
        except Exception as exc:
            self.show_error("폴더 가져오기 실패", exc)

    def add_condition(self) -> None:
        if self.project is None:
            return
        condition = self.condition_dialog()
        if condition is None:
            return
        conditions = self.project.slots[self.current_id].evolution.conditions
        if condition.kind == 0:
            conditions[:] = [condition]
        else:
            conditions[:] = [x for x in conditions if x.kind != 0]
            conditions.append(condition)
        self.dirty = True
        self.refresh_conditions()


    def condition_dialog(
        self, existing: Optional[EvolutionCondition] = None
    ) -> Optional[core__EvolutionCondition]:
        tk, ttk = (self.tk, self.ttk)
        from tkinter import messagebox

        dialog = tk.Toplevel(self.root)
        dialog.title("진화 조건")
        dialog.transient(self.root)
        dialog.grab_set()
        dialog.resizable(False, False)
        kind_items = [f"{k:02d} {v}" for k, v in core__CONDITION_NAMES_KO.items()]
        op_items = [f"{k} {v}" for k, v in core__OPERATOR_SYMBOL.items()]
        kind_default = existing.kind if existing else 0
        kind_var = tk.StringVar(
            value=next((x for x in kind_items if x.startswith(f"{kind_default:02d} ")))
        )
        op_default = existing.operator if existing else 5
        op_var = tk.StringVar(
            value=next((x for x in op_items if x.startswith(str(op_default) + " ")))
        )
        value_var = tk.StringVar(value=str(existing.value if existing else 0))
        result: list[Optional[core__EvolutionCondition]] = [None]
        ttk.Label(dialog, text="조건 종류").grid(row=0, column=0, padx=8, pady=8, sticky="e")
        kind_combo = ttk.Combobox(
            dialog, textvariable=kind_var, values=kind_items, state="readonly", width=28
        )
        kind_combo.grid(row=0, column=1, padx=8, pady=8)
        ttk.Label(dialog, text="비교").grid(row=1, column=0, padx=8, pady=8, sticky="e")
        op_combo = ttk.Combobox(
            dialog, textvariable=op_var, values=op_items, state="readonly", width=12
        )
        op_combo.grid(row=1, column=1, padx=8, pady=8, sticky="w")
        ttk.Label(dialog, text="값").grid(row=2, column=0, padx=8, pady=8, sticky="e")
        value_entry = ttk.Entry(dialog, textvariable=value_var, width=14)
        value_entry.grid(row=2, column=1, padx=8, pady=8, sticky="w")
        hint_var = tk.StringVar()
        ttk.Label(dialog, textvariable=hint_var).grid(row=3, column=0, columnspan=2, padx=8, pady=4)

        def update_state(*_args: Any) -> None:
            kind = int(kind_var.get().split()[0])
            if kind == 0:
                op_combo.configure(state="disabled")
                value_entry.configure(state="disabled")
                hint_var.set("항상 조건은 다른 조건과 함께 사용할 수 없습니다")
            else:
                op_combo.configure(state="readonly")
                value_entry.configure(state="normal")
                max_v = 1 if kind in (11, 12) else 63
                hint_var.set(
                    f"허용 값: 0~{max_v} | {core__OPERATOR_DESCRIPTION_KO[int(op_var.get().split()[0])]}"
                )

        kind_combo.bind("<<ComboboxSelected>>", update_state)
        op_combo.bind("<<ComboboxSelected>>", update_state)
        update_state()
        btns = ttk.Frame(dialog)
        btns.grid(row=4, column=0, columnspan=2, pady=10)

        def accept() -> None:
            try:
                kind = int(kind_var.get().split()[0])
                if kind == 0:
                    cond = core__EvolutionCondition(0, 5, 0)
                else:
                    operator = int(op_var.get().split()[0])
                    value = int(value_var.get(), 0)
                    cond = core__EvolutionCondition(kind, operator, value)
                cond.validate()
                result[0] = cond
                dialog.destroy()
            except Exception as exc:
                messagebox.showerror("조건 오류", str(exc), parent=dialog)

        ttk.Button(btns, text="확인", command=accept).pack(side=tk.LEFT, padx=5)
        ttk.Button(btns, text="취소", command=dialog.destroy).pack(side=tk.LEFT, padx=5)
        dialog.wait_window()
        return result[0]

    def confirm_discard(self) -> bool:
        from tkinter import messagebox

        return messagebox.askyesno(
            "변경 내용 폐기", "저장하지 않은 변경 내용을 버리시겠습니까?", parent=self.root
        )

    def copy_sprite_from_slot(self) -> None:
        from tkinter import simpledialog

        if self.project is None:
            return
        source_id = simpledialog.askinteger(
            "스프라이트 복사", "복사할 슬롯 ID", minvalue=0, maxvalue=core__MAX_ID, parent=self.root
        )
        if source_id is None:
            return
        self.project.slots[self.current_id].frames = copy.deepcopy(
            self.project.slots[source_id].frames
        )
        self.dirty = True
        self.refresh_sprite_previews()
        self.update_status(
            f"ID {source_id:02d}의 12개 프레임을 ID {self.current_id:02d}에 복사했습니다"
        )

    def delete_condition(self) -> None:
        if self.project is None:
            return
        selected = self.condition_tree.selection()
        if not selected:
            return
        index = int(selected[0])
        del self.project.slots[self.current_id].evolution.conditions[index]
        self.dirty = True
        self.refresh_conditions()

    def edit_condition(self) -> None:
        if self.project is None:
            return
        selected = self.condition_tree.selection()
        if not selected:
            return
        index = int(selected[0])
        conditions = self.project.slots[self.current_id].evolution.conditions
        replacement = self.condition_dialog(conditions[index])
        if replacement is None:
            return
        if replacement.kind == 0:
            conditions[:] = [replacement]
        else:
            conditions[index] = replacement
            conditions[:] = [x for x in conditions if x.kind != 0]
            if replacement not in conditions:
                conditions.append(replacement)
        self.dirty = True
        self.refresh_conditions()

    def export_sprite_folder(self) -> None:
        from tkinter import filedialog

        if self.project is None:
            return
        directory = filedialog.askdirectory(title="12개 PNG를 내보낼 폴더 선택")
        if not directory:
            return
        try:
            out = Path(directory)
            out.mkdir(parents=True, exist_ok=True)
            for i, ref in enumerate(self.project.slots[self.current_id].frames):
                self._resolve_pil(ref).save(out / f"{i:02d}.png")
            self.update_status(f"ID {self.current_id:02d} 스프라이트를 {out}에 내보냈습니다")
        except Exception as exc:
            self.show_error("스프라이트 내보내기 실패", exc)

    def move_condition(self, direction: int) -> None:
        if self.project is None:
            return
        selected = self.condition_tree.selection()
        if not selected:
            return
        index = int(selected[0])
        target = index + direction
        conditions = self.project.slots[self.current_id].evolution.conditions
        if not 0 <= target < len(conditions):
            return
        conditions[index], conditions[target] = (conditions[target], conditions[index])
        self.dirty = True
        self.refresh_conditions()
        self.condition_tree.selection_set(str(target))

    def refresh_conditions(self) -> None:
        if self.project is None:
            return
        for item in self.condition_tree.get_children():
            self.condition_tree.delete(item)
        conditions = self.project.slots[self.current_id].evolution.conditions
        for i, cond in enumerate(conditions):
            if cond.kind == 0:
                op, value = ("-", "-")
            else:
                op, value = (core__OPERATOR_SYMBOL[cond.operator], str(cond.value))
            self.condition_tree.insert(
                "",
                "end",
                iid=str(i),
                values=(i + 1, core__CONDITION_NAMES_KO[cond.kind], op, value),
            )
        self.update_capacity()


    def set_always_condition(self) -> None:
        if self.project is None:
            return
        self.project.slots[self.current_id].evolution.conditions = [
            core__EvolutionCondition(0, 5, 0)
        ]
        self.dirty = True
        self.refresh_conditions()

    def show_error(self, title: str, exc: Exception) -> None:
        from tkinter import messagebox

        messagebox.showerror(title, f"{exc}\n\n{traceback.format_exc(limit=3)}", parent=self.root)
        self.update_status(f"오류: {exc}")


